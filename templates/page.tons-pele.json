t_size":16,"x11rich_text_line_height":1.6,"x11button_text":"COMPRAR AGORA","x11button_link":"","x11button_bg_color":"#d0021b","x11button_text_color":"#ffffff","x11button_radius":50,"x11button_padding_y":18,"x11button_padding_x":90,"x11image_width_desktop":70,"x11mobile_breakpoint":768,"block_title":"","block_text":"","feature_text_1":"","feature_text_2":"","feature_text_3":"","feature_text_4":""}},"tons_clareador_faq_3fMMe6":{"type":"tons-clareador-faq","blocks":{"faq_item_R898dn":{"type":"faq_item","settings":{"question_text":"O que é Tons e para que ele serve?","answer_html":"<p>Tons é um suplemento oral desenvolvido pela Denavita, com ingredientes como Coenzima Q10 e Pinus Pinaster. Ele auxilia na redução de manchas, ajuda a uniformizar o tom da pele, contribui a suavizar linhas de expressão e vermelhidão (como rosácea) e promove a hidratação e elasticidade cutânea.<\/p>"}},"faq_item_aTmArH":{"type":"faq_item","settings":{"question_text":"Quanto tempo leva para notar os primeiros resultados?","answer_html":"<p>O uso contínuo de Tons proporciona resultados mais consistentes ao longo do tempo, com benefícios visíveis após algumas semanas de uso regular.<\/p>"}},"faq_item_WEFfx8":{"type":"faq_item","settings":{"question_text":"Tons pode ser usado por qualquer tipo de pele?","answer_html":"<p>Sim, Tons é indicado para todos os tipos de pele, especialmente para quem enfrenta manchas, rosácea, vermelhidão ou sinais de envelhecimento precoce.<\/p>"}},"faq_item_YnA6qn":{"type":"faq_item","settings":{"question_text":"Como devo incluir Tons na minha rotina de cuidados?","answer_html":"<p>Consuma uma cápsula de Tons por dia, preferencialmente após uma refeição. Ele complementa a rotina de cuidados com a pele ao atuar de dentro para fora.<\/p>"}},"faq_item_jkTyQa":{"type":"faq_item","settings":{"question_text":"Tons ajuda a reduzir manchas de melasma?","answer_html":"<p>Sim, Tons é eficaz no auxílio à redução de manchas profundas, como o melasma. Ele age de dentro para fora, atingindo camadas mais profundas da pele onde tratamentos tópicos geralmente não alcançam.<\/p>"}},"faq_item_dRrgCW":{"type":"faq_item","settings":{"question_text":"É seguro usar Tons diariamente?","answer_html":"<p>Sim, Tons foi desenvolvido para uso diário, sendo seguro quando consumido conforme a recomendação de uma cápsula por dia.<\/p>"}},"faq_item_KwXzPw":{"type":"faq_item","settings":{"question_text":"Posso usar Tons em conjunto com outros produtos de skincare?","answer_html":"<p>Sim, Tons pode ser combinado com outros produtos de skincare, pois age internamente, complementando os cuidados tópicos.<\/p>"}},"faq_item_zF39pc":{"type":"faq_item","settings":{"question_text":"Quais são os principais ativos de Tons e seus benefícios?","answer_html":"<p>Coenzima Q10: Poderoso antioxidante que promove a regeneração celular, combate os radicais livres e reduz os sinais de envelhecimento.\n\n\n\nPinus Pinaster: Rico em proantocianidinas, reduz a inflamação, minimiza a vermelhidão e estimula a produção de colágeno para maior firmeza e elasticidade.<\/p>"}},"faq_item_t6fFKR":{"type":"faq_item","settings":{"question_text":"Tons é indicado para quem tem rosácea?","answer_html":"<p>Sim, Tons é indicado para quem tem rosácea, pois ajuda a reduzir a vermelhidão e melhora a aparência geral da pele.<\/p>"}},"faq_item_jX7dAL":{"type":"faq_item","settings":{"question_text":"Há contraindicações para o uso de Tons?","answer_html":"<p>Para grávidas, lactantes ou pessoas com alergia aos seus componentes, como Pinus Pinaster, indicamos consultar o seu médico. Reforçamos, Indivíduos com condições médicas pré-existentes devem consultar um médico antes do uso.<\/p>"}}},"block_order":["faq_item_R898dn","faq_item_aTmArH","faq_item_WEFfx8","faq_item_YnA6qn","faq_item_jkTyQa","faq_item_dRrgCW","faq_item_KwXzPw","faq_item_zF39pc","faq_item_t6fFKR","faq_item_jX7dAL"],"name":"Tons Clareador FAQ","settings":{"selected_product":"tons","background_color":"rgba(0,0,0,0)","border_radius":20,"main_h