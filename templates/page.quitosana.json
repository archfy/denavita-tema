_border_thickness_info_nutri":1,"image_border_color_info_nutri":"#54b101","main_text_content_info_nutri":"<h6><em>60 cápsulas por frasco\/pote<\/em><\/h6><h2>Quitosana + Psyllium e Triptofano<\/h2><p>Sabor: Sem sabor. <\/p><p> <\/p><p><strong>Cada porção com 2 cápsulas contém:<\/strong><\/p><p>• 300mg de Quitosana.<\/p><p>• 250mg de Psyllium.<\/p><p>• 230mg de Goma Guar.<\/p><p>• 180mg de Ágar-ágar.<\/p><p>• 5mg de Ácido Pantotênico<\/p><p>• 250mg de Triptofano.<\/p><p><strong> <\/strong><\/p><p><strong>Dosagem Recomendada \/ Modo de Usar<\/strong> <\/p><p>• 2 cápsulas ao dia, junto das principais refeições.<\/p><p>• Ou seguindo as orientações do seu médico.<\/p><p>• Não contém açúcar. <\/p><p>• Não contém glúten. <\/p><p>• Não engorda.<\/p>","main_text_color_info_nutri":"#005c47","main_text_font_size_desktop_info_nutri":16,"main_text_font_size_mobile_info_nutri":16,"main_text_line_height_info_nutri":1.2,"main_text_margin_top_info_nutri":0,"main_text_margin_bottom_info_nutri":0,"show_button_info_nutri":false,"btn_text_info_nutri":"","btn_link_info_nutri":"#","btn_color_info_nutri":"#ffffff","btn_bg_color_info_nutri":"#28a745","btn_border_radius_info_nutri":5,"button_alignment_info_nutri":"center","button_margin_top_info_nutri":30,"button_margin_bottom_info_nutri":0}},"quitosana_secao_bonus_especial_EbdeHk":{"type":"quitosana-secao-bonus-especial","disabled":true,"settings":{"x11selected_product":"","x11background_color":"#e5eddd","x11cor_borda_color":"#4bb000","x11border_radius":20,"x11title_color":"#333333","x11title_size":36,"x11title_weight":"700","x11title_spacing":30,"x11subtitle_color":"#59000b","x11subtitle_size":22,"x11subtitle_weight":"500","x11benefits_title_color":"#59000b","x11benefits_title_size":24,"x11benefits_title_weight":"600","x11rich_text_color":"#4bb000","x11rich_text_size":16,"x11rich_text_line_height":1.6,"x11button_text":"COMPRAR AGORA","x11button_link":"","x11button_bg_color":"#d0021b","x11button_text_color":"#ffffff","x11button_radius":50,"x11button_padding_y":18,"x11button_padding_x":90,"x11image_width_desktop":70,"x11mobile_breakpoint":768,"block_title":"","block_text":"","feature_text_1":"","feature_text_2":"","feature_text_3":"","feature_text_4":""}},"quitosana_faq_RV7RNj":{"type":"quitosana-faq","blocks":{"faq_item_dYK9yq":{"type":"faq_item","settings":{"question_text":"COMO DEVO CONSUMIR ESSE SUPLEMENTO EM CÁPSULAS?","answer_html":"<p>Consumir 1 cápsula ao dia.<\/p>"}},"faq_item_VFKwiq":{"type":"faq_item","settings":{"question_text":"QUANDO DEVO CONSUMIR ESSE SUPLEMENTO?","answer_html":"<p>Não existe um horário específico. O importante é manter uma constância, ou seja, tomar sempre no mesmo horário todos os dias. Como contém cafeína devido ao café verde, o melhor é tomar antes das 18h para não afetar o sono.<\/p>"}},"faq_item_yTm4yN":{"type":"faq_item","settings":{"question_text":"POSSO TOMAR MAIS DE 1 CÁPSULA AO DIA?","answer_html":"<p>O ideal é seguir a orientação de consumo descrita na embalagem para aporte dos valores diários descritos na tabela nutricional. Para valores diferentes, consulte um médico ou nutricionista.<\/p>"}},"faq_item_PHkNBr":{"type":"faq_item","settings":{"question_text":"O PRODUTO QUEBRA O JEJUM?","answer_html":"<p>Não. Não possui aporte nutricional que interfere no jejum.<\/p>"}},"faq_item_m3eafp":{"type":"faq_item","settings":{"question_text":"QUAIS AS CONTRAINDICAÇÕES?","answer_html":"<p>Produto contraindicado para gestantes, lactantes e crianças.<\/p>"}},"faq_item_iKJMFz":{"type":"faq_item","settings":{"question_text":"EXISTE DIFERENÇA ENTRE A CÁPSULA E O COMPRIMIDO?","answer_html":"<p>São duas formas de apresentação diferentes para suplementos e deve ser avaliada as concentrações dos nutrientes presentes na lista nutricional. No comprimido, é possível a maior compressão dos ingredientes e princípios ativos, enquanto na cápsula gelatinosa há a facilidade de ingestão e mais rápida dissolução do trato gastrointestinal.<\/p>"}},"faq_item_W73Mm4":{"type":"faq_item","settings":{"question_text":"ESSE SUPLEMENTO É VEGANO?","answer_html":"<p>Não, pois possui em sua formulação a gelatina.<\/p>"}}},"block_order":["faq_item_dYK9yq","faq_item_VFKwiq","faq_item_yTm4yN","faq_item_PHkNBr","faq_item_m3eafp","faq_item_iKJMFz","faq_item_W73Mm4"],"settings":{"selected_product":"quitosana-pysillium-e-triptofano-3-em-1","background_color":"rgba(0,0,0,0)","border_radius":20,"main_heading_text":"Ainda com dúvidas?","main_title_color":"#4bb000","main_title_size":32,"main_title_weight":"400","sub_heading_text":"Veja aqui as principais dúvidas sobre a Quitosana.","subtitle_color":"#2a2a2a","subtitle_size":18,"subtitle_weight":"500","accordion_border_color":"#000000","accordion_border_width":1,"accordion_border_radius":12,"accordion_border_radius_mobile":8,"accordion_max_width":700,"question_text_color":"#005c47","question_text_size":16,"question_text_weight":"400","answer_text_color":"#333333","answer_text_size":16,"answer_text_weight":"400","icon_color":"#444444"}},"secao_advertencia_TqMBkC":{"type":"secao-advertencia","settings":{"x190selected_product":"","x190background_color":"#fa4200","x190cor_borda_color":"#4bb000","x190border_radius":20,"x190title_color":"#333333","x190title_size":36,"x190title_weight":"700","x190title_spacing":30,"x190subtitle_color":"#59000b","x190subtitle_size":22,"x190subtitle_weight":"500","x190benefits_title_color":"#59000b","x190benefits_title_size":24,"x190benefits_title_weight":"600","x190rich_text_color":"#4bb000","x190rich_text_size":16,"x190rich_text_line_height":1.6,"x190button_text":"COMPRAR AGORA","x190button_link":"","x190button_bg_color":"#d0021b","x190button_text_color":"#ffffff","x190button_radius":50,"x190button_padding_y":18,"x190button_padding_x":90,"x190image_width_desktop":70,"x190mobile_breakpoint":768,"block_title":"","block_text":"","feature_text_1":"","feature_text_2":"","feature_text_3":"","feature_text_4":""}}},"order":["main","quitosana_inicio_rHACHQ","jejoom_letreiro_mWXbYW","quitosana_intro_1_W6wB