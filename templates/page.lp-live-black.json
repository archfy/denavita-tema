tent_liquid":"<!-- 🔥 BARRA FIXA DE CONTAGEM REGRESSIVA -->\n<div class=\"barra-topo-fixa\" id=\"barraTopo\">\n  <div class=\"barra-topo-conteudo\">\n\n    <span class=\"barra-texto branco texto-faltam\">Faltam<\/span>\n\n    <span class=\"barra-timer\" id=\"timerRegressivo\">\n      Carregando...\n    <\/span>\n\n    <span class=\"barra-texto branco\">para a Live Black Premiada<\/span>\n\n    <a href=\"https:\/\/sndflw.com\/i\/sFmKflxiTBSQAu460idJ\" class=\"btn-entrar\" rel=\"noopener\">\n      Quero aproveitar ▶\n    <\/a>\n\n  <\/div>\n<\/div>\n\n<style>\n\/* --- BARRA FIXA --- *\/\n.barra-topo-fixa {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  background-color: black;\n  backdrop-filter: blur(10px);\n  padding: 12px 20px;\n  z-index: 99999;\n  box-sizing: border-box;\n}\n\n\/* --- CONTEÚDO INTERNO --- *\/\n.barra-topo-conteudo {\n  max-width: 1400px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  flex-wrap: wrap;\n  text-align: center;\n}\n\n\/* TEXTOS LATERAIS *\/\n.barra-texto.branco {\n  color: #ffffff;\n  font-size: 16px;\n  font-family: 'Poppins', sans-serif;\n  font-weight: 500;\n  white-space: nowrap;\n}\n\n\/* --- TIMER --- *\/\n.barra-timer {\n  font-size: 20px;\n  font-weight: 700;\n  font-family: 'Poppins', sans-serif;\n  color: #ff8800;\n  text-align: center;\n  white-space: nowrap;\n  letter-spacing: 1px;\n}\n\n\/* --- BOTÃO CTA --- *\/\n.btn-entrar {\n  background-color: #ff8800;\n  color: white;\n  font-weight: 600;\n  text-decoration: none;\n  padding: 10px 22px;\n  border-radius: 100px;\n  font-size: 14px;\n  white-space: nowrap;\n  transition: background 0.3s ease;\n}\n\n.btn-entrar:hover {\ncolor:white;\n  background-color: #DE7500;\n}\n\n\/* --- MOBILE (oculta \"Faltam\") --- *\/\n@media (max-width: 767px) {\n  .barra-topo-conteudo {\n    flex-direction: column;\n    gap: 6px;\n  }\n\n  .barra-timer {\n    font-size: 18px;\n  }\n\n  .barra-texto.branco {\n    font-size: 14px;\n  }\n\n  .texto-faltam {\n    display: none !important;\n  }\n\n  .btn-entrar {\n    width: 100%;\n    text-align: center;\n    padding: 12px;\n    font-size: 15px;\n  }\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  \n  const timerEl = document.getElementById(\"timerRegressivo\");\n  const dataFinal = new Date(\"2025-11-27T19:00:00-03:00\").getTime();\n\n  function atualizarTimer() {\n    const agora = new Date().getTime();\n    const distancia = dataFinal - agora;\n\n    if (distancia <= 0) {\n      timerEl.innerHTML = \"00D : 00H : 00M : 00S\";\n      return;\n    }\n\n    const dias = Math.floor(distancia \/ (1000 * 60 * 60 * 24));\n    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) \/ (1000 * 60 * 60));\n    const minutos = Math.floor((distancia % (1000 * 60 * 60)) \/ (1000 * 60));\n    const segundos = Math.floor((distancia % (1000 * 60)) \/ 1000);\n\n    timerEl.innerHTML =\n      `${dias}D : ${String(horas).padStart(2, '0')}H : ${String(minutos).padStart(2, '0')}M : ${String(segundos).padStart(2, '0')}S`;\n  }\n\n  atualizarTimer();\n  setInterval(atualizarTimer, 1000);\n});\n<\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"main":{"type":"main-page","disabled":true,"settings":{}},"banner_image_kDLHzJ":{"type":"banner-image","blocks":{"image_banner_KEMYUw":{"type":"image_banner","settings":{"banner_width":"12","banner_type":"image","image":"shopify:\/\/shop_images\/BANNER_Topo-DESK_eeefcb40-a77f-4549-b9fe-d0df1c41812d.webp","image_mobile":"shopify:\/\/shop_images\/BANNER_Topo-MOB_f331f49c-c133-427e-b97d-998d2ebcbde7.webp","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","link":"https:\/\/sndflw.com\/i\/sFmKflxiTBSQAu460idJ","product":"","open_link":"_self","subtext":"","title":"","content":"","btn_content":"","button_type":"primary"}}},"block_order":["image_banner_KEMYUw"],"name":"t:sections.banner-image.name","settings":{"heading_logo_svg":"","heading":"","