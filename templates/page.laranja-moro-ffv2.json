68308;\n  color: #FEEA4E;\n  font-weight: normal;\n  height: 100%;\n  width: 0;\n  border-radius: 20px;\n  padding-left: 20px;\n  display: flex;\n  align-items: center;\n  white-space: nowrap;\n  transition: width 2s ease-out;\n  font-size: 16px;\n  justify-content: flex-start;\n}\n\n\/* Botão *\/\n.dena-button-wrapper {\n  margin-top: 30px;\n  margin-bottom: 20px;\n}\n.dena-button {\n  display: inline-block;\n  background-color: #54B101;\n  color: white;\n  padding: 20px 32px;\n  font-size: 16px;\n  border-radius: 50px;\n  text-decoration: none;\n  font-weight: bold;\n  transition: background-color 0.3s ease;\n}\n.dena-button:hover {\n  background-color: #3b8c03;\n  color: white;\n}\n\n\/* Imagem *\/\n.dena-right {\n  flex: 1 1 40%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n.dena-right img {\n  max-width: 100%;\n  height: auto;\n  border-radius: 20px;\n}\n\n\/* MOBILE *\/\n@media (max-width: 768px) {\n  .dena-section {\n    padding: 40px 5px;\n  }\n  .dena-container {\n    flex-direction: column;\n    align-items: center;\n  }\n  .dena-left, .dena-right {\n    flex: 1 1 100%;\n    text-align: center;\n    padding-right: 0;\n  }\n  .bar {\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n  }\n  .fill {\n    font-size: 12px;\n    justify-content: flex-start;\n    padding-left: 10px;\n    text-align: left;\n  }\n.dena-right img {\n  display: none;\n}\n}\n<\/style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const section = document.getElementById(\"resultados-denadena\");\n    const fills = section.querySelectorAll(\".fill\");\n    let hasAnimated = false;\n\n    function isVisible(el) {\n      const rect = el.getBoundingClientRect();\n      return rect.top < window.innerHeight && rect.bottom > 0;\n    }\n\n    function animateBars() {\n      if (hasAnimated) return;\n      if (isVisible(section)) {\n        fills.forEach(el => {\n          const percent = el.getAttribute(\"data-fill\");\n          el.style.width = percent;\n        });\n        hasAnimated = true;\n      }\n    }\n\n    window.addEventListener(\"scroll\", animateBars);\n    animateBars(); \/\/ Dispara uma vez ao carregar\n  });\n<\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":false}},"banner_image_aBYgaJ":{"type":"banner-image","blocks":{"image_banner_nfMmNR":{"type":"image_banner","settings":{"banner_width":"12","banner_type":"image","image":"shopify:\/\/shop_images\/BANNER_Depoimentos-DESK.webp","image_mobile":"shopify:\/\/shop_images\/BANNER_Depoimentos-MOB.webp","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","link":"","product":"","open_link":"_blank","subtext":"","title":"","content":"","btn_content":"","button_type":"primary"}}},"block_order":["image_banner_nfMmNR"],"name":"Banner image","settings":{"heading_logo_svg":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"scheme-1a34e2aa-8504-4194-8f45-b858ac590015","column_gap":30,"layout_on_mobile":false,"design_banner":"text-overlay-image","design_content":"default","text_align":"text-left","hover_effect":"none","h_font_size":36,"h_font_weight":"default","h_spacing":10,"sub_font_size":18,"sub_font_weight":"default","sub_spacing":10,"des_font_size":16,"des_font_weight":"default","des_spacing":30,"image_behavior":"none","text_position":"top","content_on_mobile":false,"reset_color_mb":false,"padding_top":50,"padding_bottom":0,"reset_spacing":true}},"banner_image_J6tCdH":{"type":"banner-image","blocks":{"image_banner_JMqCNy":{"type":"image_banner","settings":{"banner_width":"12","banner_type":"image","image":"shopify:\/\/shop_images\/BANNER_Cupom-LP_Conversao-DESK.webp","image_mobile":"shopify:\/\/shop_images\/BANNER_Cupom-LP_Conversao-MOB.webp","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","link":"","product":"","open_link":"_blank","subtext":"","title":"","content":"","btn_content":"","button_type":"primary"}}},"block_order":["image