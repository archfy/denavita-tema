_color":"#e5eddd","x11cor_borda_color":"#267a5b","x11border_radius":20,"x11title_color":"#333333","x11title_size":36,"x11title_weight":"700","x11title_spacing":30,"x11subtitle_color":"#59000b","x11subtitle_size":22,"x11subtitle_weight":"500","x11benefits_title_color":"#59000b","x11benefits_title_size":24,"x11benefits_title_weight":"600","x11rich_text_color":"#4bb000","x11rich_text_size":16,"x11rich_text_line_height":1.6,"x11button_text":"","x11button_link":"","x11button_bg_color":"#d0021b","x11button_text_color":"#ffffff","x11button_radius":50,"x11button_padding_y":18,"x11button_padding_x":90,"x11image_width_desktop":70,"x11mobile_breakpoint":768,"block_title":"","block_text":"","feature_text_1":"","feature_text_2":"","feature_text_3":"","feature_text_4":""}},"laranja_moro_faq_WyEmwm":{"type":"laranja-moro-faq","blocks":{"faq_item_dLkCAP":{"type":"faq_item","settings":{"question_text":"COMO DEVO CONSUMIR ESSE SUPLEMENTO EM CÁPSULAS?","answer_html":"<p>Consumir 1 cápsula ao dia.<\/p>"}},"faq_item_dqT98X":{"type":"faq_item","settings":{"question_text":"QUANDO DEVO CONSUMIR ESSE SUPLEMENTO?","answer_html":"<p>Não existe um horário específico. O importante é manter uma constância, ou seja, tomar sempre no mesmo horário todos os dias. Como contém cafeína devido ao café verde, o melhor é tomar antes das 18h para não afetar o sono.<\/p>"}},"faq_item_AypLAV":{"type":"faq_item","settings":{"question_text":"POSSO TOMAR MAIS DE 1 CÁPSULA AO DIA?","answer_html":"<p>O ideal é seguir a orientação de consumo descrita na embalagem para aporte dos valores diários descritos na tabela nutricional. Para valores diferentes, consulte um médico ou nutricionista.<\/p>"}},"faq_item_LyAR7r":{"type":"faq_item","settings":{"question_text":"O PRODUTO QUEBRA O JEJUM?","answer_html":"<p>Não. Não possui aporte nutricional que interfere no jejum.<\/p>"}},"faq_item_UUTURn":{"type":"faq_item","settings":{"question_text":"QUAIS AS CONTRAINDICAÇÕES?","answer_html":"<p>Produto contraindicado para gestantes, lactantes e crianças.<\/p>"}},"faq_item_mdXBgW":{"type":"faq_item","settings":{"question_text":"EXISTE DIFERENÇA ENTRE A CÁPSULA E O COMPRIMIDO?","answer_html":"<p>São duas formas de apresentação diferentes para suplementos e deve ser avaliada as concentrações dos nutrientes presentes na lista nutricional. No comprimido, é possível a maior compressão dos ingredientes e princípios ativos, enquanto na cápsula gelatinosa há a facilidade de ingestão e mais rápida dissolução do trato gastrointestinal.<\/p>"}},"faq_item_hCxVTQ":{"type":"faq_item","settings":{"question_text":"ESSE SUPLEMENTO É VEGANO?","answer_html":"<p>Sim.<\/p>"}},"faq_item_33Hnxd":{"type":"faq_item","settings":{"question_text":"VOU EMAGRECER COM ESSE SUPLEMENTO?","answer_html":"<p>Não podemos afirmar o emagrecimento. Os estudos afirmam que as propriedades de queima calórica provenientes da laranja moro e do café verde podem acontecer no organismo humano, porém são facilitadas com o auxílio de exercícios físicos e práticas saudáveis.<\/p>"}}},"block_order":["faq_item_dLkCAP","faq_item_dqT98X","faq_item_AypLAV","faq_item_LyAR7r","faq_item_UUTURn","faq_item_mdXBgW","faq_item_hCxVTQ","faq_item_33Hnxd"],"settings":{"selected_product":"laranja-moro-cafe-verde-e-cromo-30-caps","background_color":"rgba(0,0,0,0)","border_radius":20,"main_heading_text":"Ainda com dúvidas?","main_title_color":"#4bb000","main_title_size":32,"main_title_weight":"600","sub_heading_text":"Veja aqui as principais dúvidas sobre o Laranja Moro","subtitle_color":"#2a2a2a","subtitle_size":18,"subtitle_weight":"500","accordion_border_color":"#000000","accordion_border_width":1,"accordion_border_radius":12,"accordion_border_radius_mobile":8,"accordion_max_width":700,"question_text_color":"#005c47","question_text_size":16,"question_text_weight":"400","answer_text_color":"#333333","answer_text_size":16,"answer_text_weight":"400","icon_color":"#444444"}},"secao_advertencia_cNTQLr":{"type":"secao-advertencia","settings":{"x190selected_produ