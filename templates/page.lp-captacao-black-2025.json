er-radius: 100px; font-size: 14px; white-space: nowrap; transition: background 0.3s ease; } .btn-entrar:hover { background-color: #DE7500; color: white; } @keyframes preencherBarra { 0% { width: 0%; } 100% { width: 87%; } } \/* Oculta toda a barra no mobile *\/ @media screen and (max-width: 767px) { .barra-topo-fixa { display: none !important; } } <\/style> <script> document.addEventListener(\"DOMContentLoaded\", function () { const msgAlerta = document.getElementById(\"msgAlerta\"); \/\/ Cria um marcador invisível no início da página para detectar contraste const marcador = document.createElement('div'); marcador.style.position = 'absolute'; marcador.style.top = '50vh'; marcador.style.width = '1px'; marcador.style.height = '1px'; marcador.style.pointerEvents = 'none'; document.body.appendChild(marcador); const observer = new IntersectionObserver( ([entry]) => { if (entry.isIntersecting) { msgAlerta.classList.remove(\"light\"); } else { msgAlerta.classList.add(\"light\"); } }, { threshold: 0, rootMargin: \"-1px 0px 0px 0px\" } ); observer.observe(marcador); }); <\/script>","padding_top":0,"padding_bottom":0,"reset_spacing":true}},"custom_html_eafJpw":{"type":"custom-html","name":"t:sections.custom-html.name","settings":{"heading_logo_svg":"","heading":"","description":"","text_alignment":"text-center","container":"container","color_scheme":"","content_html":"<!-- Meta Pixel Base Code -->\n<script>\n  !function(f,b,e,v,n,t,s)\n  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n  n.callMethod.apply(n,arguments):n.queue.push(arguments)};\n  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';\n  n.queue=[];t=b.createElement(e);t.async=!0;\n  t.src=v;s=b.getElementsByTagName(e)[0];\n  s.parentNode.insertBefore(t,s)}(window, document,'script',\n  'https:\/\/connect.facebook.net\/en_US\/fbevents.js');\n  fbq('init', '1120227461949168'); \n  fbq('track', 'PageView');\n<\/script>\n<noscript>\n  <img height=\"1\" width=\"1\" src=\"https:\/\/www.facebook.com\/tr?id=112