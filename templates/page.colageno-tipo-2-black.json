g_item_column_b1_djfCke"],"settings":{"background_type":"color","background_color":"#e7fffc","border_color":"rgba(0,0,0,0)","border_thickness":1,"border_radius":20,"container_margin_left":0,"container_margin_right":0,"section_padding_top":10,"section_padding_bottom":10,"inner_padding":10,"content_vertical_align":"center","title":"","title_color":"#222222","subtitle":"","subtitle_color":"#444444","description":"","description_color":"#666666","text_align":"flex-start","right_column_richtext":"<p>Esse Blend exclusivo à base de <strong>Colágeno tipo II, MSM e Magnésio<\/strong> é uma fórmula avançada que promove a saúde das articulações e a flexibilidade do corpo. <br\/> <\/p><p>Esses ingredientes trabalham juntos para fornecer benefícios significativos para o sistema musculoesquelético.<br\/> <\/p><p>O <strong>Colágeno tipo II<\/strong> é essencial para a integridade estrutural das articulações, enquanto o <strong>MSM<\/strong> reduz a inflamação e ajuda na síntese de colágeno. O <strong>Magnésio<\/strong> desempenha um papel importante na função muscular e na manutenção óssea adequada.<br\/> <\/p><p>Essa combinação sinérgica fortalece e protege as articulações, promovendo a reconstrução e fortalecimento da cartilagem.<br\/> <\/p><p>Além disso, reduz a inflamação, alivia a dor e melhora a mobilidade e flexibilidade do corpo.<\/p>","right_column_richtext_size":16,"right_column_richtext_color":"#000000","right_column_richtext_strong_color":"#000000","botao_bg_color":"#367300","botao_text_color":"#ffffff","botao_link":"","botao_label":"ESCOLHER SABOR","button_padding_x":90,"button_padding_y":20,"button_margin_top":20,"reverse_columns":false}},"quitosana_essencia_v1_TPNngP":{"type":"quitosana-essencia-v1","blocks":{"composition_item_Kd4hVw":{"type":"composition_item","settings":{"block_title":"COLÁGENO TIPO II NÃO DESNATURADO","block_description":"<p>Proteína natural nas articulações que mantém a elasticidade e resistência da cartilagem.<\/p>","block_image":"shopify:\/\/s