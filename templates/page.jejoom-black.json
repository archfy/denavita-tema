_nutri":"","btn_link_info_nutri":"#","btn_color_info_nutri":"#ffffff","btn_bg_color_info_nutri":"#28a745","btn_border_radius_info_nutri":5,"button_alignment_info_nutri":"center","button_margin_top_info_nutri":30,"button_margin_bottom_info_nutri":0}},"custom_info_nutricional_X389jX":{"type":"custom-info-nutricional","blocks":{"desc_qWXbgJ":{"type":"desc","settings":{"desc":"<p><strong>Dosagem Recomendada \/ Modo de Usar<\/strong><\/p><p>1 porção (1 dosadores de 6g), 1 vez ao dia (verifique o horário com seu nutricionista) ou seguindo as orientações do seu médico.<\/p><p>Não contém açúcar, Não contém glúten, Não engorda.<\/p>","desc_fs":16,"desc_fw":400,"content_width":100,"desc_tf":"unset","desc_mt":0,"desc_mb":0}}},"block_order":["desc_qWXbgJ"],"name":"Custom Info nutricional","settings":{"container":"container","text_align":"text-center","color_scheme":"","custom_class":"","padding_top":0,"padding_bottom":0,"reset_spacing":false,"custom_lps":true}},"quitosana_secao_bonus_especial_RankTX":{"type":"quitosana-secao-bonus-especial","disabled":true,"settings":{"x11selected_product":"","x11background_color":"#f8f8f8","x11cor_borda_color":"#4bb000","x11border_radius":20,"x11title_color":"#333333","x11title_size":36,"x11title_weight":"700","x11title_spacing":30,"x11subtitle_color":"#59000b","x11subtitle_size":22,"x11subtitle_weight":"500","x11benefits_title_color":"#59000b","x11benefits_title_size":24,"x11benefits_title_weight":"600","x11rich_text_color":"#4bb000","x11rich_text_size":16,"x11rich_text_line_height":1.6,"x11button_text":"COMPRAR AGORA","x11button_link":"","x11button_bg_color":"#d0021b","x11button_text_color":"#ffffff","x11button_radius":50,"x11button_padding_y":18,"x11button_padding_x":120,"x11image_width_desktop":100,"x11mobile_breakpoint":768,"block_title":"","block_text":"","feature_text_1":"","feature_text_2":"","feature_text_3":"","feature_text_4":""}},"jejoom_faq_PchWhA":{"type":"jejoom-faq","blocks":{"faq_item_8q649N":{"type":"faq_item","settings":{"question_text":"O Jejoom ajuda na perda de peso?","answer_html":"<p>Sim, pois sua fórmula atua na lipólise, que é a quebra da gordura corporal. Portanto, Jejoom desincha, acelera a detoxificação e, consequentemente, o metabolismo.<\/p>"}},"faq_item_UhTwhi":{"type":"faq_item","settings":{"question_text":"Posso tomar à noite?","answer_html":"<p>Jejoom pode ser consumido a qualquer horário do dia, sendo excelente para se manter em Jejum pela manhã, antes das refeições para melhorar a digestão dos alimentos e\/ou a noite, ao iniciar o seu jejum noturno para melhorar o processo de detox corporal.<\/p>"}},"faq_item_Byy46p":{"type":"faq_item","settings":{"question_text":"O que é Morosil?","answer_html":"<p>É o extrato concentrado das laranja moro, uma laranja exclusivamente cultivada na Itália, próximo ao vulcão Etna, com poderosos antioxidantes capazes de promover a lipólise, que é a quebra de gorduras corporal, facilitando sua eliminação para promover a redução de medidas.<\/p>"}},"faq_item_xWfcL6":{"type":"faq_item","settings":{"question_text":"Quais são os benefícios do Jejoom?","answer_html":"<p>Este produto foi pensado e criado com ativos metabólicos antioxidantes e antiinflamatórios, para auxiliar na imunidade e acelerar o metabolismo, oferecendo mais energia para o dia todo.<\/p>"}}},"block_order":["faq_item_8q649N","faq_item_UhTwhi","faq_item_Byy46p","faq_item_xWfcL6"],"settings":{"selected_product":"jejoom-shot-matinal-para-metabolismo","background_color":"rgba(0,0,0,0)","border_radius":20,"main_heading_text":"Acabe com suas dúvidas:","main_title_color":"#4bb000","main_title_size":32,"main_title_weight":"400","sub_heading_text":"Perguntas Frequentes sobre Jejoom","subtitle_color":"#005c47","subtitle_size":18,"subtitle_weight":"400","accordion_border_color":"#000000","accordion_border_width":1,"accordion_border_radius":12,"accordion_border_radius_mobile":8,"accordion_max_width":700,"question_text_color":"#005c47","question_text_size":16,"question_text_weight":"400",