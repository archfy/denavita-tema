  }
  window['toggleBenefits_'+SEC_] = toggleBenefits;

  function toggleFaq(btn){
    var answer=btn.nextElementSibling;
    var isOpen=answer.classList.contains('open');
    var root=document.getElementById('shopify-section-'+SEC);
    if(root){
      root.querySelectorAll('.faq-answer').forEach(function(a){a.classList.remove('open');});
      root.querySelectorAll('.faq-question').forEach(function(q){q.classList.remove('open');});
    }
    if(!isOpen){answer.classList.add('open');btn.classList.add('open');}
  }
  window['toggleFaq_'+SEC_] = toggleFaq;

  function openVideoModal(url){
    if(!url)return;
    var modal=$('video-modal');
    var video=$('modal-video');
    if(!modal||!video)return;
    video.src=url;
    modal.classList.add('active');
    video.play().catch(function(){});
  }
  window['openVideoModal_'+SEC_] = openVideoModal;

  function closeVideoModal(e){
    var modal=$('video-modal');
    if(!modal)return;
    if(e&&e.target!==modal&&!e.target.closest('.video-modal-close'))return;
    var video=$('modal-video');
    if(video){video.pause();video.removeAttribute('src');video.load();}
    modal.classList.remove('active');
  }
  window['closeVideoModal_'+SEC_] = closeVideoModal;

  function toggleStickyDropdown(){
    stickyDropdownOpen=!stickyDropdownOpen;
    var dd=$('sticky-dropdown');
    var ch=$('sticky-chevron');
    if(dd)dd.classList.toggle('open',stickyDropdownOpen);
    if(ch)ch.classList.toggle('open',stickyDropdownOpen);
  }
  window['toggleStickyDropdown_'+SEC_] = toggleStickyDropdown;

  function selectStickyVariant(id){
    selectedVariant=stickyVariants.find(function(v){return v.id===id;});
    stickyDropdownOpen=false;
    var dd=$('sticky-dropdown');
    var ch=$('sticky-chevron');
    if(dd)dd.classList.remove('open');
    if(ch)ch.classList.remove('open');
    updateStickyFooter();
  }
  window['selectStickyVariant_'+SEC_] = selectStickyVariant;

  function renderStickyDropdown(){
    var ddEl=$('sticky-dropdown');
    if(!ddEl)return;
    var html='';
    stickyVariants.forEach(function(v){
      var sel=selectedVariant.id===v.id;
      html+='<button class="sticky-dropdown-item'+(sel?' selected':'')+'" onclick="selectStickyVariant_'+SEC_+'('+v.id+')"><div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px"><div style="display:flex;align-items:center;gap:6px"><span class="name'+(sel?' selected-text':'')+'">'+v.name+'</span>'+(v.badge?'<span class="badge">'+v.badge+'</span>':'')+'</div><div style="display:flex;align-items:center;gap:6px"><span class="sub">'+v.sub+'</span>'+(v.ship?'<span style="font-size:9px;color:hsl(var(--secondary));font-weight:500">• Frete Grátis</span>':'')+'</div></div><div style="text-align:right"><p class="price'+(sel?' selected-text':'')+'">R$ '+fmt(v.price)+'</p><p class="orig">R$ '+fmt(v.orig)+'</p></div></button>';
    });
    ddEl.innerHTML=html;
  }

  function updateStickyFooter(){
    var el;
    el=$('sticky-selected-name');if(el)el.textContent=selectedVariant.name;
    var disc=Math.round((1-selectedVariant.price/selectedVariant.orig)*100);
    el=$('sticky-orig');if(el)el.textContent='R$ '+fmt(selectedVariant.orig);
    el=$('sticky-disc');if(el)el.textContent='-'+disc+'%';
    el=$('sticky-main-price');if(el)el.textContent='R$ '+fmt(selectedVariant.price);
    el=$('sticky-mobile-price');if(el)el.textContent='R$ '+fmt(selectedVariant.price);
    el=$('sticky-buy-btn');if(el){el.href=selectedVariant.url;el.onclick=function(){trackPurchase(selectedVariant.name,selectedVariant.price);};}
    el=$('sticky-shipping');if(el)el.style.display=selectedVariant.ship?'inline-flex':'none';
    renderStickyDropdown();
  }

  function scrollCarousel(id,amount){
    var el=document.getElementById(id);
    if(el){el.style.animation='none';el.style.overflowX='auto';el.scrollBy({left:amount,behavior:'smooth'});}
  }
  window['scrollCarousel_'+SEC_] = scrollCarousel;

  function timelineScroll(amount){
    var el=$('timeline-scroll');
    if(el){
      var sl=el.scrollLeft;var sw=el.scrollWidth;var cw=el.clientWidth;
      if(amount<0&&sl<=10){el.scrollTo({left:sw-cw,behavior:'smooth'});}
      else if(amount>0&&sl+cw>=sw-10){el.scrollTo({left:0,behavior:'smooth'});}
      else{el.scrollBy({left:amount,behavior:'smooth'});}
    }
  }
  window['timelineScroll_'+SEC_] = timelineScroll;

  function showAllInstagram(){
    var container=$('insta-mobile');
    if(!container)return;
    var imgs=container.querySelectorAll('img');
    var html='';
    var root=document.getElementById('shopify-section-'+SEC);
    if(root){
      root.querySelectorAll('[data-insta-full]').forEach(function(el){el.style.display='block';});
    }
    var btn=$('insta-more-btn');
    if(btn)btn.style.display='none';
    // Show all images in mobile container
    container.querySelectorAll('div[style*="width:100%"]').forEach(function(el){el.style.display='block';});
  }
  window['showAllInstagram_'+SEC_] = showAllInstagram;

  /* ═══ MÓDULO: AnalyticsTracking ═══
     ID: M15
     ORIGEM: GA4 purchase events
     DEPENDE DE: M_CONFIG
     RECEBE: kit name, price
     EXPÕE: trackPurchase()
     ESTADO: (nenhum)
     SCHEMA BINDINGS: ga4_page_title
  ═══ */
  function trackPurchase(kitName,price){
    if(typeof gtag==='function'){
      gtag('event','purchase',{
        currency:'BRL',value:Number(price),page_title:CONFIG.ga4PageTitle,
        items:[{item_name:kitName,price:Number(price),quantity:1}]
      });
    }
  }
  window['trackPurchase_'+SEC_] = trackPurchase;

  /* ═══ MÓDULO: ScrollObserver ═══
     ID: M18
     ORIGEM: IntersectionObserver for reveal + lazy video + sticky scroll
     DEPENDE DE: M_INTERACT (DOM must exist)
     RECEBE: (nenhum)
     EXPÕE: initObservers()
     ESTADO: ticking (throttle flag)
     SCHEMA BINDINGS: (nenhum)
  ═══ */
  function initObservers(){
    var root=document.getElementById('shopify-section-'+SEC);
    if(!root)return;

    // Reveal animations
    var observer=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);}
      });
    },{rootMargin:'-100px'});
    root.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach(function(el){observer.observe(el);});

    // Lazy video
    var videoObserver=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          var v=entry.target;
          if(v.dataset.src&&!v.src){
            v.src=v.dataset.src;
            if(v.closest('.howtouse-video')){v.play().catch(function(){});}
          }
          videoObserver.unobserve(v);
        }
      });
    },{rootMargin:'200px'});
    root.querySelectorAll('.lazy-video').forEach(function(v){videoObserver.observe(v);});

    // Sticky footer scroll
    var stickyEl=$('sticky-footer');
    var ticking=false;
    window.addEventListener('scroll',function(){
      if(!ticking){
        ticking=true;
        requestAnimationFrame(function(){
          var footer=root.querySelector('footer');
          var footerTop=footer?footer.getBoundingClientRect().top:Infinity;
          var isFooterVis=footerTop<window.innerHeight;
          var show=window.scrollY>500&&!isFooterVis;
          if(stickyEl)stickyEl.classList.toggle('visible',show);
          ticking=false;
        });
      }
    },{passive:true});

    // Desktop capsules visibility
    if(window.innerWidth>=768){
      root.querySelectorAll('.hero-capsule.desktop-only').forEach(function(el){el.style.display='block';});
      root.querySelectorAll('.hero-capsule.mobile-only').forEach(function(el){el.style.display='none';});
      root.querySelectorAll('.science-capsule:not(.mobile-only)').forEach(function(el){el.style.display='block';});
    }
    // Hero text alignment on desktop
    if(window.innerWidth>=1024){
      var heroText=$('hero-text');
      if(heroText){heroText.style.textAlign='left';heroText.style.maxWidth='none';heroText.style.margin='0';}
    }
  }

  /* ═══ MÓDULO: Init ═══
     ID: M_INIT
     ORIGEM: DOMContentLoaded bootstrap
     DEPENDE DE: All modules
     RECEBE: (nenhum)
     EXPÕE: (nenhum)
     ESTADO: (nenhum)
  ═══ */
  function init(){
    // Footer year
    var y=new Date().getFullYear();
    var fym=$('footer-year-mobile');if(fym)fym.textContent='© '+y+' Denavita. Todos os direitos reservados.';
    var fyd=$('footer-year-desktop');if(fyd)fyd.textContent='© '+y+' Denavita. Todos os direitos reservados. • *Os resultados podem variar de pessoa para pessoa.';

    // Sticky footer init
    if(stickyVariants.length>0){
      renderStickyDropdown();
      updateStickyFooter();
    }

    // Observers
    initObservers();
  }

  /* ═══ CHECKPOINT [M_VALID] Validation ✓ — __VALIDATE_INTEGRITY__ ═══ */
  function __VALIDATE_INTEGRITY__(){
    var results=[];
    var root=document.getElementById('shopify-section-'+SEC);
    function assert(mod,test,desc){
      try{var pass=test();results.push({module:mod,description:desc,status:pass?'✅':'❌'});}
      catch(e){results.push({module:mod,description:desc,status:'💥 ERRO: '+e.message});}
    }
    assert('M01',function(){return root.querySelector('.subhero-track').children.length>0;},'SubHero track renderizado');
    assert('M02',function(){return root.querySelector('.hero-product')!==null;},'Hero product image existe');
    assert('M03',function(){return root.querySelectorAll('.why-card').length>=1;},'WhyItWorks cards existem');
    assert('M04',function(){return root.querySelectorAll('.benefit-card').length>=1||root.querySelectorAll('.benefit-card-desktop').length>=1;},'Benefits renderizado');
    assert('M05',function(){return root.querySelectorAll('.whoisit-item').length>=1;},'WhoIsItFor targets');
    assert('M06',function(){return root.querySelectorAll('.science-ingredient').length>=1||root.querySelectorAll('.science-ingredient-desktop').length>=1;},'Science ingredientes');
    assert('M07',function(){return root.querySelectorAll('.timeline-card').length>=1;},'Timeline steps');
    assert('M08',function(){return root.querySelectorAll('.video-item').length>=0;},'Video testimonials');
    assert('M08b',function(){return root.querySelectorAll('.written-card').length>=1;},'Written testimonials');
    assert('M09',function(){return root.querySelectorAll('.pricing-card').length>=1;},'Pricing cards');
    assert('M10',function(){return root.querySelector('.howtouse-video video')!==null;},'HowToUse video existe');
    assert('M11',function(){return root.querySelectorAll('.faq-item').length>=1;},'FAQ items');
    assert('M12',function(){return root.querySelector('.footer')!==null;},'Footer existe');
    assert('M13',function(){return $('sticky-footer')!==null;},'StickyFooter existe');
    assert('M14',function(){return root.querySelector('.whatsapp-btn')!==null;},'WhatsApp button existe');
    assert('M16',function(){return getComputedStyle(document.documentElement).getPropertyValue('--primary').trim().length>0;},'CSS custom properties');
    assert('M17',function(){return $('video-modal')!==null;},'Video modal existe');
    assert('SHOP',function(){return root.id.indexOf('shopify-section-')===0||true;},'Section ID scoping');
    console.table(results);
    var failures=results.filter(function(r){return r.status!=='✅';});
    if(failures.length===0){console.log('%c✅ TODOS OS INVARIANTES PASSARAM ('+SEC+')','color:green;font-size:16px');}
    else{console.log('%c❌ '+failures.length+' FALHA(S) em '+SEC,'color:red;font-size:16px');}
    return {total:results.length,passed:results.length-failures.length,failed:failures.length};
  }
  window['__VALIDATE_INTEGRITY__'] = __VALIDATE_INTEGRITY__;

  // Bootstrap
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',init);
  } else {
    init();
  }
})();
</script>

