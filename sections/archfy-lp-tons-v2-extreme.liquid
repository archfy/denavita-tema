<style>
/* ═══ CHECKPOINT [M16] DesignSystem ✓ — CSS custom properties alimentadas pelo schema via Liquid ═══ */
#shopify-section-{{ section.id }} {
  --lm-primary: {{ section.settings.color_primary }};
  --lm-primary-dark: {{ section.settings.color_primary_dark }};
  --lm-secondary: {{ section.settings.color_secondary }};
  --lm-foreground: {{ section.settings.color_foreground }};
  --lm-muted-fg: {{ section.settings.color_muted_fg }};
  --lm-background: {{ section.settings.color_background }};
  --lm-footer-bg: {{ section.settings.color_footer_bg }};
  --lm-padding-top: {{ section.settings.section_padding_top }}px;
  --lm-padding-bottom: {{ section.settings.section_padding_bottom }}px;
}

/* ═══ MÓDULO: DesignSystem ═══
   ID: M16
   ORIGEM: index.css + tailwind.config.ts
   DEPENDE DE: (nenhum)
   RECEBE: (nenhum)
   EXPÕE: CSS custom properties, utility classes, animations
   ESTADO: (nenhum)
═══ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
--background:0 0% 100%;--foreground:220 20% 15%;
--primary:90 99% 35%;--primary-fg:0 0% 100%;--primary-dark:90 99% 25%;--primary-light:90 60% 90%;
--secondary:25 95% 52%;--secondary-fg:0 0% 100%;--secondary-light:30 100% 95%;
--accent:25 95% 52%;--accent-fg:0 0% 100%;--accent-light:30 100% 95%;
--muted:220 15% 96%;--muted-fg:220 10% 45%;
--destructive:0 84% 60%;--destructive-fg:0 0% 100%;
--border:220 15% 90%;--radius:0.75rem;--footer-bg:100 98% 13%;
--gradient-hero:linear-gradient(135deg,hsl(90 99% 35%) 0%,hsl(90 99% 25%) 100%);
--gradient-orange:linear-gradient(135deg,hsl(25 95% 52%) 0%,hsl(15 90% 50%) 100%);
--gradient-subtle:linear-gradient(180deg,hsl(0 0% 100%) 0%,hsl(220 15% 96%) 100%);
--gradient-green-light:linear-gradient(180deg,hsl(90 60% 95%) 0%,hsl(90 60% 90%) 100%);
}
html,body{overflow-x:hidden;max-width:100vw}
body{background:hsl(var(--background));color:hsl(var(--foreground));font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;line-height:1.5}
h1,h2,h3,h4,h5,h6{font-family:'Poppins',sans-serif;line-height:1.2}
a{text-decoration:none;color:inherit}
img{max-width:100%;height:auto;display:block}
button{cursor:pointer;border:none;background:none;font-family:inherit}
.container{width:100%;max-width:1400px;margin:0 auto;padding:0 1rem}
.overflow-hidden{overflow:hidden}
/* Icons */
.icon{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.icon svg{width:100%;height:100%;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
/* Animations */
@keyframes pulse-glow{0%,100%{box-shadow:0 0 0 0 hsl(90 99% 35%/.4)}50%{box-shadow:0 0 0 15px hsl(90 99% 35%/0)}}
@keyframes shine{0%{left:-100%}50%,100%{left:100%}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes scroll-subhero{0%{transform:translateX(0)}100%{transform:translateX(-25%)}}
@keyframes scroll-left{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@keyframes scroll-videos{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@keyframes capsule-float-1{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-15px) rotate(10deg)}}
@keyframes capsule-float-2{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-20px) rotate(-15deg)}}
@keyframes capsule-float-3{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(20deg)}}
@keyframes fade-in-up{0%{opacity:0;transform:translateY(30px)}100%{opacity:1;transform:translateY(0)}}
@keyframes fade-in-left{0%{opacity:0;transform:translateX(-30px)}100%{opacity:1;transform:translateX(0)}}
@keyframes fade-in-right{0%{opacity:0;transform:translateX(30px)}100%{opacity:1;transform:translateX(0)}}
@keyframes scale-in{0%{opacity:0;transform:scale(.8)}100%{opacity:1;transform:scale(1)}}
.animate-float{animation:float 3s ease-in-out infinite}
.btn-pulse{animation:pulse-glow 2s ease-in-out infinite}
.btn-shine{position:relative;overflow:hidden}
.btn-shine::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);animation:shine 2.5s infinite}
.animate-scroll-subhero{animation:scroll-subhero 15s linear infinite;width:max-content}
.animate-scroll-videos{animation:scroll-videos 60s linear infinite;width:max-content}
.animate-scroll-videos:hover{animation-play-state:paused}
.animate-scroll-left{animation:scroll-left 60s linear infinite;width:max-content}
.animate-scroll-left:hover{animation-play-state:paused}
/* Intersection Observer reveal */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-30px);transition:opacity .6s ease,transform .6s ease}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(30px);transition:opacity .6s ease,transform .6s ease}
.reveal-right.visible{opacity:1;transform:translateX(0)}
/* Geometric shapes */
.geo-circle{position:absolute;border-radius:50%;opacity:.2}
/* Button base */
.btn{display:inline-flex;align-items:center;justify-content:center;font-weight:700;border-radius:9999px;transition:all .2s;cursor:pointer;text-decoration:none}
.btn-primary{background:hsl(var(--primary));color:#fff}
.btn-primary:hover{background:hsl(var(--primary-dark))}
.btn-white{background:#fff;color:hsl(var(--primary))}
.btn-white:hover{background:rgba(255,255,255,.9)}
.btn-outline{background:rgba(255,255,255,.8);color:hsl(var(--foreground));border:1px solid hsl(var(--border))}
.btn-outline:hover{background:#fff}
.btn-green-wa{background:#25D366;color:#fff}
.btn-green-wa:hover{background:#20BD5A}
.btn-lg{font-size:1.125rem;padding:.75rem 2rem}
.btn-sm{font-size:.875rem;padding:.5rem 1rem}
.btn-icon{width:2.5rem;height:2.5rem;padding:0;border-radius:9999px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.1);border:1px solid hsl(var(--border))}
/* Scrollbar hide */
.scrollbar-hide{scrollbar-width:none;-ms-overflow-style:none}
.scrollbar-hide::-webkit-scrollbar{display:none}

/* Render optimization for below-fold sections */
.why-section,.benefits-section,.whoisit-section,.science-section,.timeline-section,.testimonials-section,.howtouse-section,.faq-section,.footer{content-visibility:auto;contain-intrinsic-size:auto 800px}

/* ═══ M01 SubHeroSection ═══ */
.subhero{background:hsl(var(--primary));padding:.75rem 0;overflow:hidden}
.subhero-track{display:flex;align-items:center}
.subhero-item{display:flex;align-items:center;flex-shrink:0}
.subhero-item span{color:#fff;font-weight:600;font-size:.875rem;white-space:nowrap;padding:0 1rem}
.subhero-dot{color:rgba(255,255,255,.6);margin:0 .5rem}

/* ═══ M02 HeroSection ═══ */
.hero{position:relative;min-height:100vh;overflow:hidden;background-image:var(--gradient-orange)}
.hero .wave-bottom{position:absolute;bottom:-1px;left:0;width:100%;z-index:20;height:80px}
.hero-content{position:relative;z-index:10;padding:100px 0 80px}
.hero-grid{display:grid;grid-template-columns:1fr;gap:2rem;align-items:center}
.hero-badge{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.2);backdrop-filter:blur(8px);border-radius:9999px;padding:.5rem 1rem;margin-bottom:1.5rem}
.hero-badge span{font-size:.875rem;color:#fff;font-weight:500}
.hero h1{font-size:2.25rem;font-weight:700;color:#fff;line-height:1.1;margin-bottom:1.5rem}
.hero h1 .highlight{color:#fde047}
.hero-desc{font-size:1.125rem;color:rgba(255,255,255,.9);margin-bottom:2rem;max-width:36rem}
.hero-img-wrap{position:relative;display:flex;justify-content:center}
.hero-glow{position:absolute;inset:0;background:rgba(255,255,255,.3);border-radius:9999px;filter:blur(48px);transform:scale(.75)}
.hero-product{position:relative;z-index:10;width:320px;height:auto;animation:float 3s ease-in-out infinite}
.hero-capsule{position:absolute;height:auto}
.hero-floating-badge{position:absolute;background:#fff;border-radius:1rem;padding:1rem;z-index:20;text-align:center}
.hero-floating-badge .val{font-size:1.875rem;font-weight:700}
.hero-floating-badge .lbl{font-size:.75rem;color:hsl(var(--muted-fg))}
.badge-right{right:-1rem;top:4rem}
.badge-left{left:-1rem;bottom:6rem}
.val-green{color:hsl(var(--primary))}
.val-orange{color:hsl(var(--secondary))}

/* ═══ M03 WhyItWorksSection ═══ */
.why-section{padding:5rem 0 0;background:#fff;position:relative;overflow:hidden;margin-top:-1px}
.why-grid{display:grid;grid-template-columns:1fr;gap:3rem;align-items:center}
.why-card{background:hsl(var(--secondary-light));border-left:4px solid hsl(var(--secondary));border-radius:0 .75rem .75rem 0;padding:1.5rem}
.why-card-inner{display:flex;align-items:flex-start;gap:1rem}
.why-icon-box{width:3rem;height:3rem;background:hsl(var(--secondary));border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff}
.why-card h3{font-size:1.125rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.25rem}
.why-card p{color:hsl(var(--muted-fg));font-size:.875rem}
.why-accordion-header{display:flex;align-items:center;gap:1rem;width:100%;padding:1rem;cursor:pointer;border:none;background:none;text-align:left}
.why-accordion-header h3{flex:1}
.why-accordion-content{max-height:0;overflow:hidden;transition:max-height .3s ease}
.why-accordion-content.open{max-height:200px}
.why-accordion-content p{padding:0 1rem 1rem 4.5rem}
.why-celebrity{max-height:600px;object-fit:contain;object-position:bottom}
/* Desktop cards (non-accordion) */
.why-cards-desktop{display:none}
.why-accordion-mobile{display:block}
.section-tag{display:inline-block;font-weight:600;font-size:.875rem;padding:.5rem 1rem;border-radius:9999px;margin-bottom:1rem}
.section-title{font-size:1.875rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:1rem}
.section-subtitle{font-size:1.125rem;color:hsl(var(--muted-fg));max-width:42rem;margin:0 auto}
.text-center{text-align:center}

/* ═══ M04 BenefitsGridSection ═══ */
.benefits-section{padding:5rem 0;background-image:var(--gradient-green-light);position:relative;overflow:hidden}
.benefits-grid{display:grid;gap:1rem}
.benefit-card{background:rgba(255,255,255,.5);backdrop-filter:blur(12px);border-radius:1rem;padding:1.25rem;border:1px solid rgba(255,255,255,.5)}
.benefit-card-inner{display:flex;align-items:flex-start;gap:1rem}
.benefit-icon{width:3rem;height:3rem;background:hsl(var(--secondary));border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff}
.benefit-card h3{font-size:1.125rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.25rem}
.benefit-card p{color:hsl(var(--muted-fg));font-size:.875rem}
.benefits-expand{text-align:center;margin-top:1.5rem}
.benefits-desktop{display:none}
.benefits-mobile-hidden{display:none}

/* ═══ M05 WhoIsItForSection ═══ */
.whoisit-section{padding:5rem 0;background:#fff;position:relative;overflow:hidden}
.whoisit-diagonal{position:absolute;top:0;right:0;width:50%;height:100%;background:hsl(var(--secondary-light));transform:skewX(12deg);transform-origin:top right}
.whoisit-grid{display:grid;grid-template-columns:1fr;gap:3rem;align-items:center}
.whoisit-women{width:100%;max-width:700px;margin:0 auto}
.whoisit-list{display:flex;flex-direction:column;gap:1rem}
.whoisit-item{display:flex;align-items:center;gap:1rem;background:#fff;border-radius:.75rem;padding:1rem;transition:background .2s}
.whoisit-item-icon{width:2.5rem;height:2.5rem;background:hsl(var(--primary-light));border-radius:9999px;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:hsl(var(--primary))}
.whoisit-check{width:1.5rem;height:1.5rem;color:hsl(var(--primary));flex-shrink:0}
.whoisit-item p{font-weight:500;color:hsl(var(--foreground))}
.whoisit-cta{margin-top:3rem;text-align:center;max-width:48rem;margin-left:auto;margin-right:auto}
.whoisit-cta p{font-size:1.125rem;font-weight:500;color:hsl(var(--foreground));margin-bottom:1.5rem}
.whoisit-cta .green{color:hsl(var(--primary));font-weight:700}
.whoisit-cta .orange{color:hsl(var(--secondary));font-weight:700}
.whoisit-wave{position:absolute;bottom:-1px;left:0;width:100%;height:80px}

/* ═══ M06 ScienceHeroSection ═══ */
.science-section{padding:2rem 0 4rem;background:hsl(var(--secondary));position:relative;overflow:hidden}
.science-ingredients{display:flex;flex-direction:column;gap:.75rem;margin-bottom:2.5rem}
.science-ingredient{background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border-radius:.75rem;padding:1rem;border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;gap:1rem}
.science-ingredient-icon{width:3.5rem;height:3.5rem;background:#fff;border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:hsl(var(--secondary))}
.science-ingredient h3{font-size:1rem;font-weight:700;color:#fff}
.science-ingredient p{color:rgba(255,255,255,.7);font-size:.875rem}
.science-desktop-grid{display:none}
.science-mobile-list{display:flex;flex-direction:column;gap:.75rem}
.science-study{background:#fff;border-radius:1rem;padding:1.5rem;max-width:56rem;margin:0 auto}
.science-study-label{display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem}
.science-study-label span{font-size:.75rem;font-weight:700;color:hsl(var(--primary));text-transform:uppercase;letter-spacing:.05em}
.science-study h3{font-size:1.25rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:1rem}
.science-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:1rem}
.science-stat{text-align:center;padding:.75rem;background:hsl(var(--primary-light));border-radius:.75rem}
.science-stat .val{font-size:1.25rem;font-weight:700;color:hsl(var(--primary))}
.science-stat .lbl{font-size:.625rem;color:hsl(var(--muted-fg))}
.science-study .desc{font-size:.875rem;color:hsl(var(--muted-fg));margin-bottom:.75rem}
.science-study .source{font-size:.75rem;color:hsl(var(--muted-fg));opacity:.7;font-style:italic}
.science-badges{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-top:2rem}
.science-badge{display:flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.2);backdrop-filter:blur(4px);border-radius:9999px;padding:.375rem .75rem}
.science-badge span{font-size:.75rem;color:#fff;font-weight:500}
.science-wave{position:absolute;bottom:0;left:0;width:100%;height:80px}
.science-capsule{position:absolute;opacity:.7}

/* ═══ M07 TimelineSection ═══ */
.timeline-section{padding:5rem 0;background:#fff;position:relative;overflow:hidden}
.timeline-section .bg-dots{position:absolute;inset:0;opacity:.05;background-image:radial-gradient(circle at 1px 1px,currentColor 1px,transparent 0);background-size:40px 40px}
.timeline-mobile{position:relative}
.timeline-scroll{display:flex;gap:1rem;padding:1rem 2.5rem;overflow-x:auto;scroll-snap-type:x mandatory}
.timeline-card{flex-shrink:0;width:18rem;scroll-snap-align:center}
.timeline-card-inner{background:hsl(var(--secondary-light));border-radius:1rem;padding:1.5rem;height:100%;border:1px solid hsl(var(--secondary)/.2)}
.timeline-card-header{display:flex;align-items:center;gap:.75rem;margin-bottom:1rem}
.timeline-card-icon{width:3rem;height:3rem;background:hsl(var(--secondary));border-radius:9999px;display:flex;align-items:center;justify-content:center;color:#fff}
.timeline-card-step{font-size:.875rem;font-weight:700;color:hsl(var(--secondary))}
.timeline-period{display:inline-block;padding:.25rem .75rem;border-radius:9999px;font-size:.75rem;font-weight:700;margin-bottom:.75rem;background:hsl(var(--secondary)/.2);color:hsl(var(--secondary))}
.timeline-card h3{font-size:1.125rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.5rem}
.timeline-card p{font-size:.875rem;color:hsl(var(--muted-fg))}
.timeline-desktop{display:none}
.timeline-desktop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.timeline-arrows{position:absolute;top:50%;left:0;right:0;display:flex;justify-content:space-between;pointer-events:none;transform:translateY(-50%);z-index:10;padding:0}
.timeline-arrows button{pointer-events:all}

/* ═══ M08 TestimonialsSection ═══ */
.testimonials-section{padding:5rem 0;background-image:var(--gradient-green-light);position:relative;overflow:hidden}
.testimonials-videos{margin-bottom:4rem;position:relative}
.video-carousel{overflow:hidden;padding:1rem 0}
.video-track{display:flex;gap:1rem}
.video-item{position:relative;border-radius:1rem;overflow:hidden;flex-shrink:0;width:12rem;cursor:pointer}
.video-item video{width:100%;height:20rem;object-fit:cover;border-radius:1rem}
.video-play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.video-play-btn{width:3.5rem;height:3.5rem;background:rgba(255,255,255,.9);border-radius:9999px;display:flex;align-items:center;justify-content:center;transition:transform .2s}
.video-item:hover .video-play-btn{transform:scale(1.1)}
.ba-section{margin-bottom:4rem}
.ba-mobile{position:relative}
.ba-scroll{display:flex;gap:1rem;overflow-x:auto;padding:1rem 2.5rem}
.ba-card{background:#fff;border-radius:1rem;padding:1rem;flex-shrink:0;width:18rem}
.ba-img-wrap{position:relative;margin-bottom:1rem;aspect-ratio:1;overflow:hidden;border-radius:.75rem}
.ba-img-wrap img{width:100%;height:100%;object-fit:cover}
.ba-labels{position:absolute;bottom:.5rem;left:.5rem;right:.5rem;display:flex;justify-content:space-between}
.ba-label{font-size:.75rem;color:#fff;padding:.25rem .5rem;border-radius:9999px}
.ba-label-before{background:hsl(var(--secondary))}
.ba-label-after{background:hsl(var(--primary))}
.ba-card .name{font-weight:700;color:hsl(var(--foreground));text-align:center}
.ba-card .result{color:hsl(var(--primary));font-weight:600;text-align:center}
.ba-desktop{display:none}
.ba-desktop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
/* Instagram */
.insta-section{margin-bottom:4rem;position:relative}
.insta-mobile{display:flex;flex-direction:column;gap:.75rem;align-items:center}
.insta-mobile img{border-radius:.5rem;width:100%;height:auto;object-fit:contain}
.insta-desktop{display:none}
.insta-scroll{display:flex;gap:1rem;overflow-x:auto}
.insta-scroll img{border-radius:.75rem;max-height:8rem;width:auto;object-fit:contain;flex-shrink:0}
/* Written */
.written-carousel{overflow:hidden;padding:1rem 0;position:relative}
.written-track{display:flex;gap:1.5rem}
.written-card{flex-shrink:0;width:18rem;background:#fff;border-radius:1rem;padding:1.5rem}
.written-stars{display:flex;gap:.25rem;margin-bottom:.75rem}
.written-card .quote-icon{width:2rem;height:2rem;color:hsl(var(--primary)/.2);margin-bottom:.5rem}
.written-card .text{color:hsl(var(--foreground));font-size:.875rem;margin-bottom:1rem;font-style:italic}
.written-card .author{font-weight:700;color:hsl(var(--foreground))}
/* Video Modal */
.video-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:100;display:none;align-items:center;justify-content:center}
.video-modal-overlay.active{display:flex}
.video-modal{position:relative;max-width:400px;width:90vw;aspect-ratio:9/16;max-height:90vh;background:#000;border-radius:1rem;overflow:hidden}
.video-modal video{width:100%;height:100%;object-fit:cover}
.video-modal-close{position:absolute;right:.5rem;top:.5rem;z-index:50;background:rgba(0,0,0,.5);border-radius:9999px;padding:.5rem;color:#fff;cursor:pointer;border:none;transition:background .2s}
.video-modal-close:hover{background:rgba(0,0,0,.7)}

/* ═══ M09 PricingSection ═══ */
.pricing-section{padding:5rem 0;background:#fff7ed;position:relative;overflow:hidden}
.pricing-grid{display:grid;grid-template-columns:1fr;gap:1.5rem;max-width:72rem;margin:0 auto}
.pricing-card{position:relative;border-radius:1.5rem;padding:1.5rem;background:#fff;border:1px solid hsl(var(--muted))}
.pricing-card.popular{background:hsl(var(--primary));border:2px solid hsl(var(--primary));box-shadow:0 0 0 4px hsl(var(--primary)/.2)}
.pricing-card.best-value{background:#fff;border:2px solid hsl(var(--secondary));box-shadow:0 0 0 4px hsl(var(--secondary)/.2)}
.pricing-badge{position:absolute;top:-1rem;left:50%;transform:translateX(-50%);font-size:.75rem;font-weight:700;padding:.5rem 1rem;border-radius:9999px;display:flex;align-items:center;gap:.375rem;white-space:nowrap}
.pricing-badge-popular{background:#facc15;color:hsl(var(--foreground))}
.pricing-badge-best{background:hsl(var(--secondary));color:#fff}
.pricing-img{display:flex;justify-content:center;margin-bottom:1.5rem;padding-top:1rem}
.pricing-img img{height:12rem;width:auto;object-fit:contain}
.pricing-info{text-align:center;margin-bottom:1rem}
.pricing-info h3{font-size:1.25rem;font-weight:700;margin-bottom:.25rem}
.pricing-info .caps{font-size:.875rem}
.pricing-prices{text-align:center;margin-bottom:1rem}
.pricing-original{font-size:.875rem;text-decoration:line-through}
.pricing-discount{font-weight:700;font-size:.875rem;padding:.125rem .5rem;border-radius:.25rem}
.pricing-main{font-size:2.25rem;font-weight:700}
.pricing-installment{font-size:.875rem;margin-top:.25rem}
.pricing-perpot{border-radius:.75rem;padding:.75rem;margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;border:1px solid hsl(var(--muted))}
.pricing-perpot span:first-child{font-size:.875rem}
.pricing-perpot span:last-child{font-weight:700}
.pricing-benefits{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem}
.pricing-benefit{display:flex;align-items:center;gap:.5rem;font-size:.875rem}
.pricing-cta{display:block;width:100%;text-align:center;font-size:1.125rem;font-weight:700;padding:.75rem 1.5rem;border-radius:9999px}
.pricing-delivery{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:1rem;font-size:.75rem}
/* Popular card colors */
.pricing-card.popular h3,.pricing-card.popular .pricing-main{color:#fff}
.pricing-card.popular .caps,.pricing-card.popular .pricing-installment{color:rgba(255,255,255,.8)}
.pricing-card.popular .pricing-original{color:rgba(255,255,255,.6)}
.pricing-card.popular .pricing-discount{color:#fff;background:rgba(255,255,255,.2)}
.pricing-card.popular .pricing-perpot{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.2)}
.pricing-card.popular .pricing-perpot span:first-child{color:rgba(255,255,255,.8)}
.pricing-card.popular .pricing-perpot span:last-child{color:#fff}
.pricing-card.popular .pricing-benefit{color:#fff}
.pricing-card.popular .pricing-delivery{color:rgba(255,255,255,.7)}
.pricing-card.popular .pricing-cta{background:#fff;color:hsl(var(--primary))}
.pricing-card.popular .pricing-cta:hover{background:rgba(255,255,255,.9)}
.pricing-card:not(.popular) .pricing-discount{color:hsl(var(--secondary))}
.pricing-card:not(.popular) .pricing-cta{background:hsl(var(--primary));color:#fff}
.pricing-card:not(.popular) .pricing-cta:hover{background:hsl(var(--primary-dark))}
.pricing-card.best-value .pricing-perpot{background:hsl(var(--secondary)/.1);border-color:hsl(var(--secondary)/.3)}
.pricing-card.best-value .pricing-perpot span:last-child{color:hsl(var(--secondary))}

/* ═══ M10 HowToUseSection ═══ */
.howtouse-section{padding:5rem 0;background-image:var(--gradient-subtle);position:relative;overflow:hidden}
.howtouse-grid{display:grid;grid-template-columns:1fr;gap:3rem;align-items:center;max-width:64rem;margin:0 auto}
.howtouse-video-wrap{position:relative;display:flex;justify-content:center}
.howtouse-video{width:16rem;height:16rem;border-radius:9999px;overflow:hidden}
.howtouse-video video{width:100%;height:100%;object-fit:cover}
.howtouse-circle-1{position:absolute;top:-2rem;left:50%;transform:translateX(-50%);width:4rem;height:4rem;border-radius:9999px;background:#fff2e5}
.howtouse-circle-2{position:absolute;top:33%;left:-1.5rem;width:6rem;height:6rem;background:hsl(var(--primary)/.15);border-radius:9999px;z-index:-1}
.howtouse-circle-3{position:absolute;bottom:25%;right:-2rem;width:8rem;height:8rem;background:hsl(var(--primary)/.1);border-radius:9999px;z-index:-1}
.howtouse-steps{display:flex;flex-direction:column;gap:2rem}
.howtouse-step{display:flex;align-items:flex-start;gap:1rem}
.howtouse-step-icon{position:relative;flex-shrink:0}
.howtouse-step-circle{width:4rem;height:4rem;border-radius:9999px;display:flex;align-items:center;justify-content:center;background:hsl(var(--secondary));color:#fff}
.howtouse-step-num{position:absolute;top:-.25rem;right:-.25rem;width:1.5rem;height:1.5rem;border-radius:9999px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.75rem;background:#fff;color:hsl(var(--secondary))}
.howtouse-step h3{font-size:1.25rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.25rem}
.howtouse-step p{color:hsl(var(--muted-fg))}

/* ═══ M11 FAQSection ═══ */
.faq-section{padding:5rem 0;background:#fff;position:relative;overflow:hidden}
.faq-deco{position:absolute;top:0;right:0;width:18rem;height:18rem;background:hsl(var(--primary-light));border-radius:9999px;transform:translate(50%,-50%);opacity:.5}
.faq-list{max-width:48rem;margin:0 auto;display:flex;flex-direction:column;gap:1rem}
.faq-item{background:hsl(var(--muted)/.5);border-radius:.75rem;overflow:hidden}
.faq-question{width:100%;display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;font-weight:600;color:hsl(var(--foreground));font-size:1rem;cursor:pointer;text-align:left;border:none;background:none;font-family:inherit;transition:color .2s}
.faq-question:hover{color:hsl(var(--primary))}
.faq-question .chevron{transition:transform .2s;flex-shrink:0;margin-left:1rem}
.faq-question.open .chevron{transform:rotate(180deg)}
.faq-answer{max-height:0;overflow:hidden;transition:max-height .3s ease}
.faq-answer.open{max-height:300px}
.faq-answer p{padding:0 1.5rem 1.25rem;color:hsl(var(--muted-fg))}

/* ═══ M12 Footer ═══ */
.footer{background:#1a3e01;color:#fff;position:relative;overflow:hidden}
.footer-wave{position:absolute;top:-1px;left:0;width:100%;height:80px}
.footer-inner{padding:4rem 0 1.5rem}
.footer-mobile{display:block}
.footer-desktop{display:none}
.footer-logo{height:3.5rem;margin:0 auto 1.5rem}
.footer-links-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;font-size:.875rem}
.footer-links-grid h4{font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem}
.footer-links-grid ul{list-style:none;display:flex;flex-direction:column;gap:.25rem}
.footer-links-grid a{color:rgba(255,255,255,.7);font-size:.75rem;transition:color .2s}
.footer-links-grid a:hover{color:hsl(var(--secondary))}
.footer-contact{text-align:center;margin-bottom:1rem;font-size:.75rem}
.footer-contact a{color:rgba(255,255,255,.7);transition:color .2s;display:inline-flex;align-items:center;gap:.25rem}
.footer-contact a:hover{color:hsl(var(--secondary))}
.footer-social{display:flex;justify-content:center;gap:.75rem;margin-bottom:1rem}
.footer-social-icon{width:2.25rem;height:2.25rem;background:rgba(255,255,255,.1);border-radius:9999px;display:flex;align-items:center;justify-content:center;color:#fff;transition:background .2s}
.footer-social-icon:hover{background:hsl(var(--secondary))}
.footer-payment{border-top:1px solid rgba(255,255,255,.1);padding-top:1rem;margin-bottom:1rem}
.footer-payment img{height:1.5rem;margin:0 auto .75rem}
.footer-payment-badges{display:flex;justify-content:center;gap:1rem;font-size:.75rem;color:rgba(255,255,255,.7)}
.footer-warning{border-top:1px solid rgba(255,255,255,.1);padding-top:1rem;margin-bottom:1rem}
.footer-warning p{color:rgba(255,255,255,.4);font-size:10px;text-align:center;line-height:1.6}
.footer-copyright{text-align:center;border-top:1px solid rgba(255,255,255,.1);padding-top:1rem}
.footer-copyright p{color:rgba(255,255,255,.5);font-size:10px}
/* Desktop footer */
.footer-desktop-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-bottom:2rem}
.footer-desktop-grid h4{font-weight:700;font-size:.875rem;margin-bottom:.75rem}
.footer-desktop-grid ul{list-style:none;display:flex;flex-direction:column;gap:.375rem}
.footer-desktop-grid a{color:rgba(255,255,255,.7);font-size:.875rem;transition:color .2s}
.footer-desktop-grid a:hover{color:hsl(var(--secondary))}
.footer-desktop-brand p{color:rgba(255,255,255,.7);font-size:.875rem;margin-bottom:1rem}
.footer-desktop-brand img{height:2rem;margin-bottom:.75rem}
.footer-desktop-contact li{display:flex;align-items:center;gap:.5rem;color:rgba(255,255,255,.7);font-size:.875rem}

/* ═══ M13 StickyFooter ═══ */
.sticky-footer{position:fixed;bottom:0;left:0;right:0;z-index:50;background:#fff;border-top:1px solid hsl(var(--border));box-shadow:0 -4px 20px rgba(0,0,0,.1);transform:translateY(100%);opacity:0;transition:transform .3s,opacity .3s;will-change:transform,opacity;contain:layout style}
.sticky-footer.visible{transform:translateY(0);opacity:1}
.sticky-inner{display:flex;align-items:center;justify-content:space-between;gap:.5rem;max-width:56rem;margin:0 auto;padding:.75rem 1rem}
.sticky-product{display:none}
.sticky-selector{position:relative;flex:1;min-width:0}
.sticky-selector-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:.25rem;padding:.5rem .75rem;background:hsl(var(--muted));border-radius:.5rem;font-size:.75rem;font-weight:500;color:hsl(var(--foreground));border:none;cursor:pointer;transition:background .2s}
.sticky-selector-btn:hover{background:hsl(var(--muted)/.8)}
.sticky-selector-btn .chevron{transition:transform .2s}
.sticky-selector-btn .chevron.open{transform:rotate(180deg)}
.sticky-dropdown{position:absolute;bottom:100%;margin-bottom:.5rem;left:0;background:#fff;border-radius:.75rem;box-shadow:0 10px 40px rgba(0,0,0,.15);border:1px solid hsl(var(--muted));overflow:hidden;z-index:50;width:280px;display:none}
.sticky-dropdown.open{display:block}
.sticky-dropdown-item{width:100%;display:flex;align-items:center;justify-content:space-between;padding:.625rem .75rem;font-size:.875rem;border:none;background:none;cursor:pointer;transition:background .2s;text-align:left}
.sticky-dropdown-item:hover{background:hsl(var(--muted)/.5)}
.sticky-dropdown-item.selected{background:hsl(var(--primary)/.1)}
.sticky-dropdown-item .name{font-weight:600;font-size:.75rem}
.sticky-dropdown-item .name.selected-text{color:hsl(var(--primary))}
.sticky-dropdown-item .badge{font-size:9px;background:hsl(var(--secondary)/.1);color:hsl(var(--secondary));padding:.125rem .25rem;border-radius:.25rem;white-space:nowrap}
.sticky-dropdown-item .sub{font-size:10px;color:hsl(var(--muted-fg))}
.sticky-dropdown-item .price{font-weight:700;font-size:.75rem}
.sticky-dropdown-item .price.selected-text{color:hsl(var(--primary))}
.sticky-dropdown-item .orig{font-size:10px;color:hsl(var(--muted-fg));text-decoration:line-through}
.sticky-price{display:none;text-align:right;flex-shrink:0}
.sticky-price-row{display:flex;align-items:center;gap:.375rem;justify-content:flex-end}
.sticky-price .orig{font-size:10px;color:hsl(var(--muted-fg));text-decoration:line-through;white-space:nowrap}
.sticky-price .disc{font-size:9px;background:hsl(var(--secondary));color:#fff;padding:.125rem .25rem;border-radius:9999px;font-weight:600}
.sticky-price .main{font-size:1rem;font-weight:700;color:hsl(var(--primary));white-space:nowrap}
.sticky-buy{background:hsl(var(--primary));color:#fff;font-weight:700;padding:.75rem 1rem;border-radius:9999px;font-size:.75rem;white-space:nowrap;display:inline-flex;align-items:center;gap:.375rem;flex-shrink:0;text-decoration:none;transition:background .2s}
.sticky-buy:hover{background:hsl(var(--primary-dark))}
.sticky-buy .mobile-price{display:inline}
.sticky-buy .desktop-text{display:none}

/* ═══ M14 WhatsAppButton ═══ */
.whatsapp-btn{position:fixed;bottom:6rem;right:1rem;z-index:50;width:3.5rem;height:3.5rem;background:#25D366;border-radius:9999px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(0,0,0,.15);transition:transform .2s;color:#fff}
.whatsapp-btn:hover{transform:scale(1.1)}

/* ═══ RESPONSIVE ═══ */
@media(min-width:640px){
  .sticky-buy .mobile-price{display:none}
  .sticky-buy .desktop-text{display:inline}
  .sticky-buy{font-size:.875rem;padding:.75rem 1.25rem}
  .sticky-price{display:block}
  .sticky-selector{flex:none;width:150px}
  .sticky-product-tablet{display:block!important;flex-shrink:0}
  .science-capsule.mobile-only{display:none}
}
@media(min-width:768px){
  .container{padding:0 1.5rem}
  .hero-grid{grid-template-columns:1fr 1fr;gap:3rem}
  .hero h1{font-size:3rem}
  .hero-content{padding:7rem 0 10rem}
  .hero-product{width:420px}
  .hero .wave-bottom{height:136px}
  .hero-capsule.mobile-only{display:none}
  .hero-capsule.desktop-only{display:block!important}
  .section-title{font-size:2.25rem}
  .why-grid{grid-template-columns:1fr 1fr}
  .why-accordion-mobile{display:none}
  .why-cards-desktop{display:flex;flex-direction:column;gap:1.5rem}
  .why-card{padding:1.5rem}
  .why-icon-box{width:3rem;height:3rem}
  .why-card h3{font-size:1.25rem}
  .why-celebrity{max-height:750px}
  .benefits-grid{display:none}
  .benefits-expand{display:none}
  .benefits-desktop{display:grid!important;grid-template-columns:repeat(2,1fr);gap:1.5rem}
  .benefit-card-desktop{background:rgba(255,255,255,.5);backdrop-filter:blur(12px);border-radius:1rem;padding:1.5rem;border:1px solid rgba(255,255,255,.5);transition:all .3s}
  .benefit-card-desktop:hover{background:rgba(255,255,255,.6);transform:translateY(-.5rem)}
  .benefit-icon-desktop{width:4rem;height:4rem;background:hsl(var(--secondary));border-radius:1rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;color:#fff}
  .benefit-card-desktop h3{font-size:1.25rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.5rem}
  .benefit-card-desktop p{color:hsl(var(--muted-fg))}
  .whoisit-grid{grid-template-columns:1fr 1fr}
  .whoisit-wave{height:136px}
  .science-section{padding:4rem 0 8rem}
  .science-mobile-list{display:none}
  .science-desktop-grid{display:grid!important;grid-template-columns:repeat(3,1fr);gap:1.5rem;max-width:56rem;margin:0 auto 4rem}
  .science-ingredient-desktop{background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border-radius:1rem;padding:1.5rem;border:1px solid rgba(255,255,255,.2);text-align:center;transition:all .3s}
  .science-ingredient-desktop:hover{background:rgba(255,255,255,.2)}
  .science-ingredient-desktop .icon-wrap{width:5rem;height:5rem;background:#fff;border-radius:1rem;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;color:hsl(var(--secondary));transition:transform .3s}
  .science-ingredient-desktop:hover .icon-wrap{transform:scale(1.1)}
  .science-ingredient-desktop h3{font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:.5rem}
  .science-ingredient-desktop p{color:rgba(255,255,255,.7);font-size:.875rem}
  .science-study{padding:2.5rem;border-radius:1.5rem}
  .science-study h3{font-size:1.875rem}
  .science-stat .val{font-size:1.875rem}
  .science-stat .lbl{font-size:.75rem}
  .science-wave{height:136px}
  .timeline-mobile{display:none}
  .timeline-desktop{display:block!important}
  .video-item{width:14rem}
  .video-item video{height:24rem}
  .ba-mobile{display:none}
  .ba-desktop{display:block!important}
  .insta-mobile{display:none!important}
  .insta-desktop{display:block!important}
  .written-card{width:20rem}
  .pricing-grid{grid-template-columns:repeat(3,1fr)}
  .pricing-card.best-value{transform:scale(1.05);margin:-.5rem 0}
  .howtouse-grid{grid-template-columns:1fr 1fr}
  .howtouse-video{width:20rem;height:20rem}
  .footer-mobile{display:none!important}
  .footer-desktop{display:block!important}
  .footer-inner{padding:6rem 0 2rem}
  .sticky-product{display:block;flex-shrink:0}
  .sticky-selector{flex:none;width:180px}
  .sticky-price .main{font-size:1.125rem}
}
@media(min-width:1024px){
  .hero h1{font-size:3.75rem}
  .hero-product{width:480px}
  .section-title{font-size:3rem}
  .benefits-desktop{grid-template-columns:repeat(3,1fr)!important}
  .whoisit-section .container{padding-bottom:3rem}
}
</style>

{% if section.settings.standalone_mode %}
</head>
<body>
{% endif %}

{% if section.settings.show_analytics %}
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id={{ section.settings.fb_pixel_id }}&ev=PageView&noscript=1"/></noscript>
{% endif %}

<main class="overflow-hidden">

<!-- ═══ CHECKPOINT [M01] SubHeroSection ✓ — Barra scrolling benefícios ═══ -->
<section class="subhero">
<div class="animate-scroll-subhero subhero-track" id="subhero-track-{{ section.id }}">
  {%- assign subhero_items = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'subhero_item' -%}
      {%- capture subhero_items -%}{{ subhero_items }}<div class="subhero-item" {{ block.shopify_attributes }}><span>{{ block.settings.text }}</span><span class="subhero-dot">•</span></div>{%- endcapture -%}
    {%- endif -%}
  {%- endfor -%}
  {{ subhero_items }}{{ subhero_items }}{{ subhero_items }}{{ subhero_items }}
</div>
</section>

<!-- ═══ CHECKPOINT [M02] HeroSection ✓ — Hero principal com produto e CTA ═══ -->
<section id="inicio" class="hero">
<div style="position:absolute;inset:0;overflow:hidden">
<div class="geo-circle" style="width:24rem;height:24rem;background:rgba(255,255,255,.1);top:-5rem;right:-5rem"></div>
<div class="geo-circle" style="width:16rem;height:16rem;background:hsl(var(--primary)/.2);top:33%;left:-4rem"></div>
<div class="geo-circle" style="width:12rem;height:12rem;background:rgba(255,255,255,.1);bottom:5rem;right:25%"></div>
<div class="geo-circle" style="width:8rem;height:8rem;background:rgba(255,255,255,.2);top:50%;right:2.5rem"></div>
</div>
<svg class="wave-bottom" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none"><path d="M0 70C300 120 450 0 800 70C1150 140 1300 40 1440 70V120H0Z" fill="white"/></svg>
<div class="container hero-content">
<div class="hero-grid">
<div style="text-align:center;max-width:350px;margin:0 auto" class="reveal-left" id="hero-text-{{ section.id }}">
<div class="hero-badge">
