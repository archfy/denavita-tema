<script>
/* ═══ CHECKPOINT [M_ALL] JavaScript — IIFE escopada por section.id ═══ */
(function(){
  var SEC = '{{ section.id }}';
  var SEC_ = SEC.replace(/-/g,'_');

  /* ═══ MÓDULO: CONFIG ═══
     ID: M_CONFIG
     ORIGEM: Schema settings injetados via Liquid
     DEPENDE DE: (nenhum)
     RECEBE: Liquid template variables
     EXPÕE: CONFIG object
     ESTADO: (nenhum)
     SCHEMA BINDINGS: ga4_id, fb_pixel_id, ga4_page_title, show_analytics
  ═══ */
  var CONFIG = {
    sectionId: SEC,
    showAnalytics: {{ section.settings.show_analytics | json }},
    ga4Id: '{{ section.settings.ga4_id }}',
    ga4PageTitle: '{{ section.settings.ga4_page_title }}'
  };

  /* ═══ MÓDULO: StickyData ═══
     ID: M_STICKY_DATA
     ORIGEM: pricing_kit blocks → sticky variants
     DEPENDE DE: M_CONFIG
     RECEBE: block data via Liquid
     EXPÕE: stickyVariants, selectedVariant
     ESTADO: selectedVariant
     SCHEMA BINDINGS: pricing_kit blocks
  ═══ */
  var stickyVariants = [
    {%- assign first_kit = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'pricing_kit' -%}
        {%- unless first_kit -%},{%- endunless -%}
        {
          id: {{ forloop.index }},
          name: {{ block.settings.name | json }},
          short: {{ block.settings.short_name | json }},
          sub: {{ block.settings.sticky_sub | json }},
          price: {{ block.settings.price | times: 1.0 }},
          orig: {{ block.settings.original_price | times: 1.0 }},
          badge: {{ block.settings.sticky_badge | json }},
          ship: {{ block.settings.free_shipping | json }},
          url: {{ block.settings.buy_url | json }}
        }
        {%- assign first_kit = false -%}
      {%- endif -%}
    {%- endfor -%}
  ];

  var selectedVariant = stickyVariants.length > 1 ? stickyVariants[1] : stickyVariants[0];

  /* ═══ MÓDULO: Helpers ═══
     ID: M_HELPERS
     ORIGEM: Utility functions
     DEPENDE DE: M_CONFIG
     RECEBE: (nenhum)
     EXPÕE: fmt(), $(), $$()
     ESTADO: (nenhum)
     SCHEMA BINDINGS: (nenhum)
  ═══ */
  function fmt(v){return Number(v).toFixed(2).replace('.',',');}
  function $(id){return document.getElementById(id+'-'+SEC)||document.getElementById(id);}
  function $$(sel){
    var root=document.getElementById('shopify-section-'+SEC);
    return root?root.querySelectorAll(sel):document.querySelectorAll(sel);
  }

  /* ═══ MÓDULO: InteractionHandlers ═══
     ID: M_INTERACT
     ORIGEM: React state + event handlers de todos os componentes
     DEPENDE DE: M_HELPERS, M_STICKY_DATA
     RECEBE: User events (click, scroll)
     EXPÕE: All handler functions (globally scoped for onclick)
     ESTADO: benefitsExpanded, stickyDropdownOpen, selectedVariant
     SCHEMA BINDINGS: (nenhum — uses DOM)
  ═══ */
  var benefitsExpanded = false;
  var stickyDropdownOpen = false;

  function toggleWhyAccordion(btn){
    var content=btn.nextElementSibling;
    var chevron=btn.querySelector('.chevron');
    var isOpen=content.classList.contains('open');
    var root=document.getElementById('shopify-section-'+SEC);
    if(root){
      root.querySelectorAll('.why-accordion-content').forEach(function(c){c.classList.remove('open');});
      root.querySelectorAll('.why-accordion-header .chevron').forEach(function(c){c.style.transform='';});
