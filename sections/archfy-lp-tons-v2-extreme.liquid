  <div class="pricing-benefit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if block.settings.is_popular %}#fff{% else %}hsl(var(--primary)){% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> 100% Natural</div>
  <div class="pricing-benefit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if block.settings.is_popular %}#fff{% else %}hsl(var(--primary)){% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Satisfação Garantida</div>
  <div class="pricing-benefit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{% if block.settings.is_popular %}#fff{% else %}hsl(var(--secondary)){% endif %}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg> <span style="font-weight:500;color:{% if block.settings.is_popular %}#fff{% else %}hsl(var(--secondary)){% endif %}">Cashback de R$ {{ block.settings.cashback }}</span></div>
