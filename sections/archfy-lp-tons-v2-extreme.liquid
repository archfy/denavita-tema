<section id="transformacao" class="timeline-section">
<div class="bg-dots"></div>
<div class="container" style="position:relative;z-index:10">
<div class="text-center reveal" style="margin-bottom:3rem">
<span class="section-tag" style="background:hsl(var(--primary-light));color:hsl(var(--primary))">{{ section.settings.timeline_tag }}</span>
<h2 class="section-title">{{ section.settings.timeline_heading }}</h2>
<p class="section-subtitle">{{ section.settings.timeline_subtitle }}</p>
</div>
<!-- Mobile carousel -->
<div class="timeline-mobile" id="timeline-mobile-{{ section.id }}">
<div class="timeline-arrows">
<button class="btn-icon" onclick="timelineScroll_{{ section.id | replace: '-','_' }}(-280)" aria-label="Anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
<button class="btn-icon" onclick="timelineScroll_{{ section.id | replace: '-','_' }}(280)" aria-label="Próximo"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
</div>
<div class="timeline-scroll scrollbar-hide" id="timeline-scroll-{{ section.id }}">
{%- assign step_index = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'timeline_step' -%}
  {%- assign step_index = step_index | plus: 1 -%}
  <div class="timeline-card" {{ block.shopify_attributes }}><div class="timeline-card-inner"><div class="timeline-card-header"><div class="timeline-card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ block.settings.icon_svg }}</svg></div><span class="timeline-card-step">ETAPA {{ step_index }}</span></div><span class="timeline-period">{{ block.settings.period }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div></div>
  {%- endif -%}
{%- endfor -%}
</div>
</div>
<!-- Desktop grid -->
<div class="timeline-desktop" style="display:none" id="timeline-desktop-{{ section.id }}">
<div class="timeline-desktop-grid">
