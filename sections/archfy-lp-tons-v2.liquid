  buildHeroCarousel('heroMobileTrack','heroMobileDots',heroImages);
  startHeroAutoplay();
  updateHeroPrice();
  buildTreatments();
  buildDeliveryInfo();
  buildVideoThumbnails();
  updateFloatingCTA();
  /* Non-critical: below-fold content deferred */
  var deferred=function(){
    buildProblems();
    buildBenefits();
    buildIngredients();
    buildScienceIngredients();
    buildClinicalStages();
    buildTestimonials();
    buildComparison();
    buildFAQ();
    /* Auto-advance carousels - only after content is built */
    setInterval(function(){problemsNext();},3000);
    setInterval(function(){testNext();},4000);
  };
  if('requestIdleCallback' in window){requestIdleCallback(deferred);}
  else{setTimeout(deferred,50);}
})();
</script>

