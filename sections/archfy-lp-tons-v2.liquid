.faq-list{display:flex;flex-direction:column;gap:.75rem;}
.faq-item{background:hsl(var(--card));border-radius:.75rem;padding:0 1.25rem;box-shadow:var(--shadow-soft);border:1px solid hsl(var(--border));}
.faq-trigger{width:100%;display:flex;align-items:center;justify-content:space-between;padding:1rem 0;text-align:left;font-weight:600;color:hsl(var(--foreground));font-size:13px;font-family:'Plus Jakarta Sans',sans-serif;}
.faq-trigger .ic{width:1rem;height:1rem;color:hsl(var(--muted-foreground));transition:transform .3s;flex-shrink:0;margin-left:.5rem;}
.faq-trigger.open .ic{transform:rotate(180deg);}
.faq-content{overflow:hidden;max-height:0;transition:max-height .3s ease-out;}
.faq-content.open{max-height:500px;transition:max-height .3s ease-in;}
.faq-content-inner{padding-bottom:1rem;font-size:13px;color:hsl(var(--muted-foreground));line-height:1.6;}
@media(min-width:768px){
  .faq{padding:4rem 0;}
  .faq-trigger{font-size:1rem;}
  .faq-content-inner{font-size:1rem;}
}

.warning{padding:2rem 0;}
.warning .container{max-width:56rem;}
.warning-card{background:hsl(var(--card));border:1px solid hsl(var(--accent)/.2);border-radius:1rem;padding:1.5rem;}
.warning-inner{display:flex;align-items:flex-start;gap:1rem;}
.warning-icon{width:3rem;height:3rem;border-radius:50%;background:hsl(var(--accent)/.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.warning-icon .ic{width:1.5rem;height:1.5rem;color:hsl(var(--accent));}
.warning-card h3{font-weight:700;color:hsl(var(--foreground));font-size:1.125rem;margin-bottom:.75rem;}
.warning-card .main-text{color:hsl(var(--muted-foreground));font-size:.875rem;line-height:1.5;margin-bottom:.75rem;}
.warning-card .sub-text{color:hsl(var(--muted-foreground));font-size:.75rem;line-height:1.5;}

.footer{padding:3rem 0;background:hsl(var(--primary));}
.footer .container{max-width:56rem;}
.footer-logo{display:flex;justify-content:center;margin-bottom:1.5rem;}
.footer-logo img{height:2.5rem;filter:brightness(0) invert(1);}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;margin-bottom:2rem;font-size:.875rem;}
.footer-links a{color:hsl(var(--primary-foreground)/.7);transition:color .3s;}
.footer-links a:hover{color:hsl(var(--primary-foreground));}
.footer-copyright{color:hsl(var(--primary-foreground)/.7);font-size:.875rem;text-align:center;margin-bottom:1rem;}
.footer-disclaimer{font-size:.75rem;color:hsl(var(--primary-foreground)/.5);text-align:center;max-width:42rem;margin:0 auto;line-height:1.5;}

.floating-cta{position:fixed;bottom:0;left:0;right:0;padding:.5rem;background:hsl(var(--background)/.95);backdrop-filter:blur(12px);border-top:1px solid hsl(var(--border));box-shadow:0 -4px 12px rgba(0,0,0,.1);z-index:50;display:none;}
.floating-cta.visible{display:block;}
.floating-cta-inner{display:flex;align-items:center;gap:.5rem;}
.floating-cta-selector{position:relative;flex:1;}
.floating-cta-trigger{width:100%;display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.5rem .75rem;background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:.5rem;text-align:left;}
.floating-cta-trigger-label{font-size:13px;font-weight:600;color:hsl(var(--foreground));}
.floating-cta-trigger-price{font-size:12px;font-weight:700;color:hsl(var(--primary));}
.floating-cta-trigger .ic{width:1rem;height:1rem;color:hsl(var(--muted-foreground));transition:transform .3s;}
.floating-cta-trigger .ic.rotated{transform:rotate(180deg);}
.floating-cta-dropdown{position:absolute;bottom:100%;left:0;right:0;margin-bottom:.25rem;background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:.5rem;box-shadow:0 -4px 12px rgba(0,0,0,.1);overflow:hidden;display:none;}
.floating-cta-dropdown.open{display:block;}
.floating-cta-option{width:100%;display:flex;align-items:center;justify-content:space-between;padding:.5rem .75rem;text-align:left;transition:background .3s;}
.floating-cta-option.selected{background:hsl(var(--primary)/.1);}
.floating-cta-option:hover{background:hsl(var(--muted));}
.floating-cta-option-label{font-size:13px;font-weight:600;color:hsl(var(--foreground));display:flex;align-items:center;gap:.25rem;}
.floating-cta-option-top{font-size:9px;background:hsl(var(--primary));color:hsl(var(--primary-foreground));padding:2px 6px;border-radius:9999px;}
.floating-cta-option-price{font-size:12px;font-weight:700;color:hsl(var(--primary));}
@media(min-width:768px){.floating-cta{display:none!important;}}

/* Section common text styles */
.section-subtitle{color:hsl(var(--accent));font-weight:600;font-size:.75rem;text-align:center;margin-bottom:.5rem;}
.section-subtitle.green{color:hsl(var(--primary));}
.section-title{font-size:21px;font-weight:700;text-align:center;color:hsl(var(--foreground));margin-bottom:.75rem;}
.section-desc{font-size:14px;color:hsl(var(--muted-foreground));text-align:center;margin-bottom:2.5rem;}
@media(min-width:768px){
  .section-subtitle{font-size:.875rem;}
  .section-title{font-size:1.875rem;}
  .section-desc{font-size:1rem;}
}
/* Page bottom padding for FloatingCTA */
.page-wrap{min-height:100vh;padding-bottom:4rem;}
@media(min-width:768px){.page-wrap{padding-bottom:0;}}
/* Defer rendering of below-fold sections */
.problems,.benefits,.ingredients,.science,.clinical,.howto,.testimonials,.comparison,.final-cta,.faq,.warning,.footer{content-visibility:auto;contain-intrinsic-size:auto 600px;}
</style>
</head>
