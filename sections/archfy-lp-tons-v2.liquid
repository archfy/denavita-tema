/* Helpers */
function ic(id,w,h){return '<span class="ic" style="width:'+(w||'1rem')+';height:'+(h||'1rem')+'"><svg><use href="#'+id+'"/></svg></span>';}
function icFill(id,w,h){return '<span class="ic ic-fill" style="width:'+(w||'1rem')+';height:'+(h||'1rem')+'"><svg><use href="#'+id+'"/></svg></span>';}
function fmt(v){return v.toFixed(2).replace('.',',');}
function stars(n,w){var s='';for(var i=0;i<n;i++)s+=icFill('i-star',w||'.75rem',w||'.75rem');return s;}

var heroDesktopIndex=0, heroMobileIndex=0, heroAutoDesktop, heroAutoMobile;
var heroSelected='2units';

function buildHeroCarousel(target,dotsTarget,imgs){
  var t=document.getElementById(target);
  var d=document.getElementById(dotsTarget);
  t.innerHTML=imgs.map(function(img,i){return '<div class="hero-carousel-slide"><div class="hero-carousel-slide-inner"><img src="'+img.src+'" alt="'+img.alt+'"'+(i===0?' fetchpriority="high"':' loading="lazy"')+'/></div></div>';}).join('');
  d.innerHTML=imgs.map(function(_,i){return '<button class="hero-dot '+(i===0?'active':'inactive')+'" onclick="heroGoTo(\''+target+'\','+i+')"></button>';}).join('');
}
function heroGoTo(target,idx){
  var isDesktop=target==='heroDesktopTrack';
  if(isDesktop){heroDesktopIndex=idx;}else{heroMobileIndex=idx;}
  var t=document.getElementById(target);
  t.style.transform='translateX(-'+(idx*100)+'%)';
  var dotsId=isDesktop?'heroDesktopDots':'heroMobileDots';
  var dots=document.getElementById(dotsId).children;
  for(var i=0;i<dots.length;i++){dots[i].className='hero-dot '+(i===idx?'active':'inactive');}
}
function heroCarouselPrev(type){
  if(!heroImages.length)return;
  var idx=type==='desktop'?heroDesktopIndex:heroMobileIndex;
  var target=type==='desktop'?'heroDesktopTrack':'heroMobileTrack';
  idx=(idx-1+heroImages.length)%heroImages.length;
  heroGoTo(target,idx);
}
function heroCarouselNext(type){
  if(!heroImages.length)return;
  var idx=type==='desktop'?heroDesktopIndex:heroMobileIndex;
  var target=type==='desktop'?'heroDesktopTrack':'heroMobileTrack';
  idx=(idx+1)%heroImages.length;
  heroGoTo(target,idx);
}
function startHeroAutoplay(){
  if(!heroImages.length)return;
  heroAutoDesktop=setInterval(function(){heroCarouselNext('desktop');},4000);
