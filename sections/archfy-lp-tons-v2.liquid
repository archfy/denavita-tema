(function(){
  var banner=document.getElementById('scienceBanner');
  var bg=document.getElementById('scienceBannerBg');
  if(!banner||!bg)return;
  var reduceMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(reduceMotion)return;
  var elementTop=0,elementHeight=0,maxShift=0,raf=0;
  function measure(){var r=banner.getBoundingClientRect();elementTop=r.top+window.scrollY;elementHeight=r.height||banner.offsetHeight||0;maxShift=elementHeight*0.18;}
  function update(){raf=0;var rect=banner.getBoundingClientRect();var vh=window.innerHeight||0;if(rect.bottom<0||rect.top>vh)return;var distance=window.scrollY-elementTop;var translate=Math.max(-maxShift,Math.min(maxShift,distance*0.22));bg.style.transform='translate3d(0,'+translate+'px,0)';}
  function requestUpdate(){if(raf)return;raf=requestAnimationFrame(update);}
  function onResize(){measure();requestUpdate();}
  measure();update();
  window.addEventListener('scroll',requestUpdate,{passive:true});
  window.addEventListener('resize',onResize,{passive:true});
})();

