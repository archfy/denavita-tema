<!-- Analytics deferred to end of body for faster initial render -->

<style>

:root {
  --background: 0 0% 100%;
  --foreground: 150 10% 15%;
  --card: 0 0% 100%;
  --card-foreground: 150 10% 15%;
  --primary: 92 99% 35%;
  --primary-foreground: 0 0% 100%;
  --secondary: 92 40% 96%;
  --secondary-foreground: 92 10% 15%;
  --muted: 92 20% 96%;
  --muted-foreground: 92 10% 40%;
  --accent: 30 33% 65%;
  --accent-foreground: 0 0% 100%;
  --success: 92 99% 35%;
  --success-foreground: 0 0% 100%;
  --destructive: 0 84% 60%;
  --destructive-foreground: 0 0% 100%;
  --border: 92 15% 90%;
  --radius: 0.75rem;
  --gradient-primary: linear-gradient(135deg, hsl(92,99%,35%) 0%, hsl(92,80%,45%) 100%);
  --gradient-orange: linear-gradient(135deg, hsl(30,33%,65%) 0%, hsl(25,40%,55%) 100%);
  --gradient-cta: linear-gradient(135deg, hsl(92,99%,35%) 0%, hsl(92,80%,40%) 100%);
  --gradient-section-green: linear-gradient(180deg, hsl(92,30%,98%) 0%, hsl(92,25%,95%) 100%);
  --gradient-section-orange: linear-gradient(180deg, hsl(35,50%,98%) 0%, hsl(30,40%,95%) 100%);
  --shadow-soft: 0 2px 8px -2px hsl(152 20% 20% / 0.08);
  --shadow-card: 0 4px 20px -4px hsl(152 20% 20% / 0.12);
  --shadow-cta: 0 8px 24px -4px hsl(92 99% 35% / 0.35);
  --shadow-hover: 0 12px 32px -4px hsl(92 99% 35% / 0.45);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;border:0 solid hsl(var(--border));}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{overflow-x:hidden;background:hsl(var(--background));color:hsl(var(--foreground));font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;line-height:1.5;}
h1,h2,h3,h4,h5,h6{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;letter-spacing:-0.025em;line-height:1.2;}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}
button{cursor:pointer;font-family:inherit;background:none;border:none;padding:0;}
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 1rem;}
/* Icon base */
.ic{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
.ic svg{width:100%;height:100%;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;}
.ic-fill svg{fill:currentColor;}
/* Gradients */
.gradient-primary{background:var(--gradient-primary);}
.gradient-orange{background:var(--gradient-orange);}
.gradient-cta{background:var(--gradient-cta);}
.gradient-section-green{background:var(--gradient-section-green);}
.gradient-section-orange{background:var(--gradient-section-orange);}
/* Shadows */
.shadow-soft{box-shadow:var(--shadow-soft);}
.shadow-card{box-shadow:var(--shadow-card);}
/* Glows */
.glow-green{box-shadow:0 0 20px hsl(92 99% 35%/.3),0 0 40px hsl(92 99% 35%/.1);}
.glow-orange{box-shadow:0 0 20px hsl(30 33% 65%/.3),0 0 40px hsl(30 33% 65%/.1);}
/* Shimmer */
.shimmer{position:relative;overflow:hidden;}
.shimmer::after{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);animation:shimmer 2s infinite;}
/* Button base */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;white-space:nowrap;border-radius:9999px;font-weight:600;transition:all .3s;cursor:pointer;border:none;font-family:inherit;position:relative;overflow:hidden;}
.btn::after{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);animation:shimmer 2s infinite;}
.btn:hover{transform:scale(1.02);}
.btn:active{transform:scale(0.98);}
.btn-cta{background:var(--gradient-cta);color:hsl(var(--primary-foreground));box-shadow:var(--shadow-cta);font-size:1rem;height:3rem;padding:0 1.5rem;}
.btn-cta:hover{box-shadow:var(--shadow-hover);}
.btn-cta-sm{background:var(--gradient-cta);color:hsl(var(--primary-foreground));box-shadow:var(--shadow-cta);font-size:.8125rem;height:2.5rem;padding:0 1rem;}
.btn-cta-xl{background:var(--gradient-cta);color:hsl(var(--primary-foreground));box-shadow:var(--shadow-cta);font-size:1.25rem;height:4rem;padding:0 2.5rem;}

@keyframes marquee{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
@keyframes marquee33{0%{transform:translateX(0);}100%{transform:translateX(-33.33%);}}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
@keyframes slideUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
@keyframes pulseSoft{0%,100%{transform:scale(1);}50%{transform:scale(1.02);}}
@keyframes fadeInUp{from{opacity:0;transform:translateY(40px);}to{opacity:1;transform:translateY(0);}}
@keyframes fadeInLeft{from{opacity:0;transform:translateX(-40px);}to{opacity:1;transform:translateX(0);}}
@keyframes fadeInRight{from{opacity:0;transform:translateX(40px);}to{opacity:1;transform:translateX(0);}}
@keyframes scaleIn{from{opacity:0;transform:scale(.9);}to{opacity:1;transform:scale(1);}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
@keyframes glowPulse{0%,100%{box-shadow:0 0 20px hsl(92 99% 35%/.3),0 0 40px hsl(92 99% 35%/.1);}50%{box-shadow:0 0 30px hsl(92 99% 35%/.5),0 0 60px hsl(92 99% 35%/.2);}}
@keyframes shimmer{0%{left:-100%;}100%{left:100%;}}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.5;}}
.anim-fade-in-up{animation:fadeInUp .8s ease-out forwards;opacity:0;}
.anim-fade-in-left{animation:fadeInLeft .8s ease-out forwards;opacity:0;}
.anim-fade-in-right{animation:fadeInRight .8s ease-out forwards;opacity:0;}
.anim-float{animation:float 3s ease-in-out infinite;}
.anim-glow-pulse{animation:glowPulse 2s ease-in-out infinite;}
.anim-pulse{animation:pulse 2s ease-in-out infinite;}
.delay-100{animation-delay:.1s;}
.delay-200{animation-delay:.2s;}
.delay-300{animation-delay:.3s;}
.delay-400{animation-delay:.4s;}
.delay-500{animation-delay:.5s;}
.delay-600{animation-delay:.6s;}
.delay-700{animation-delay:.7s;}
.delay-800{animation-delay:.8s;}
.delay-900{animation-delay:.9s;}
.delay-1000{animation-delay:1s;}

.topbar{background:hsl(var(--accent));padding:.5rem 0;overflow:hidden;}
.topbar-track{display:flex;animation:marquee 10s linear infinite;white-space:nowrap;}
.topbar-item{display:flex;align-items:center;gap:.5rem;margin:0 2rem;color:hsl(var(--primary-foreground));}
.topbar-item .ic{width:1rem;height:1rem;}
.topbar-item span{font-size:.875rem;font-weight:500;}

.header{position:sticky;top:0;z-index:50;background:hsl(var(--background)/.95);backdrop-filter:blur(12px);border-bottom:1px solid hsl(var(--border));}
.header .container{display:flex;align-items:center;justify-content:space-between;height:3.5rem;}
.header-logo{height:2rem;}

.vts{padding:1rem 0;background:linear-gradient(180deg,hsl(var(--background)),hsl(var(--muted)/.3));}
.vts-mobile{overflow:hidden;}
.vts-mobile-track{display:flex;align-items:center;gap:.75rem;animation:marquee33 15s linear infinite;}
.vts-desktop{display:none;justify-content:center;align-items:center;gap:1rem;}
.vt-thumb{position:relative;flex-shrink:0;cursor:pointer;transition:transform .3s;}
.vt-thumb:hover{transform:scale(1.1);}
.vt-ring{position:relative;width:3.5rem;height:3.5rem;border-radius:50%;padding:2px;background:hsl(var(--primary));}
.vt-ring-inner{width:100%;height:100%;border-radius:50%;overflow:hidden;background:hsl(var(--muted-foreground)/.8);}
.vt-ring-inner video{width:100%;height:100%;object-fit:cover;}
.vt-play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
.vt-play-btn{width:1.5rem;height:1.5rem;background:hsl(var(--card)/.9);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .3s;}
.vt-thumb:hover .vt-play-btn{transform:scale(1.1);}
.vt-play-btn .ic{width:.75rem;height:.75rem;margin-left:2px;}
.vt-play-btn .ic svg{fill:hsl(var(--foreground));stroke:hsl(var(--foreground));}
/* Video Modal */
.video-modal-overlay{display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.8);align-items:center;justify-content:center;}
.video-modal-overlay.active{display:flex;}
.video-modal{background:#000;border-radius:1rem;overflow:hidden;width:90%;max-width:28rem;position:relative;display:flex;flex-direction:column;align-items:center;}
.video-modal-close{position:absolute;right:.75rem;top:.75rem;z-index:10;width:2rem;height:2rem;background:rgba(0,0,0,.5);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;transition:background .3s;}
.video-modal-close:hover{background:rgba(0,0,0,.7);}
.video-modal-close .ic{width:1.25rem;height:1.25rem;}
.video-modal-video{width:100%;aspect-ratio:9/16;background:#000;max-height:70vh;}
.video-modal-video video{width:100%;height:100%;object-fit:contain;}
.video-modal-cta{width:100%;background:hsl(var(--accent));padding:1rem;display:flex;align-items:center;justify-content:center;}
.video-modal-variants{width:100%;background:hsl(var(--accent));padding:.75rem;}
.video-modal-variants-title{color:hsl(var(--accent-foreground));font-weight:600;text-align:center;margin-bottom:.75rem;font-size:.875rem;}
.vm-variants-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.75rem;}
.vm-variant{position:relative;padding:.5rem;border-radius:.75rem;border:2px solid hsl(var(--border));text-align:center;transition:all .3s;background:hsl(var(--card));}
.vm-variant.selected{border-color:hsl(var(--primary));box-shadow:0 4px 12px rgba(0,0,0,.15);}
.vm-variant-best{position:absolute;top:-.5rem;left:50%;transform:translateX(-50%);background:#fbbf24;color:#78350f;font-size:7px;font-weight:700;padding:2px 6px;border-radius:9999px;white-space:nowrap;}
.vm-variant-check{position:absolute;top:-.25rem;right:-.25rem;width:1rem;height:1rem;background:hsl(var(--primary));border-radius:50%;display:none;align-items:center;justify-content:center;}
.vm-variant.selected .vm-variant-check{display:flex;}
.vm-variant-check .ic{width:.625rem;height:.625rem;color:hsl(var(--primary-foreground));}
.vm-variant-label{font-weight:700;color:hsl(var(--foreground));font-size:10px;line-height:1.2;}
.vm-variant-caps{font-size:9px;color:hsl(var(--muted-foreground));}
.vm-variant-price{font-size:.75rem;font-weight:700;color:hsl(var(--primary));margin-top:.25rem;}
.vm-variant-orig{font-size:8px;color:hsl(var(--muted-foreground));text-decoration:line-through;}
.vm-summary{display:flex;align-items:center;justify-content:space-between;gap:.5rem;background:hsl(var(--accent-foreground)/.1);border-radius:.75rem;padding:.5rem;}
.vm-summary-info{color:hsl(var(--accent-foreground));text-align:left;flex:1;}
.vm-summary-label{font-size:.75rem;font-weight:500;}
.vm-summary-price{font-size:.875rem;font-weight:700;}
.vm-summary-discount{font-size:10px;margin-left:.25rem;background:hsl(var(--destructive)/.2);color:hsl(var(--destructive));padding:2px 6px;border-radius:9999px;}

.hero{padding:1.5rem 0;background:hsl(var(--background));overflow-x:hidden;}
.hero-grid{display:grid;gap:2rem;align-items:start;max-width:350px;margin:0 auto;}
.hero-carousel-wrap{position:sticky;top:1rem;}
.hero-carousel{position:relative;}
.hero-carousel-viewport{overflow:hidden;border-radius:1.5rem;border:1px solid hsl(var(--border));}
.hero-carousel-track{display:flex;transition:transform .5s ease;will-change:transform;}
.hero-carousel-slide{flex:0 0 100%;min-width:0;}
.hero-carousel-slide-inner{aspect-ratio:3/4;background:hsl(var(--muted));display:flex;align-items:center;justify-content:center;overflow:hidden;}
.hero-carousel-slide-inner img{width:100%;height:100%;object-fit:cover;}
.hero-carousel-arrow{position:absolute;top:50%;transform:translateY(-50%);width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(var(--card)/.8);backdrop-filter:blur(8px);border:1px solid hsl(var(--border));display:flex;align-items:center;justify-content:center;transition:background .3s;z-index:5;}
.hero-carousel-arrow:hover{background:hsl(var(--card));}
.hero-carousel-arrow.left{left:.75rem;}
.hero-carousel-arrow.right{right:.75rem;}
.hero-carousel-arrow .ic{width:1.25rem;height:1.25rem;color:hsl(var(--foreground));}
.hero-dots{display:flex;justify-content:center;gap:.5rem;margin-top:1rem;}
.hero-dot{width:.625rem;height:.625rem;border-radius:50%;transition:background .3s;}
.hero-dot.active{background:hsl(var(--primary));}
.hero-dot.inactive{background:hsl(var(--border));}
.hero-trust-badges{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:1rem;}
.hero-trust-badge{display:flex;flex-direction:column;align-items:center;gap:.375rem;padding:.75rem;background:hsl(var(--secondary)/.5);border-radius:.75rem;text-align:center;}
.hero-trust-badge .ic{width:1.25rem;height:1.25rem;color:hsl(var(--primary));}
.hero-trust-badge span{font-size:.75rem;color:hsl(var(--muted-foreground));font-weight:500;}
.hero-desktop-left{display:none;}
/* Right column */
.hero-info{display:flex;flex-direction:column;gap:1rem;}
.hero-brand{font-size:.75rem;color:hsl(var(--muted-foreground));font-weight:500;}
.hero-title{font-size:28px;font-weight:700;color:hsl(var(--foreground));line-height:1.15;}
.hero-title-accent{color:hsl(var(--accent));}
.hero-desc{font-size:14px;color:hsl(var(--muted-foreground));}
.hero-mobile-carousel{display:block;}
.hero-pills{display:flex;flex-wrap:wrap;gap:.5rem;}
.hero-pill{display:flex;align-items:center;gap:.375rem;padding:.375rem .75rem;background:hsl(var(--secondary));border-radius:9999px;font-size:.75rem;}
.hero-pill .ic{width:.75rem;height:.75rem;color:hsl(var(--success));}
.hero-pill span{color:hsl(var(--foreground));font-weight:500;}
/* Price card */
.hero-price-card{background:hsl(var(--card));border-radius:1rem;padding:1.25rem;box-shadow:var(--shadow-card);border:1px solid hsl(var(--border));}
.hero-price-orig{color:hsl(var(--muted-foreground));text-decoration:line-through;font-size:1.125rem;}
.hero-price-discount{background:hsl(var(--destructive)/.1);color:hsl(var(--destructive));padding:.125rem .625rem;border-radius:9999px;font-size:.875rem;font-weight:700;margin-left:.75rem;}
.hero-price-value{font-size:2.25rem;font-weight:700;color:hsl(var(--foreground));margin:.25rem 0;}
.hero-price-installments{color:hsl(var(--muted-foreground));font-size:.875rem;margin-bottom:.75rem;}
.hero-cashback{display:flex;align-items:center;gap:.5rem;color:hsl(var(--success));font-size:.875rem;font-weight:500;}
.hero-cashback .ic{width:1rem;height:1rem;}
/* Treatment selector */
.hero-treatments-label{font-size:.875rem;font-weight:600;color:hsl(var(--foreground));margin-bottom:.75rem;}
.hero-treatments-mobile{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:.5rem;margin:0 -.25rem;padding-left:.25rem;padding-right:.25rem;scrollbar-width:none;-ms-overflow-style:none;}
.hero-treatments-mobile::-webkit-scrollbar{display:none;}
.hero-treatments-desktop{display:none;grid-template-columns:repeat(3,1fr);gap:.75rem;}
.hero-treatment{position:relative;flex-shrink:0;width:105px;padding:.5rem;padding-top:1.5rem;border-radius:.75rem;border:2px solid hsl(var(--border));background:hsl(var(--card));text-align:left;transition:all .3s;}
.hero-treatment.selected{border-color:hsl(var(--primary));background:hsl(var(--primary)/.05);box-shadow:0 4px 12px rgba(0,0,0,.1);}
.hero-treatment:hover{border-color:hsl(var(--primary)/.5);}
.hero-treatment-best{position:absolute;top:.25rem;left:50%;transform:translateX(-50%);background:hsl(var(--primary));color:hsl(var(--primary-foreground));font-size:8px;font-weight:700;padding:2px 6px;border-radius:9999px;white-space:nowrap;z-index:1;}
.hero-treatment-img{width:100%;height:4.5rem;border-radius:.5rem;margin-bottom:.5rem;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.hero-treatment-img img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;}
.hero-treatment-label{font-weight:700;color:hsl(var(--foreground));font-size:10px;line-height:1.2;}
.hero-treatment-caps{font-size:9px;color:hsl(var(--muted-foreground));}
.hero-treatment-price{font-size:.875rem;font-weight:700;color:hsl(var(--primary));margin-top:.25rem;}
.hero-treatment-per{font-size:8px;color:hsl(var(--muted-foreground));}
/* Delivery info */
.hero-delivery{background:hsl(var(--primary)/.1);border:1px solid hsl(var(--primary)/.2);border-radius:.75rem;padding:1rem;}
.hero-delivery-inner{display:flex;align-items:flex-start;gap:.75rem;}
.hero-delivery-icon{width:2rem;height:2rem;background:hsl(var(--primary)/.2);border-radius:.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.hero-delivery-icon .ic{width:1.25rem;height:1.25rem;color:hsl(var(--primary));}
.hero-delivery-text{font-size:12px;font-weight:600;color:hsl(var(--foreground));}
.hero-delivery-text .hl{color:hsl(var(--primary));}
.hero-delivery-sub{font-size:11px;color:hsl(var(--muted-foreground));margin-top:.125rem;}
/* Additional trust */
.hero-extra-trust{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding-top:.5rem;}
.hero-extra-trust-item{display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:hsl(var(--muted-foreground));}
.hero-extra-trust-item .ic{width:1rem;height:1rem;color:hsl(var(--primary));}
@media(min-width:768px){
  .hero-title{font-size:3rem;}
  .hero-desc{font-size:1.125rem;}
  .hero-brand{font-size:.875rem;}
  .hero-treatments-mobile{display:none;}
  .hero-treatments-desktop{display:grid;}
  .hero-treatment{width:auto;padding:1rem;padding-top:1.5rem;}
  .hero-treatment-best{font-size:10px;top:-.625rem;}
  .hero-treatment-img{height:8rem;margin-bottom:.75rem;}
  .hero-treatment-label{font-size:.875rem;}
  .hero-treatment-caps{font-size:.75rem;}
  .hero-treatment-price{font-size:1rem;}
  .hero-treatment-per{font-size:10px;}
  .hero-pill{font-size:.875rem;}
  .hero-pill .ic{width:.875rem;height:.875rem;}
  .hero-delivery-text{font-size:.875rem;}
  .hero-delivery-sub{font-size:.75rem;}
}
@media(min-width:1024px){
  .hero{padding:2.5rem 0;}
  .hero-grid{grid-template-columns:1fr 1fr;max-width:72rem;}
  .hero-desktop-left{display:block;order:1;}
  .hero-info{order:2;}
  .hero-mobile-carousel{display:none;}
}

.social-proof{display:flex;align-items:center;gap:.5rem;font-size:.875rem;}
.social-proof-stars{display:flex;}
.social-proof-stars .ic{width:1rem;height:1rem;color:#fbbf24;}
.social-proof-stars .ic svg{fill:#fbbf24;stroke:#fbbf24;}
.social-proof-rating{font-weight:700;color:hsl(var(--foreground));}
.social-proof-count{color:hsl(var(--muted-foreground));}

.problems{padding:3rem 0;overflow:hidden;}
.problems .container{max-width:72rem;}
.problems-subtitle{color:hsl(var(--accent));font-weight:600;font-size:.75rem;text-align:center;margin-bottom:.5rem;}
.problems-title{font-size:21px;font-weight:700;text-align:center;color:hsl(var(--foreground));margin-bottom:.75rem;}
.problems-desc{font-size:14px;color:hsl(var(--muted-foreground));text-align:center;margin-bottom:2.5rem;}
.problems-mobile{position:relative;}
.problems-mobile-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:10;width:2rem;height:2rem;border-radius:50%;background:hsl(var(--card)/.9);backdrop-filter:blur(8px);border:1px solid hsl(var(--border));box-shadow:0 2px 8px rgba(0,0,0,.1);display:flex;align-items:center;justify-content:center;}
.problems-mobile-arrow.left{left:0;}
.problems-mobile-arrow.right{right:0;}
