{% liquid
  assign pb_font = section.settings.font_body
  capture pb_product_image_override
    if section.settings.product_image_override != blank
      echo section.settings.product_image_override | image_url: width: 900
    endif
  endcapture
  capture pb_bg_image_override
    if section.settings.bg_image_override != blank
      echo section.settings.bg_image_override | image_url: width: 2400
    endif
  endcapture
%}
