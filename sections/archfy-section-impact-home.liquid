#shopify-section-{{ section.id }} .promo-banner * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: var(--pb-font-family), sans-serif;
}

#shopify-section-{{ section.id }} .promo-banner {
  position: relative;
  width: 100%;
  max-width: var(--pb-max-width);
  margin: 0 auto;
  border-radius: var(--pb-border-radius);
  overflow: visible;
  box-shadow: var(--pb-shadow-x) var(--pb-shadow-y) var(--pb-shadow-blur) var(--pb-shadow-spread) var(--pb-shadow-color);
  background: linear-gradient(var(--pb-bg-gradient-direction), var(--pb-bg-1), var(--pb-bg-2), var(--pb-bg-3));
  background-size: var(--pb-bg-size);
  background-position: var(--pb-bg-position);
}

#shopify-section-{{ section.id }} .promo-banner__grid {
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  padding: var(--pb-grid-padding-y-mobile) var(--pb-grid-padding-x-mobile);
  gap: var(--pb-grid-gap-mobile);
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__grid {
    grid-template-columns: 1fr 1fr 1fr;
    padding: var(--pb-grid-padding-desktop);
    gap: var(--pb-grid-gap-desktop);
  }
}

#shopify-section-{{ section.id }} .promo-banner__left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--pb-left-gap);
  text-align: center;
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__left {
    align-items: flex-start;
    text-align: left;
  }
}

#shopify-section-{{ section.id }} .promo-banner__badges {
  display: flex;
  align-items: center;
  gap: var(--pb-badges-gap);
  flex-wrap: nowrap;
  justify-content: center;
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__badges {
    justify-content: flex-start;
  }
}

#shopify-section-{{ section.id }} .promo-banner__badge {
  display: inline-block;
  padding: var(--pb-badge-padding-y-mobile) var(--pb-badge-padding-x-mobile);
  border-radius: var(--pb-badge-radius);
  font-weight: var(--pb-badge-font-weight);
  font-size: var(--pb-badge-font-size-mobile);
  letter-spacing: calc(var(--pb-badge-letter-spacing) * 1em);
  text-transform: uppercase;
  white-space: nowrap;
}

@media (min-width: 640px) {
  #shopify-section-{{ section.id }} .promo-banner__badge {
    padding: var(--pb-badge-padding-y-sm) var(--pb-badge-padding-x-sm);
    font-size: var(--pb-badge-font-size-sm);
  }
}

#shopify-section-{{ section.id }} .promo-banner__badge--primary {
  background: var(--pb-badge-primary-bg);
  color: var(--pb-badge-primary-text);
  box-shadow: var(--pb-badge-primary-shadow-x) var(--pb-badge-primary-shadow-y) var(--pb-badge-primary-shadow-blur) var(--pb-badge-primary-shadow-color);
}

#shopify-section-{{ section.id }} .promo-banner__badge--outline {
  background: transparent;
  border: var(--pb-badge-outline-border-width) solid var(--pb-badge-outline-border-color);
  color: var(--pb-badge-outline-text);
}

#shopify-section-{{ section.id }} .promo-banner__badge--shipping {
  background: transparent;
  border: var(--pb-shipping-border-width) solid var(--pb-shipping-border-color);
  color: var(--pb-shipping-text);
  display: none;
}

#shopify-section-{{ section.id }} .promo-banner__badge--shipping.is-visible {
  display: inline-block;
}

#shopify-section-{{ section.id }} .promo-banner__badge--discount {
  background: var(--pb-discount-bg);
  color: var(--pb-discount-text);
  padding: var(--pb-discount-padding-y-mobile) var(--pb-discount-padding-x-mobile);
  font-size: var(--pb-discount-font-size-mobile);
  border-radius: var(--pb-discount-radius);
}

@media (min-width: 640px) {
  #shopify-section-{{ section.id }} .promo-banner__badge--discount {
    padding: var(--pb-discount-padding-y-sm) var(--pb-discount-padding-x-sm);
    font-size: var(--pb-discount-font-size-sm);
  }
}

#shopify-section-{{ section.id }} .promo-banner__badge--coupon-extra {
  background: var(--pb-coupon-extra-bg);
  color: var(--pb-coupon-extra-text);
  padding: var(--pb-coupon-extra-padding-y-mobile) var(--pb-coupon-extra-padding-x-mobile);
  font-size: var(--pb-coupon-extra-font-size-mobile);
  border-radius: var(--pb-coupon-extra-radius);
}

@media (min-width: 640px) {
  #shopify-section-{{ section.id }} .promo-banner__badge--coupon-extra {
    padding: var(--pb-coupon-extra-padding-y-sm) var(--pb-coupon-extra-padding-x-sm);
    font-size: var(--pb-coupon-extra-font-size-sm);
  }
}

#shopify-section-{{ section.id }} .promo-banner__product-name {
  color: var(--pb-product-name-color);
  font-size: var(--pb-product-name-font-size-mobile);
  font-weight: var(--pb-product-name-font-weight);
  line-height: var(--pb-product-name-line-height);
  text-shadow: var(--pb-product-name-shadow-x) var(--pb-product-name-shadow-y) var(--pb-product-name-shadow-blur) var(--pb-product-name-shadow-color);
}

@media (min-width: 640px) {
  #shopify-section-{{ section.id }} .promo-banner__product-name {
    font-size: var(--pb-product-name-font-size-sm);
  }
}

#shopify-section-{{ section.id }} .promo-banner__img-mobile {
  display: block;
  width: 100%;
  max-width: var(--pb-img-mobile-max-width);
  aspect-ratio: var(--pb-img-mobile-aspect-ratio);
  margin: 0 auto;
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__img-mobile {
    display: none;
  }
}

#shopify-section-{{ section.id }} .promo-banner__img-mobile img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(var(--pb-img-drop-shadow-x) var(--pb-img-drop-shadow-y) var(--pb-img-drop-shadow-blur) var(--pb-img-drop-shadow-color));
}

#shopify-section-{{ section.id }} .promo-banner__prices {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--pb-prices-gap);
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__prices {
    align-items: flex-start;
  }
}

#shopify-section-{{ section.id }} .promo-banner__old-price-row {
  display: flex;
  align-items: center;
  gap: var(--pb-old-price-row-gap);
  flex-wrap: nowrap;
}

#shopify-section-{{ section.id }} .promo-banner__old-price {
  color: {{ section.settings.product_name_color | color_modify: 'alpha', section.settings.old_price_opacity }};
  font-size: var(--pb-old-price-font-size);
  text-decoration: line-through;
}

#shopify-section-{{ section.id }} .promo-banner__new-price-row {
  display: flex;
  align-items: center;
  gap: var(--pb-new-price-row-gap);
  flex-wrap: wrap;
  justify-content: center;
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__new-price-row {
    flex-wrap: nowrap;
    justify-content: flex-start;
  }
}

#shopify-section-{{ section.id }} .promo-banner__new-price {
  color: {{ section.settings.product_name_color }};
  font-size: var(--pb-new-price-font-size-base);
  font-weight: var(--pb-new-price-font-weight);
}

@media (min-width: 640px) {
  #shopify-section-{{ section.id }} .promo-banner__new-price {
    font-size: var(--pb-new-price-font-size-sm);
  }
}

@media (min-width: 1024px) {
  #shopify-section-{{ section.id }} .promo-banner__new-price {
    font-size: var(--pb-new-price-font-size-lg);
  }
