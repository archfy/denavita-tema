<script>
(function() {
  'use strict';

  var SECTION_ID = {{ section.id | json }};
  var ROOT_ID = 'promoBanner-' + SECTION_ID;

  var CONFIG = {
    sectionId: SECTION_ID,
    rootId: ROOT_ID,

    // Conteúdo (JS) — equivalente ao CONFIG do artefato original
    badgeText: {{ section.settings.badge_primary_text | json }},
    promoLabel: {{ section.settings.badge_secondary_text | json }},
    productName: {{ section.settings.product_name | json }},
    oldPrice: {{ section.settings.old_price | json }},
    newPrice: {{ section.settings.new_price | json }},
    installments: {{ section.settings.installments | json }},
    couponLabel: {{ section.settings.coupon_label | json }},
    couponCode: {{ section.settings.coupon_code | json }},
    couponExtraText: {{ section.settings.coupon_extra_text | json }},
    countdownHours: {{ section.settings.countdown_hours }},
    countdownLabel: {{ section.settings.countdown_label | json }},
    timerLabelHours: {{ section.settings.timer_label_hours | json }},
    timerLabelMinutes: {{ section.settings.timer_label_minutes | json }},
    timerLabelSeconds: {{ section.settings.timer_label_seconds | json }},

    freeShippingMin: {{ section.settings.free_shipping_min }},
    productImageOverride: {{ pb_product_image_override | strip | json }},
    productImageUrl: {{ section.settings.product_image_url | json }},
    bgImageUrl: {{ section.settings.bg_image_url | json }},
    bgImageOverride: {{ pb_bg_image_override | strip | json }},
    bgGradientDirection: {{ section.settings.bg_gradient_direction | json }},
    bgOverlay1: {{ section.settings.bg_color_1 | color_modify: 'alpha', section.settings.bg_overlay_alpha | json }},
    bgOverlay2: {{ section.settings.bg_color_2 | color_modify: 'alpha', section.settings.bg_overlay_alpha | json }},
    bgOverlay3: {{ section.settings.bg_color_3 | color_modify: 'alpha', section.settings.bg_overlay_alpha | json }},

    copiedText: {{ section.settings.copied_text | json }},
    countdownStorageKey: {{ section.settings.countdown_storage_key | json }},
    countdownTickMs: {{ section.settings.countdown_tick_ms }},
    copyBtnText: {{ section.settings.copy_btn_text_initial | json }},
    copyResetMs: {{ section.settings.copied_reset_ms }},

    ctaLink: {{ section.settings.cta_link | json }}
  };

  var NS = window.__PROMO_BANNER__ || (window.__PROMO_BANNER__ = {});
  var existing = NS[SECTION_ID];
  if (existing && typeof existing.destroy === 'function') {
    try { existing.destroy(); } catch(e) {}
  }

  var root = document.getElementById(ROOT_ID);
  if (!root) { return; }

  function q(idSuffix) {
    return document.getElementById(idSuffix + '-' + SECTION_ID);
  }

  var els = {
    badge: q('bannerBadge'),
    promoLabel: q('bannerPromoLabel'),
    productName: q('bannerProductName'),
    oldPrice: q('bannerOldPrice'),
    newPrice: q('bannerNewPrice'),
    installments: q('bannerInstallments'),
    couponLabel: q('bannerCouponLabel'),
    couponCode: q('bannerCouponCode'),
    countdownLabel: q('bannerCountdownLabel'),
    couponExtra: q('bannerCouponExtra'),
    discountBadge: q('bannerDiscountBadge'),
    shippingBadge: q('bannerShipping'),
    imgMobile: q('bannerImgMobile'),
    imgDesktop: q('bannerImgDesktop'),
    copyBtn: q('bannerCopyBtn'),
    copyText: q('bannerCopyText'),
    ctaBtn: q('bannerCta'),
    hours: q('countHours'),
    minutes: q('countMinutes'),
    seconds: q('countSeconds'),
    hoursLabel: q('countHoursLabel'),
    minutesLabel: q('countMinutesLabel'),
    secondsLabel: q('countSecondsLabel')
  };

  var intervalId = null;
  var endTime = null;
  var storageKey = CONFIG.countdownStorageKey;

  /* ═══ MÓDULO: EstruturaDOM ═══
     ID: M01
     ORIGEM: HTML (.promo-banner + grid/colunas/ids) do artefato original
     DEPENDE DE: —
     RECEBE: sectionId, root
     EXPÕE: validateDOM()
     ESTADO: els
     SCHEMA BINDINGS: (HTML) *_initial + URLs + labels de timer
  ═══ */
  function validateDOM() {
    return !!(root && els.badge && els.promoLabel && els.productName && els.oldPrice && els.newPrice &&
      els.installments && els.couponCode && els.copyBtn && els.ctaBtn && els.hours && els.minutes && els.seconds);
  }
  /* ═══ CHECKPOINT [M01] EstruturaDOM ✓ — Elementos e IDs escopados por section.id ═══ */

  /* ═══ MÓDULO: BindConteudo ═══
     ID: M02
     ORIGEM: CONFIG + assignments (textContent) do artefato original
     DEPENDE DE: M01
     RECEBE: CONFIG, els
     EXPÕE: applyContent()
     ESTADO: —
     SCHEMA BINDINGS: badge_primary_text, badge_secondary_text, product_name, old_price, new_price, installments, coupon_label, coupon_code, countdown_label, coupon_extra_text, timer_label_*
  ═══ */
  function applyContent() {
    els.badge.textContent = CONFIG.badgeText;
    els.promoLabel.textContent = CONFIG.promoLabel;
    els.productName.textContent = CONFIG.productName;
    els.oldPrice.textContent = CONFIG.oldPrice;
    els.newPrice.textContent = CONFIG.newPrice;
    els.installments.textContent = CONFIG.installments;
    els.couponLabel.textContent = CONFIG.couponLabel;
    els.couponCode.textContent = CONFIG.couponCode;
    els.countdownLabel.textContent = CONFIG.countdownLabel;
    els.couponExtra.textContent = CONFIG.couponExtraText;

    els.hoursLabel.textContent = CONFIG.timerLabelHours;
    els.minutesLabel.textContent = CONFIG.timerLabelMinutes;
    els.secondsLabel.textContent = CONFIG.timerLabelSeconds;
  }
  /* ═══ CHECKPOINT [M02] BindConteudo ✓ — Textos aplicados via CONFIG (JS) ═══ */

  /* ═══ MÓDULO: PrecosBadges ═══
     ID: M03
     ORIGEM: parsePrice + pct OFF + freeShippingMin do artefato original
     DEPENDE DE: M01, M02
     RECEBE: CONFIG.oldPrice/newPrice/freeShippingMin
     EXPÕE: applyPriceBadges()
     ESTADO: —
     SCHEMA BINDINGS: old_price, new_price, free_shipping_min
  ═══ */
  function parsePrice(str) {
    var clean = String(str || '').replace(/[R$\s.]/g, '').replace(',', '.');
    return parseFloat(clean);
  }
  function applyPriceBadges() {
    var oldNum = parsePrice(CONFIG.oldPrice);
    var newNum = parsePrice(CONFIG.newPrice);

    if (!isNaN(oldNum) && !isNaN(newNum) && oldNum > 0 && newNum < oldNum) {
      var pct = Math.round(((oldNum - newNum) / oldNum) * 100);
      els.discountBadge.textContent = pct + '% OFF';
    } else {
      els.discountBadge.textContent = '';
    }

    if (!isNaN(newNum) && newNum > CONFIG.freeShippingMin) {
      els.shippingBadge.classList.add('is-visible');
    } else {
      els.shippingBadge.classList.remove('is-visible');
    }
  }
  /* ═══ CHECKPOINT [M03] PrecosBadges ✓ — Desconto (%) e frete grátis (threshold) ═══ */

  /* ═══ MÓDULO: MidiaBackground ═══
     ID: M04
     ORIGEM: productImage + backgroundImage do artefato original
     DEPENDE DE: M01, M02
     RECEBE: CONFIG.productImageOverride/productImageUrl/bgImageOverride/bgImageUrl/bgOverlay*
     EXPÕE: applyMedia()
     ESTADO: —
     SCHEMA BINDINGS: product_image_url, product_image_override, bg_image_url, bg_image_override, bg_overlay_alpha, bg_color_1/2/3, bg_gradient_direction
  ═══ */
  function applyMedia() {
    var productImg = (CONFIG.productImageOverride && String(CONFIG.productImageOverride).trim()) ? CONFIG.productImageOverride : '';
    if (productImg) {
      els.imgMobile.src = productImg;
      els.imgMobile.alt = CONFIG.productName;
      els.imgDesktop.src = productImg;
      els.imgDesktop.alt = CONFIG.productName;
    } else {
      els.imgMobile.src = CONFIG.productImageUrl;
      els.imgMobile.alt = els.imgMobile.alt || '';
      els.imgDesktop.src = CONFIG.productImageUrl;
      els.imgDesktop.alt = els.imgDesktop.alt || '';
    }

    var bgImg = (CONFIG.bgImageOverride && String(CONFIG.bgImageOverride).trim()) ? CONFIG.bgImageOverride : CONFIG.bgImageUrl;
    if (bgImg) {
      root.style.backgroundImage =
        'linear-gradient(' + CONFIG.bgGradientDirection + ', ' + CONFIG.bgOverlay1 + ', ' + CONFIG.bgOverlay2 + ', ' + CONFIG.bgOverlay3 + '), url(' + bgImg + ')';
    }
  }
  /* ═══ CHECKPOINT [M04] MidiaBackground ✓ — Imagens do produto + background image/overlay ═══ */

  /* ═══ MÓDULO: CountdownPersistente ═══
     ID: M05
     ORIGEM: localStorage (promo-banner-countdown-end) + tick() do artefato original
     DEPENDE DE: M01, M02
     RECEBE: CONFIG.countdownHours
     EXPÕE: initCountdown(), tick(), destroyCountdown()
     ESTADO: endTime, intervalId, storageKey
     SCHEMA BINDINGS: countdown_hours, countdown_storage_key, countdown_tick_ms
  ═══ */
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function loadEndTime() {
    try {
      var saved = localStorage.getItem(storageKey);
      if (saved && parseInt(saved, 10) > Date.now()) {
        return parseInt(saved, 10);
      }
      var next = Date.now() + (CONFIG.countdownHours * 3600000);
      localStorage.setItem(storageKey, String(next));
      return next;
    } catch(e) {
      return Date.now() + (CONFIG.countdownHours * 3600000);
    }
  }

  function tick() {
    var remaining = Math.max(0, endTime - Date.now());
    var totalSec = Math.floor(remaining / 1000);

    els.hours.textContent = pad(Math.floor((totalSec % 86400) / 3600));
    els.minutes.textContent = pad(Math.floor((totalSec % 3600) / 60));
    els.seconds.textContent = pad(totalSec % 60);

    if (remaining <= 0) {
      endTime = Date.now() + (CONFIG.countdownHours * 3600000);
      try { localStorage.setItem(storageKey, String(endTime)); } catch(e) {}
    }
  }

  function initCountdown() {
    endTime = loadEndTime();
    tick();
    intervalId = window.setInterval(tick, CONFIG.countdownTickMs);
  }

  function destroyCountdown() {
    if (intervalId) {
      window.clearInterval(intervalId);
      intervalId = null;
    }
  }
  /* ═══ CHECKPOINT [M05] CountdownPersistente ✓ — Timer 24h com persistência em localStorage ═══ */

  /* ═══ MÓDULO: CopiarCupom ═══
     ID: M06
     ORIGEM: clipboard.writeText + fallbackCopy + showCopied do artefato original
     DEPENDE DE: M01, M02
     RECEBE: CONFIG.couponCode, CONFIG.copiedText, CONFIG.copyBtnText, CONFIG.copyResetMs
     EXPÕE: bindCopy()
     ESTADO: —
     SCHEMA BINDINGS: coupon_code, copied_text, copy_btn_text_initial, copied_reset_ms
  ═══ */
  function fallbackCopy(code) {
    var ta = document.createElement('textarea');
    ta.value = code;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try { document.execCommand('copy'); } catch(e) {}
    document.body.removeChild(ta);
    showCopied();
  }

  function showCopied() {
    els.copyText.textContent = CONFIG.copiedText;
    window.setTimeout(function() {
      els.copyText.textContent = CONFIG.copyBtnText;
    }, CONFIG.copyResetMs);
  }

  function bindCopy() {
    els.copyBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var code = CONFIG.couponCode;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(function() {
          showCopied();
        }).catch(function() {
          fallbackCopy(code);
        });
      } else {
        fallbackCopy(code);
      }
    });
  }
  /* ═══ CHECKPOINT [M06] CopiarCupom ✓ — Copiar cupom + feedback "Copiado!" ═══ */

  /* ═══ MÓDULO: CTA_Redirect ═══
     ID: M07
     ORIGEM: click do botão CTA → window.location.href = ctaLink (artefato original)
     DEPENDE DE: M01
     RECEBE: CONFIG.ctaLink
     EXPÕE: bindCTA()
     ESTADO: —
     SCHEMA BINDINGS: cta_link
  ═══ */
  function bindCTA() {
    els.ctaBtn.addEventListener('click', function() {
      window.location.href = CONFIG.ctaLink;
    });
  }
  /* ═══ CHECKPOINT [M07] CTA_Redirect ✓ — Clique redireciona para cta_link ═══ */

  /* ═══ MÓDULO: BootstrapSection ═══
     ID: M08
     ORIGEM: IIFE bootstrap do artefato original
     DEPENDE DE: M01..M07
     RECEBE: —
     EXPÕE: init(), destroy()
     ESTADO: NS[sectionId]
     SCHEMA BINDINGS: (agregação) todos os bindings consumidos por M02..M07
  ═══ */
  function init() {
    if (!validateDOM()) { return; }
    applyContent();
    applyPriceBadges();
    applyMedia();
    initCountdown();
    bindCopy();
    bindCTA();
  }

  function destroy() {
    destroyCountdown();
  }

  init();

  // Theme Editor support: cleanup quando a seção for descarregada
  document.addEventListener('shopify:section:unload', function(e) {
    if (e && e.detail && String(e.detail.sectionId) === String(SECTION_ID)) {
      destroy();
    }
  });

  NS[SECTION_ID] = {
    config: CONFIG,
    root: root,
    els: els,
    tick: tick,
    init: init,
    destroy: destroy,
    validateDOM: validateDOM
  };
  /* ═══ CHECKPOINT [M08] BootstrapSection ✓ — Init + lifecycle + namespace por section.id ═══ */

  /* ═══ MÓDULO: ValidacaoIntegridade ═══
     ID: M09
     ORIGEM: OP_7 __VALIDATE_INTEGRITY__ (invariantes executáveis)
     DEPENDE DE: M01..M08
     RECEBE: (opcional) sectionId
     EXPÕE: window.__VALIDATE_INTEGRITY__()
     ESTADO: —
     SCHEMA BINDINGS: valida presença de custom properties + CONFIG + DOM
  ═══ */
  window.__VALIDATE_INTEGRITY__ = function(sectionId) {
    var sid = (typeof sectionId !== 'undefined' && sectionId !== null) ? String(sectionId) : String(SECTION_ID);
    var inst = (window.__PROMO_BANNER__ && window.__PROMO_BANNER__[sid]) ? window.__PROMO_BANNER__[sid] : null;
    var results = [];

    function assert(module, test, description) {
      try {
        var pass = !!test();
        results.push({ module: module, description: description, status: pass ? '✅' : '❌' });
      } catch (e) {
        results.push({ module: module, description: description, status: '💥 ERRO: ' + e.message });
      }
    }

    assert('M01', function() { return !!inst && !!inst.root; }, 'Instância existe e root está disponível');
    assert('M01', function() { return !!inst && typeof inst.validateDOM === 'function' && inst.validateDOM(); }, 'Estrutura DOM válida (IDs/elementos)');

    assert('M02', function() { return !!inst && typeof inst.config === 'object' && inst.config.badgeText !== undefined; }, 'CONFIG existe e contém badgeText');
    assert('M03', function() { return !!inst && inst.els && inst.els.discountBadge; }, 'Badge de desconto existe no DOM');
    assert('M03', function() { return !!inst && inst.els && inst.els.shippingBadge; }, 'Badge de frete existe no DOM');

    assert('M04', function() { return !!inst && inst.els && inst.els.imgMobile && inst.els.imgDesktop; }, 'Imagens mobile/desktop existem');
    assert('M04', function() {
      var el = document.getElementById('shopify-section-' + sid);
      if (!el) return false;
      var style = getComputedStyle(el);
      return String(style.getPropertyValue('--pb-max-width') || '').trim() !== '';
    }, 'Custom properties do schema injetadas no CSS (#shopify-section-{{section.id}})');

    assert('M05', function() { return !!inst && typeof inst.tick === 'function'; }, 'Função tick() existe');
    assert('M06', function() { return !!inst && inst.els && inst.els.copyBtn && inst.els.copyText; }, 'Botão de copiar e label existem');
    assert('M07', function() { return !!inst && inst.els && inst.els.ctaBtn; }, 'CTA existe');
    assert('M08', function() { return !!inst && typeof inst.destroy === 'function' && typeof inst.init === 'function'; }, 'Lifecycle init/destroy existe');

    console.table(results);
    var failures = results.filter(function(r) { return r.status !== '✅'; });
    if (failures.length === 0) {
      console.log('%c✅ TODOS OS INVARIANTES PASSARAM', 'color:green;font-size:16px');
    } else {
      console.log('%c❌ ' + failures.length + ' FALHA(S) DETECTADA(S)', 'color:red;font-size:16px');
    }
    return results;
  };
  /* ═══ CHECKPOINT [M09] ValidacaoIntegridade ✓ — __VALIDATE_INTEGRITY__() disponível via console ═══ */

})();
</script>
