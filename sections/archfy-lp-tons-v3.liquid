}
.study-card {
  background: #fff; border-radius: 1rem; padding: 1.5rem; max-width: 56rem; margin: 0 auto;
}
@media (min-width: 768px) { .study-card { border-radius: 1.5rem; padding: 2.5rem; } }
.stat-box {
  text-align: center; padding: 0.75rem; background: hsl(var(--primary-light)); border-radius: 0.75rem;
}
.stat-value { font-size: 1.25rem; font-weight: 700; color: hsl(var(--primary)); }
@media (min-width: 768px) { .stat-value { font-size: 1.875rem; } }
.stat-label { font-size: 0.625rem; color: hsl(var(--muted-foreground)); }
@media (min-width: 768px) { .stat-label { font-size: 0.75rem; } }
.science-badge {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: rgba(255,255,255,0.2); backdrop-filter: blur(4px);
  border-radius: 9999px; padding: 0.375rem 0.75rem;
}
@media (min-width: 768px) { .science-badge { padding: 0.5rem 1rem; } }
.science-badge span { font-size: 0.75rem; color: #fff; font-weight: 500; }
@media (min-width: 768px) { .science-badge span { font-size: 0.875rem; } }

