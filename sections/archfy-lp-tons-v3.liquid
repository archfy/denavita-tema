function toggleFaq(btn) {
  var answer = btn.nextElementSibling;
  var chevron = btn.querySelector('.accordion-chevron');
  var isOpen = answer.classList.contains('open');
  document.querySelectorAll('#faq-list .faq-answer').forEach(function(a) { a.classList.remove('open'); });
  document.querySelectorAll('#faq-list .accordion-chevron').forEach(function(c) { c.classList.remove('open'); });
  if (!isOpen) { answer.classList.add('open'); chevron.classList.add('open'); }
}

