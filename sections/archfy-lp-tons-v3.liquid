/* ═══ MÓDULO: Tracking ═══
   ID: M15
   ORIGEM: src/lib/tracking.ts
   DEPENDE DE: —
   RECEBE: kitName (string), price (number), quantity (number)
   EXPÕE: trackPurchaseClick
   ESTADO: —
═══ */
function trackPurchaseClick(kitName, price, quantity) {
  if (window.gtag) {
    window.gtag('event', 'begin_checkout', {
      currency: 'BRL', value: price, page_title: 'TONS - LP LOVABLE',
      items: [{ item_name: 'Tons Clareador de Pele', item_variant: kitName, price: price, quantity: quantity }]
    });
    window.gtag('event', 'purchase', {
      currency: 'BRL', value: price, page_title: 'TONS - LP LOVABLE',
      transaction_id: Date.now() + '_' + kitName.replace(/\s/g, '_'),
      items: [{ item_name: 'Tons Clareador de Pele', item_variant: kitName, price: price, quantity: quantity }]
    });
  }
  if (window.fbq) {
    window.fbq('track', 'InitiateCheckout', {
      content_name: 'Tons Clareador - ' + kitName, content_type: 'product',
      value: price, currency: 'BRL', num_items: quantity
    });
  }
}
/* ═══ CHECKPOINT [M15] Tracking ✓ — GA4 + FB Pixel events ═══ */

