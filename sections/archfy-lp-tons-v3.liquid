.social-comment { background: #fff; border-radius: 1rem; padding: 0.75rem; flex-shrink: 0; width: 18rem; }
@media (min-width: 768px) { .social-comment { width: 20rem; } }
.social-comment img { width: 100%; border-radius: 0.75rem; }

/* How to use */
.step-icon {
  position: relative; flex-shrink: 0;
}
.step-circle {
  width: 4rem; height: 4rem; border-radius: 50%; display: flex;
  align-items: center; justify-content: center; background: hsl(var(--secondary));
}
.step-number {
  position: absolute; top: -0.25rem; right: -0.25rem; width: 1.5rem; height: 1.5rem;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 0.75rem; background: hsl(var(--destructive-foreground));
  color: hsl(var(--secondary));
}
.how-image {
  position: relative; width: 16rem; height: 16rem; border-radius: 50%; overflow: hidden;
}
@media (min-width: 768px) { .how-image { width: 20rem; height: 20rem; } }
.how-image img { width: 100%; height: 100%; object-fit: cover; }

/* FAQ */
.faq-item {
  background: hsl(var(--muted) / 0.5); border-radius: 0.75rem; margin-bottom: 1rem; overflow: hidden;
}
.faq-trigger {
  display: flex; align-items: center; justify-content: space-between; width: 100%;
  padding: 1.25rem 1.5rem; font-weight: 600; text-align: left; font-size: 0.95rem;
  color: hsl(var(--foreground)); transition: color 0.2s; cursor: pointer;
}
.faq-trigger:hover { color: hsl(var(--primary)); }
.faq-answer {
  max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease;
  padding: 0 1.5rem; color: hsl(var(--muted-foreground)); font-size: 0.95rem;
}
.faq-answer.open { max-height: 300px; padding-bottom: 1.25rem; }

/* Footer */
.site-footer { background: #1a3e01; color: #fff; position: relative; overflow: hidden; }

/* Carousel wrapper */
.carousel-track {
  display: flex; gap: 1rem; width: max-content;
}
.carousel-auto { animation: scroll-carousel 60s linear infinite; will-change: transform; }
.carousel-auto:hover { animation-play-state: paused; }
.carousel-wrapper { overflow: hidden; padding: 1rem 0; position: relative; }
.carousel-arrows { position: relative; }
.arrow-btn {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
  width: 2.5rem; height: 2.5rem; background: #fff; border-radius: 50%;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center;
}
.arrow-btn:hover { background: hsl(var(--muted)); }
.arrow-left { left: 0; }
.arrow-right { right: 0; }

/* SVG icons inline */
.icon { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.icon-sm { width: 1rem; height: 1rem; }
.icon-lg { width: 1.5rem; height: 1.5rem; }
.icon-xl { width: 2rem; height: 2rem; }

/* Subhero marquee */
.marquee-track { display: flex; animation: scroll-marquee 15s linear infinite; width: max-content; will-change: transform; }
</style>

