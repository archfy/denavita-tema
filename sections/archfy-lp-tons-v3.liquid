  assert('M04', function(){ return document.getElementById('benefits-desktop').children.length >= 6; }, 'Benefits desktop 6 cards');
  assert('M05', function(){ return document.getElementById('checklist').children.length >= 6; }, 'Checklist 6 itens renderizados');
  assert('M06', function(){ return document.getElementById('ingredients-mobile').children.length >= 3; }, 'Ingredientes mobile renderizados');
  assert('M06', function(){ return document.getElementById('study-card').children.length > 0; }, 'Study card renderizado');
  assert('M07', function(){ return document.getElementById('timeline-desktop').children.length >= 3; }, 'Timeline desktop 3 cards');
  assert('M08', function(){ return document.getElementById('video-carousel').children.length > 0; }, 'Video carousel renderizado');
  assert('M08', function(){ return document.getElementById('social-carousel').children.length > 0; }, 'Social comments carousel');
  assert('M08', function(){ return document.getElementById('written-carousel').children.length > 0; }, 'Written testimonials carousel');
  assert('M08', function(){ return typeof openVideoModal === 'function'; }, 'openVideoModal função existe');
  assert('M08', function(){ return typeof closeVideoModal === 'function'; }, 'closeVideoModal função existe');
  assert('M09', function(){ return document.getElementById('pricing-grid').children.length >= 3; }, 'Pricing 3 kits renderizados');
  assert('M10', function(){ return document.getElementById('how-steps').children.length >= 3; }, 'How to use 3 passos');
  assert('M11', function(){ return document.getElementById('faq-list').children.length >= 8; }, 'FAQ 8 perguntas');
  assert('M11', function(){ return typeof toggleFaq === 'function'; }, 'toggleFaq função existe');
  assert('M12', function(){ return document.getElementById('footer-content').children.length > 0; }, 'Footer renderizado');
  assert('M13', function(){ return document.getElementById('sticky-footer') !== null; }, 'StickyFooter presente');
  assert('M13', function(){ return typeof toggleVariantDropdown === 'function'; }, 'toggleVariantDropdown função existe');
  assert('M13', function(){ return typeof selectVariant === 'function'; }, 'selectVariant função existe');
  assert('M14', function(){ return document.querySelector('.whatsapp-btn') !== null; }, 'WhatsApp button presente');
  assert('M15', function(){ return typeof trackPurchaseClick === 'function'; }, 'trackPurchaseClick função existe');
  console.table(results);
  var failures = results.filter(function(r) { return r.status !== '✅'; });
  if (failures.length === 0) { console.log('%c✅ TODOS OS INVARIANTES PASSARAM', 'color:green;font-size:16px'); }
  else { console.log('%c❌ ' + failures.length + ' FALHA(S) DETECTADA(S)', 'color:red;font-size:16px'); }
  return results;
}
