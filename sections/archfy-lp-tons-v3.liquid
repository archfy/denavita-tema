/* ═══ MÓDULO: StickyFooter ═══
   ID: M13
   ORIGEM: StickyFooter.tsx
   DEPENDE DE: M15, M16
   RECEBE: —
   EXPÕE: toggleVariantDropdown, trackStickyPurchase
   ESTADO: isVisible, isDropdownOpen, selectedVariant
═══ */
var stickyVariants = [
  { id: 1, name: '1 Unidade', sub: '30 cápsulas', price: 127.90, orig: 139.90, badge: null, ship: false, url: 'https://seguro.denavita.com.br/r/74CX39I8SC' },
  { id: 2, name: '2 Unidades', sub: '60 cápsulas', price: 239.80, orig: 279.80, badge: 'Mais Vendido', ship: true, url: 'https://seguro.denavita.com.br/r/23M4RZJUJE' },
  { id: 3, name: '3 Unidades', sub: '90 cápsulas', price: 329.90, orig: 419.70, badge: 'Maior Economia', ship: true, url: 'https://seguro.denavita.com.br/r/PBRZS0RKLG' }
];
var selectedVariantIdx = 1;
var stickyDropdownOpen = false;
function fmt(v) { return v.toFixed(2).replace('.', ','); }
function updateStickyUI() {
  var v = stickyVariants[selectedVariantIdx];
  var disc = Math.round((1 - v.price / v.orig) * 100);
  document.getElementById('variant-label').textContent = v.name;
  document.getElementById('sticky-original').textContent = 'R$ ' + fmt(v.orig);
  document.getElementById('sticky-discount-badge').textContent = '-' + disc + '%';
  document.getElementById('sticky-price').textContent = 'R$ ' + fmt(v.price);
  document.getElementById('sticky-mobile-price').textContent = 'R$ ' + fmt(v.price);
  document.getElementById('sticky-buy-btn').href = v.url;
  var shipEl = document.getElementById('sticky-shipping');
  shipEl.style.display = v.ship ? 'inline-flex' : 'none';
}
function renderVariantDropdown() {
  var html = '';
  stickyVariants.forEach(function(v, i) {
    html += '<button class="variant-option ' + (i === selectedVariantIdx ? 'selected' : '') + '" onclick="selectVariant(' + i + ')"><div style="display:flex;flex-direction:column;align-items:flex-start;gap:0.125rem"><div style="display:flex;align-items:center;gap:0.375rem"><span style="font-weight:600;font-size:0.75rem;color:' + (i === selectedVariantIdx ? 'hsl(var(--primary))' : 'hsl(var(--foreground))') + '">' + v.name + '</span>' + (v.badge ? '<span style="font-size:0.5625rem;background:hsl(var(--secondary)/0.1);color:hsl(var(--secondary));padding:0.125rem 0.25rem;border-radius:0.25rem;white-space:nowrap">' + v.badge + '</span>' : '') + '</div><div style="display:flex;align-items:center;gap:0.375rem"><span style="font-size:0.625rem;color:hsl(var(--muted-foreground))">' + v.sub + '</span>' + (v.ship ? '<span style="font-size:0.5625rem;color:hsl(var(--secondary));font-weight:500">• Frete Grátis</span>' : '') + '</div></div><div style="text-align:right"><p style="font-weight:700;font-size:0.75rem;color:' + (i === selectedVariantIdx ? 'hsl(var(--primary))' : 'hsl(var(--foreground))') + '">R$ ' + fmt(v.price) + '</p><p style="font-size:0.625rem;color:hsl(var(--muted-foreground));text-decoration:line-through">R$ ' + fmt(v.orig) + '</p></div></button>';
  });
  document.getElementById('variant-dropdown').innerHTML = html;
}
function toggleVariantDropdown() {
  stickyDropdownOpen = !stickyDropdownOpen;
  document.getElementById('variant-dropdown').classList.toggle('open', stickyDropdownOpen);
  document.getElementById('variant-chevron').style.transform = stickyDropdownOpen ? 'rotate(180deg)' : '';
}
function selectVariant(i) {
  selectedVariantIdx = i;
  stickyDropdownOpen = false;
  document.getElementById('variant-dropdown').classList.remove('open');
  document.getElementById('variant-chevron').style.transform = '';
  updateStickyUI();
  renderVariantDropdown();
}
function trackStickyPurchase() {
  var v = stickyVariants[selectedVariantIdx];
  trackPurchaseClick(v.name, v.price, v.id);
}
renderVariantDropdown();
updateStickyUI();
// Scroll visibility (throttled for performance)
var stickyTicking = false;
window.addEventListener('scroll', function() {
  if (!stickyTicking) {
    stickyTicking = true;
    requestAnimationFrame(function() {
      var footer = document.getElementById('site-footer');
      var footerTop = footer ? footer.getBoundingClientRect().top : Infinity;
      var visible = window.scrollY > 500 && footerTop >= window.innerHeight;
      document.getElementById('sticky-footer').classList.toggle('visible', visible);
      stickyTicking = false;
    });
  }
}, {passive: true});

/* ═══ MÓDULO: ResponsiveGrids ═══
   ID: (helper)
   ORIGEM: tailwind responsive classes
   DEPENDE DE: M16
   RECEBE: —
   EXPÕE: —
   ESTADO: —
═══ */
(function() {
  // Apply responsive grid styles via media query
  var style = document.createElement('style');
  style.textContent = '@media(min-width:768px){#pricing-grid{grid-template-columns:repeat(3,1fr);}#benefits-desktop{display:grid!important;grid-template-columns:repeat(2,1fr);}#ba-grid-desktop{display:grid!important;}}@media(min-width:1024px){.hero-grid{grid-template-columns:1fr 1fr;}.who-grid{grid-template-columns:1fr 1fr;}.how-grid{grid-template-columns:1fr 1fr;}.who-text-align{text-align:left;}#hero-content{text-align:left;max-width:none;margin:0;}#benefits-desktop{grid-template-columns:repeat(3,1fr)!important;}.why-grid{grid-template-columns:1fr 1fr;}}@media(min-width:768px){.hero-title{font-size:3rem;}.section-title{font-size:2.25rem;}}@media(min-width:1024px){.hero-title{font-size:3.75rem;}.section-title{font-size:3rem;}}@media(max-width:767px){.capsule-desktop{display:none!important;}}@media(min-width:768px){.capsule-mobile{display:none!important;}.show-mobile{display:none!important;}.hide-mobile{display:block!important;}}@media(max-width:767px){.hide-mobile{display:none!important;}.show-mobile{display:block!important;}}@media(min-width:768px){#ingredients-desktop{display:grid!important;}#timeline-desktop{display:grid!important;}}';
  document.head.appendChild(style);
})();

/* ═══ MÓDULO: Validation ═══
