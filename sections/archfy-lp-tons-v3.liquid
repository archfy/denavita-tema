    catch(e) { results.push({ module: module, description: description, status: '💥 ERRO: ' + e.message }); }
  }
  assert('M01', function(){ return document.getElementById('subhero-marquee').children.length > 0; }, 'SubHero marquee renderizado');
  assert('M02', function(){ return document.getElementById('inicio') !== null; }, 'HeroSection presente');
