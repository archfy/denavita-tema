.before-after-img img { width: 100%; height: 100%; object-fit: cover; }
.before-after-labels { position: absolute; bottom: 0.5rem; left: 0.5rem; right: 0.5rem; display: flex; justify-content: space-between; }
.ba-label { font-size: 0.75rem; color: #fff; padding: 0.25rem 0.5rem; border-radius: 9999px; }
