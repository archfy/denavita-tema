  /* ═══ Shared helpers ═══ */
  function createStoreItem(store) {
    var li = document.createElement('li');
    li.className = 'sl-store-item';
    li.setAttribute('tabindex', '0');
    li.setAttribute('role', 'listitem');

    var name = document.createElement('div');
    name.className = 'sl-store-name';
    name.textContent = titleCase(store.nome || '');

    var addr = document.createElement('div');
    addr.className = 'sl-store-addr';
    addr.textContent = (store.endereco || '') + (store.bairro ? ', ' + store.bairro : '') + ' - ' + (store.cidade || '') + '/' + (store.estado || '');

    var meta = document.createElement('div');
    meta.className = 'sl-store-meta';

    var status = document.createElement('span');
    status.className = 'sl-store-status ' + (store._isOpen ? 'sl-open' : 'sl-closed');
    var closing = store._closingTime;
    status.textContent = store._isOpen ? '🟢 Aberto até ' + (closing || '--') : '🔴 Fechado';

    meta.appendChild(status);

    if (store._distance !== undefined) {
      var dist = document.createElement('span');
      dist.className = 'sl-store-dist';
      dist.textContent = store._distance.toFixed(1) + 'km';
      meta.appendChild(dist);
    }

    if (store.telefone) {
      var phone = document.createElement('span');
      phone.className = 'sl-store-phone';
      phone.textContent = store.telefone;
      meta.appendChild(phone);
    }

    var viewBtn = document.createElement('button');
    viewBtn.className = 'sl-store-view-btn';
    viewBtn.textContent = 'Ver no mapa';
    viewBtn.addEventListener('click', function() {
      PanEngine.panTo(store.lat, store.lng, true);
      ZoomEngine.zoomTo(15, true);
      /* Create a temporary pin element to show tooltip */
      setTimeout(function() {
        var pins = MapState.pinsLayer.querySelectorAll('.sl-pin');
        for (var p = 0; p < pins.length; p++) {
          if (pins[p].getAttribute('data-store-id') === (store.id || '')) {
            PinRenderer.selectPin(store, pins[p]);
            break;
          }
        }
      }, 500);
    });

    li.appendChild(name);
    li.appendChild(addr);
    li.appendChild(meta);
    li.appendChild(viewBtn);

    return li;
  }

  function addChip(title, handle) {
    var container = $('sl-chips-' + SID);
    container.innerHTML = '';
    var chip = document.createElement('div');
    chip.className = 'sl-chip';
    chip.innerHTML = '<span>' + title + '</span>';
    var removeBtn = document.createElement('button');
    removeBtn.className = 'sl-chip-remove';
    removeBtn.innerHTML = '&times;';
    removeBtn.setAttribute('aria-label', 'Remover filtro ' + title);
    removeBtn.addEventListener('click', function() {
      StockFilter.selectedProduct = null;
      container.innerHTML = '';
      /* Also clear mobile chips */
      var mContainer = $('sl-bs-chips-' + SID);
      if (mContainer) mContainer.innerHTML = '';
      refreshStores();
      announceAria('Filtro de produto removido');
    });
    chip.appendChild(removeBtn);
    container.appendChild(chip);
  }

  function addChipMobile(title, handle) {
    var container = $('sl-bs-chips-' + SID);
    container.innerHTML = '';
    var chip = document.createElement('div');
    chip.className = 'sl-chip';
    chip.innerHTML = '<span>' + title + '</span>';
