  /* ═══ Core rendering ═══ */
  function renderMap() {
    var z = Math.round(MapState.zoom);
    TileManager.loadTiles(MapState.centerLat, MapState.centerLng, z, MapState.vpW, MapState.vpH, MapState.offsetX, MapState.offsetY);

    /* Position tile layer */
    var centerPx = MercatorEngine.latLngToPixel(MapState.centerLat, MapState.centerLng, z);
    var tx = -(centerPx.x + MapState.offsetX) + MapState.vpW / 2;
    var ty = -(centerPx.y + MapState.offsetY) + MapState.vpH / 2;
    MapState.tileLayer.style.transform = 'translate3d(' + tx + 'px, ' + ty + 'px, 0)';
    MapState.pinsLayer.style.transform = 'translate3d(' + tx + 'px, ' + ty + 'px, 0)';

    /* Re-render pins if not dragging (for performance) */
    if (!MapState.isDragging) {
      renderPinsOnMap();
    }
  }

  function renderPinsOnMap() {
    var stores = FilterComposer.filteredStores;
    if (!stores || stores.length === 0) {
      PinRenderer.clearPins();
      return;
    }

    /* Get visible bounds */
    var z = Math.round(MapState.zoom);
    var centerPx = MercatorEngine.latLngToPixel(MapState.centerLat, MapState.centerLng, z);
    var margin = 50;
    var leftPx = centerPx.x + MapState.offsetX - MapState.vpW / 2 - margin;
    var rightPx = centerPx.x + MapState.offsetX + MapState.vpW / 2 + margin;
    var topPxB = centerPx.y + MapState.offsetY - MapState.vpH / 2 - margin;
    var bottomPxB = centerPx.y + MapState.offsetY + MapState.vpH / 2 + margin;

    /* Filter visible stores */
    var visibleStores = [];
    for (var i = 0; i < stores.length; i++) {
      var px = MercatorEngine.latLngToPixel(stores[i].lat, stores[i].lng, z);
      if (px.x >= leftPx && px.x <= rightPx && px.y >= topPxB && px.y <= bottomPxB) {
        visibleStores.push(stores[i]);
      }
    }

    /* Cluster or show individual */
    var items = ClusterEngine.computeClusters(visibleStores, MapState.zoom);

    /* Render */
    PinRenderer.renderPins(items, MapState.zoom);
  }

  var refreshDebounce = null;
  function refreshStores() {
    clearTimeout(refreshDebounce);
    refreshDebounce = setTimeout(function() {
      FilterComposer.applyFilters(DataSource.stores, function(filtered) {
        SidePanel.updateList(filtered);
        BottomSheet.updateList(filtered);
        renderPinsOnMap();
      });
    }, 50);
  }

  /* ═══ MÓDULO: __VALIDATE_INTEGRITY__ ═══
     ID: OP₇
     SPEC: 7.7 (Invariantes Executáveis)
     Invoke via browser console: __VALIDATE_INTEGRITY__()
  ═══ */
  window.__VALIDATE_INTEGRITY__ = function() {
    var results = [];
    function assert(module, test, description) {
      try {
        var pass = test();
        results.push({ module: module, description: description, status: pass ? '✅' : '❌' });
      } catch(e) {
        results.push({ module: module, description: description, status: '💥 ERRO: ' + e.message });
      }
    }

    /* M01 — Motor Mercator */
    assert('M01', function() { return typeof MercatorEngine.latLngToPixel === 'function'; }, 'latLngToPixel existe');
    assert('M01', function() { return MercatorEngine.latLngToPixel(-5.79, -35.21, 12).x > 0; }, 'Natal retorna pixel positivo');
    assert('M01', function() {
      var a = MercatorEngine.latLngToPixel(0, 0, 4);
      var b = MercatorEngine.latLngToPixel(-23.55, -46.63, 4);
      return a.x !== b.x && a.y !== b.y;
    }, 'Coordenadas distintas geram pixels distintos');
    assert('M01', function() { return typeof MercatorEngine.pixelToLatLng === 'function'; }, 'pixelToLatLng existe');

    /* M02 — Tile Manager */
    assert('M02', function() { return typeof TileManager !== 'undefined'; }, 'TileManager existe');
    assert('M02', function() { return typeof TileManager.loadTiles === 'function'; }, 'loadTiles é função');
    assert('M02', function() { return typeof TileManager.getTileUrl === 'function'; }, 'getTileUrl é função');
    assert('M02', function() {
      var url = TileManager.getTileUrl(10, 300, 400);
      return url.indexOf('tile.openstreetmap.org') !== -1;
    }, 'getTileUrl retorna URL OSM válida');

    /* M03 — Pan */
    assert('M03', function() { return typeof PanEngine.panTo === 'function'; }, 'PanEngine.panTo existe');
    assert('M03', function() { return typeof PanEngine.init === 'function'; }, 'PanEngine.init existe');

    /* M07 — Clustering */
    assert('M07', function() { return typeof ClusterEngine !== 'undefined'; }, 'ClusterEngine existe');
    assert('M07', function() { return typeof ClusterEngine.computeClusters === 'function'; }, 'computeClusters é função');
    assert('M07', function() {
      var fakeStores = [];
      for (var i = 0; i < 20; i++) { fakeStores.push({ lat: -5.79 + i * 0.001, lng: -35.21, nome: 'T' + i }); }
      var result = ClusterEngine.computeClusters(fakeStores, 12);
      return result.length > 0 && result.length < 20;
    }, 'Clustering agrupa 20 pontos próximos');

    /* M10 — Location Search */
    assert('M10', function() { return typeof LocationSearch.search === 'function'; }, 'LocationSearch.search existe');
    assert('M10', function() { return LocationSearch.isCEP('59012300'); }, 'isCEP reconhece CEP válido');
    assert('M10', function() { return !LocationSearch.isCEP('Natal'); }, 'isCEP rejeita texto');

    /* M15 — Parser */
    assert('M15', function() { return typeof parseStoreData === 'function'; }, 'parseStoreData existe');
    assert('M15', function() {
      var json = JSON.stringify([{ id: '1', nome: 'Test', lat: -5.79, lng: -35.21 }]);
      var result = parseStoreData(json);
      return Array.isArray(result) && result.length === 1 && result[0].nome === 'Test';
    }, 'Parser JSON funciona');
    assert('M15', function() {
      var csv = 'id,nome,lat,lng\n001,Teste,-5.79,-35.21';
      var result = parseStoreData(csv);
      return Array.isArray(result) && result.length === 1;
    }, 'Parser CSV funciona');

    /* M18 — Haversine */
    assert('M18', function() { return typeof haversine === 'function'; }, 'haversine existe');
    assert('M18', function() {
      var d = haversine(-5.79, -35.21, -5.80, -35.22);
      return d > 0 && d < 5;
    }, 'Haversine: pontos próximos em Natal retornam distância plausível');
    assert('M18', function() {
      var d = haversine(-5.79, -35.21, -23.55, -46.63);
      return d > 2000 && d < 3000;
    }, 'Haversine: Natal→SP ~2500km');

    /* M12 — Open Now Filter */
    assert('M12', function() { return typeof OpenNowFilter.isOpenNow === 'function'; }, 'isOpenNow existe');
    assert('M12', function() { return typeof OpenNowFilter.parseSchedule === 'function'; }, 'parseSchedule existe');

    /* M17 — GeoLocator */
    assert('M17', function() { return typeof GeoLocator.requestPosition === 'function'; }, 'GeoLocator.requestPosition existe');

    console.table(results);
    var failures = results.filter(function(r) { return r.status !== '✅'; });
    if (failures.length === 0) {
      console.log('%c✅ TODOS OS INVARIANTES PASSARAM', 'color:green;font-size:16px');
    } else {
      console.log('%c❌ ' + failures.length + ' FALHA(S) DETECTADA(S)', 'color:red;font-size:16px');
    }
    return results;
  };
  /* ═══ CHECKPOINT [OP₇] Invariantes Executáveis ✓ — Spec 7.7: __VALIDATE_INTEGRITY__ ═══ */

  /* ═══ MÓDULO: GeoBubble ═══
     ID: M20
     SPEC: UX — Geolocation tooltip
     DEPENDE DE: GeoLocator (M17), PanEngine (M03), ZoomEngine (M04), DataSource (M16)
  ═══ */
  var GeoBubble = {
    el: null,
    body: null,
    dismissed: false,
    userLat: 0,
    userLng: 0,

    init: function() {
      this.el = $('sl-geo-bubble-' + SID);
      this.body = $('sl-geo-body-' + SID);
    },

    ping: function() {
      try {
        var ctx = new (window.AudioContext || window.webkitAudioContext)();
        var osc = ctx.createOscillator();
        var g = ctx.createGain();
        osc.connect(g); g.connect(ctx.destination);
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.setValueAtTime(1320, ctx.currentTime + 0.06);
        g.gain.setValueAtTime(0.08, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
        osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.18);
        setTimeout(function() { ctx.close(); }, 400);
      } catch(e) {}
    },

    nearestCity: function(lat, lng) {
      var stores = DataSource.stores;
      if (!stores || !stores.length) return '';
      var best = Infinity, city = '';
      this.nearestLat = lat;
      this.nearestLng = lng;
      for (var i = 0; i < stores.length; i++) {
        var d = haversine(lat, lng, stores[i].lat, stores[i].lng);
        if (d < best) {
          best = d;
          city = stores[i].cidade || '';
          this.nearestLat = stores[i].lat;
          this.nearestLng = stores[i].lng;
        }
      }
      return city.toLowerCase().replace(/(^|\s)\S/g, function(c) { return c.toUpperCase(); });
    },

    countNearby: function(lat, lng) {
      var stores = DataSource.stores;
      var r = CONFIG.searchRadius || 10, n = 0;
      if (!stores) return 0;
      for (var i = 0; i < stores.length; i++) {
        if (haversine(lat, lng, stores[i].lat, stores[i].lng) <= r) n++;
      }
      return n;
    },

    show: function(html) {
      this.body.innerHTML = html;
      this.el.classList.add('sl-geo-visible');
      this.ping();
    },

    hide: function() {
      var self = this;
      this.el.style.opacity = '0';
      this.el.style.transform = 'translateX(-50%) translateY(-10px)';
      setTimeout(function() {
        self.el.classList.remove('sl-geo-visible');
        self.el.style.opacity = '';
        self.el.style.transform = '';
      }, 250);
    },

    onLocationFound: function(lat, lng) {
      if (this.dismissed) return;
      this.userLat = lat;
      this.userLng = lng;
      var self = this;

      /* Wait silently for store data, then show */
      var attempts = 0;
      function ready() {
        attempts++;
        if (DataSource.stores && DataSource.stores.length > 0) {
          self.reveal();
        } else if (attempts < 40) {
          setTimeout(ready, 250);
        }
      }
      ready();
    },

    reveal: function() {
      var city = this.nearestCity(this.userLat, this.userLng);
      var count = this.countNearby(this.userLat, this.userLng);
      var self = this;

      var msg, linkText, linkId = 'sl-geo-go-' + SID;
      if (count > 0) {
        msg = 'Há ' + count + ' pontos de vendas no bairro mais próximo de você. Dê uma olhada.';
        linkText = 'Ir';
      } else {
        msg = 'Não há pontos disponíveis em sua cidade atualmente. O mais próximo fica em ' + city + '.';
        linkText = 'Quer olhar?';
      }

      /* Setup: span for typewriter + hidden link */
      this.body.innerHTML = '<span id="sl-geo-txt-' + SID + '"></span> <a id="' + linkId + '" style="opacity:0;transition:opacity 0.3s">' + linkText + '</a>';
      this.el.classList.add('sl-geo-visible');

      /* Typewriter */
      var txtEl = $('sl-geo-txt-' + SID);
      var linkEl = $(linkId);
      var i = 0;
      var speed = 25;
      function type() {
        if (self.dismissed) return;
        if (i < msg.length) {
          txtEl.textContent += msg.charAt(i);
          i++;
          setTimeout(type, speed);
        } else {
          /* Done typing — show link */
          linkEl.style.opacity = '1';
          self.ping();
        }
      }
      type();

      var goLat = count > 0 ? self.userLat : self.nearestLat;
      var goLng = count > 0 ? self.userLng : self.nearestLng;

      linkEl.addEventListener('click', function() {
        self.dismissed = true;
        self.hide();
        setTimeout(function() {
          PanEngine.panTo(goLat, goLng, true);
          ZoomEngine.zoomTo(12, true);
          setTimeout(refreshStores, 600);
        }, 280);
      });

      /* Auto-dismiss after 15s */
      setTimeout(function() {
        if (!self.dismissed) { self.dismissed = true; self.hide(); }
      }, 15000);
    }
  };
  /* ═══ CHECKPOINT [M20] GeoBubble ✓ — UX: geo tooltip ═══ */

  /* ═══ INITIALIZATION ═══ */
  function initStoreLocator() {
    var sectionEl = $('sl-' + SID);
    MapState.mapEl = $('sl-map-' + SID);
    MapState.tileLayer = $('sl-tiles-' + SID);
    MapState.pinsLayer = $('sl-pins-' + SID);
    MapState.vpW = sectionEl.offsetWidth;
    MapState.vpH = sectionEl.offsetHeight;

    TileManager.init(MapState.tileLayer);
    PanEngine.init();
    ZoomEngine.init();
    TooltipManager.init();
    SidePanel.init();
    BottomSheet.init();
    GeoBubble.init();

    /* Initial render - Brazil */
    renderMap();

    /* Request geolocation — show assistant bubble instead of auto-pan */
    GeoLocator.requestPosition(function(success) {
      if (success) {
        GeoBubble.onLocationFound(GeoLocator.getUserLat(), GeoLocator.getUserLng());
      }
    });

    /* Load store data */
    DataSource.loadStores(function(stores) {
      if (stores.length > 0) {
        FilterComposer.applyFilters(stores, function(filtered) {
          renderPinsOnMap();
        });
      }
    });

    /* Resize handler */
    window.addEventListener('resize', function() {
      MapState.vpW = sectionEl.offsetWidth;
      MapState.vpH = sectionEl.offsetHeight;
      renderMap();
    });

    /* Re-render pins after drag ends */
    MapState.mapEl.addEventListener('mouseup', function() {
      setTimeout(renderPinsOnMap, 50);
    });
    MapState.mapEl.addEventListener('touchend', function() {
      setTimeout(renderPinsOnMap, 50);
    });
  }

  /* Boot */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStoreLocator);
  } else {
    initStoreLocator();
  }

})();
</script>

