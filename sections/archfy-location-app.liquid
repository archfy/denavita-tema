  /* ═══ MÓDULO: BottomSheet ═══
     ID: M09
     SPEC: 3.7 (Bottom sheet mobile)
     DEPENDE DE: LocationSearch (M10), ProductSearch (M11), FilterComposer (M14)
     RECEBE: touch events, user interactions
     EXPÕE: open(), close(), updateList(stores)
     ESTADO: isOpen, snapPoint, dragState
  ═══ */
  var BottomSheet = {
    isOpen: false,
    currentSnap: 0,
    snapPoints: [80, 50, 10], /* percentage from bottom: collapsed=80% hidden, mid=50%, expanded=10% */
    sheetEl: null,
    dragStartY: 0,
    dragStartTranslate: 0,
    isDragging: false,
    velocity: 0,
    lastY: 0,
    lastTime: 0,

    init: function() {
      var self = this;
      this.sheetEl = $('sl-bs-' + SID);
      var dragBar = $('sl-bs-drag-' + SID);

      dragBar.addEventListener('touchstart', function(e) { self.onDragStart(e); }, { passive: false });
      document.addEventListener('touchmove', function(e) { self.onDragMove(e); }, { passive: false });
      document.addEventListener('touchend', function(e) { self.onDragEnd(e); });

      /* Mouse fallback for testing */
      dragBar.addEventListener('mousedown', function(e) {
        self.onDragStart({ touches: [{ clientY: e.clientY }], preventDefault: function(){} });
        var onMove = function(me) { self.onDragMove({ touches: [{ clientY: me.clientY }], preventDefault: function(){} }); };
        var onUp = function() {
          self.onDragEnd({ changedTouches: [{ clientY: 0 }] });
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
        };
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });

      /* Location search */
      var locInput = $('sl-bs-loc-' + SID);
      var locAc = $('sl-bs-loc-ac-' + SID);
      locInput.addEventListener('input', function() {
        LocationSearch.search(locInput.value, locAc, function(item) {
          locInput.value = item.display;
          FilterComposer.searchCenter = { lat: item.lat, lng: item.lng };
          PanEngine.panTo(item.lat, item.lng, true);
          ZoomEngine.zoomTo(13, true);
          refreshStores();
        });
      });

      /* Product search */
      var prodInput = $('sl-bs-prod-' + SID);
      var prodAc = $('sl-bs-prod-ac-' + SID);
      prodInput.addEventListener('input', function() {
        ProductSearch.search(prodInput.value, prodAc, function(product) {
          StockFilter.selectedProduct = product.handle;
          prodInput.value = '';
          addChipMobile(product.title, product.handle);
          refreshStores();
        });
      });

      /* Open now toggle */
      var toggle = $('sl-bs-toggle-' + SID);
      toggle.addEventListener('click', function() {
        OpenNowFilter.enabled = !OpenNowFilter.enabled;
        toggle.classList.toggle('sl-toggle-on', OpenNowFilter.enabled);
        toggle.setAttribute('aria-checked', OpenNowFilter.enabled ? 'true' : 'false');
        /* Sync desktop toggle */
        var dToggle = $('sl-toggle-open-' + SID);
        dToggle.classList.toggle('sl-toggle-on', OpenNowFilter.enabled);
        dToggle.setAttribute('aria-checked', OpenNowFilter.enabled ? 'true' : 'false');
        refreshStores();
      });

      /* ESC key */
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && self.isOpen) { self.close(); }
      });
    },

    getTranslateForSnap: function(snapIdx) {
      var sectionEl = $('sl-' + SID);
      var h = sectionEl.offsetHeight;
      return h * (this.snapPoints[snapIdx] / 100);
    },

    open: function() {
      var mascot = $('sl-mascot-' + SID);
      this.sheetEl.classList.add('sl-bs-active');
      this.sheetEl.setAttribute('aria-hidden', 'false');
      mascot.setAttribute('aria-expanded', 'true');
      this.isOpen = true;
      this.snapTo(1); /* mid */
      refreshStores();
    },

    close: function() {
      var mascot = $('sl-mascot-' + SID);
      this.sheetEl.classList.remove('sl-bs-active');
      this.sheetEl.setAttribute('aria-hidden', 'true');
      mascot.setAttribute('aria-expanded', 'false');
      this.isOpen = false;
      this.sheetEl.style.transform = '';
    },

    snapTo: function(idx) {
      this.currentSnap = idx;
      var ty = this.getTranslateForSnap(idx);
      this.sheetEl.style.transition = 'transform 0.4s cubic-bezier(0.32, 0.72, 0, 1)';
      this.sheetEl.style.transform = 'translateY(' + ty + 'px)';
      setTimeout(function() {
        BottomSheet.sheetEl.style.transition = '';
      }, 400);
    },

    onDragStart: function(e) {
      if (!this.isOpen) return;
      this.isDragging = true;
      this.dragStartY = e.touches[0].clientY;
      var transform = getComputedStyle(this.sheetEl).transform;
      if (transform && transform !== 'none') {
        var matrix = transform.match(/matrix.*\((.+)\)/);
        if (matrix) {
          var values = matrix[1].split(',');
          this.dragStartTranslate = parseFloat(values[5]) || 0;
        } else {
          this.dragStartTranslate = 0;
        }
      } else {
        this.dragStartTranslate = this.getTranslateForSnap(this.currentSnap);
      }
      this.lastY = this.dragStartY;
      this.lastTime = Date.now();
      this.velocity = 0;
      this.sheetEl.style.transition = 'none';
    },

    onDragMove: function(e) {
      if (!this.isDragging) return;
      e.preventDefault();
      var y = e.touches[0].clientY;
      var dy = y - this.dragStartY;
      var newTranslate = Math.max(0, this.dragStartTranslate + dy);
      this.sheetEl.style.transform = 'translateY(' + newTranslate + 'px)';
      var now = Date.now();
      var dt = now - this.lastTime;
      if (dt > 0) { this.velocity = (y - this.lastY) / dt; }
      this.lastY = y;
      this.lastTime = now;
    },

    onDragEnd: function() {
      if (!this.isDragging) return;
      this.isDragging = false;
      /* Find nearest snap point */
      var sectionEl = $('sl-' + SID);
      var h = sectionEl.offsetHeight;
      var transform = getComputedStyle(this.sheetEl).transform;
      var currentY = 0;
      if (transform && transform !== 'none') {
        var matrix = transform.match(/matrix.*\((.+)\)/);
        if (matrix) {
          var values = matrix[1].split(',');
          currentY = parseFloat(values[5]) || 0;
        }
      }
      /* Consider velocity for snap direction */
      var projected = currentY + this.velocity * 150;
      var closest = 0;
      var minDist = Infinity;
      for (var i = 0; i < this.snapPoints.length; i++) {
        var snapY = h * (this.snapPoints[i] / 100);
        var dist = Math.abs(projected - snapY);
        if (dist < minDist) { minDist = dist; closest = i; }
      }
      this.snapTo(closest);
    },

    updateList: function(stores) {
      var list = $('sl-bs-list-' + SID);
      var sep = $('sl-bs-sep-' + SID);
      var top7 = stores.slice(0, 7);
      sep.textContent = top7.length + ' mais próximos';
      list.innerHTML = '';
      for (var i = 0; i < top7.length; i++) {
        list.appendChild(createStoreItem(top7[i]));
      }
    }
  };
  /* ═══ CHECKPOINT [M09] Bottom sheet mobile ✓ — Spec 3.7: drag, 3 snap points, spring ═══ */

