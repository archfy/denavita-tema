.mt-4{margin-top:1rem;}.mt-8{margin-top:2rem;}.mt-12{margin-top:3rem;}
.p-3{padding:0.75rem;}.p-4{padding:1rem;}.p-5{padding:1.25rem;}.p-6{padding:1.5rem;}.p-8{padding:2rem;}
.px-3{padding-left:0.75rem;padding-right:0.75rem;}.px-4{padding-left:1rem;padding-right:1rem;}.px-6{padding-left:1.5rem;padding-right:1.5rem;}.px-8{padding-left:2rem;padding-right:2rem;}
.py-2{padding-top:0.5rem;padding-bottom:0.5rem;}.py-3{padding-top:0.75rem;padding-bottom:0.75rem;}.py-4{padding-top:1rem;padding-bottom:1rem;}.py-5{padding-top:1.25rem;padding-bottom:1.25rem;}.py-6{padding-top:1.5rem;padding-bottom:1.5rem;}
.pt-4{padding-top:1rem;}.pb-0{padding-bottom:0;}
.space-y-2>*+*{margin-top:0.5rem;}.space-y-4>*+*{margin-top:1rem;}.space-y-6>*+*{margin-top:1.5rem;}.space-y-8>*+*{margin-top:2rem;}
