.sticky-footer{position:fixed;bottom:0;left:0;right:0;z-index:50;background:#fff;border-top:1px solid hsl(var(--border));box-shadow:0 -4px 20px rgba(0,0,0,0.1);transform:translateY(100%);opacity:0;transition:transform 0.3s,opacity 0.3s;will-change:transform,opacity;}
.sticky-footer.visible{transform:translateY(0);opacity:1;}
.dropdown-menu{position:absolute;bottom:100%;margin-bottom:0.5rem;background:#fff;border-radius:var(--radius);box-shadow:0 20px 25px -5px rgba(0,0,0,.1);border:1px solid hsl(var(--border));overflow:hidden;z-index:50;width:280px;opacity:0;transform:translateY(10px);pointer-events:none;transition:opacity 0.2s,transform 0.2s;}
.dropdown-menu.open{opacity:1;transform:translateY(0);pointer-events:auto;}
