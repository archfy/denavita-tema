function toggleAccordion(trigger) {
  var content = trigger.nextElementSibling;
  var isOpen = content.classList.contains('open');
  // Close all siblings
  var parent = trigger.closest('.space-y-4') || trigger.closest('[class*="space-y"]');
  if (parent) {
    parent.querySelectorAll('.accordion-content.open').forEach(function(c) { c.classList.remove('open'); });
    parent.querySelectorAll('.accordion-trigger.open').forEach(function(t) { t.classList.remove('open'); });
  }
  if (!isOpen) {
    content.classList.add('open');
    trigger.classList.add('open');
  }
}

function toggleBenefits() {
  showAllBenefits = !showAllBenefits;
  renderBenefitsMobile();
}

function scrollTimeline(dir) {
  var el = document.getElementById('timeline-scroll');
  el.scrollBy({ left: dir * 280, behavior: 'smooth' });
}
function scrollVideos(dir) {
  var el = document.getElementById('video-carousel');
  el.parentElement.style.overflow = 'auto';
  el.style.animation = 'none';
  el.parentElement.scrollBy({ left: dir * 250, behavior: 'smooth' });
}
function scrollWritten(dir) {
  var el = document.getElementById('written-carousel');
  el.parentElement.style.overflow = 'auto';
  el.style.animation = 'none';
  el.parentElement.scrollBy({ left: dir * 300, behavior: 'smooth' });
}

function openVideoModal(url) {
  var modal = document.getElementById('video-modal');
  var video = document.getElementById('modal-video');
  video.src = url;
  modal.classList.add('active');
  video.play();
}
function closeVideoModal(e) {
  if (e && e.target !== document.getElementById('video-modal') && !e.target.closest('button')) return;
  var modal = document.getElementById('video-modal');
  var video = document.getElementById('modal-video');
  video.pause();
  video.src = '';
  modal.classList.remove('active');
}

function toggleStickyDropdown() {
  stickyDropdownOpen = !stickyDropdownOpen;
  document.getElementById('sticky-dropdown').classList.toggle('open', stickyDropdownOpen);
  document.getElementById('sticky-chevron').style.transform = stickyDropdownOpen ? 'rotate(180deg)' : '';
}
function selectStickyVariant(idx) {
  selectedVariantIdx = idx;
  stickyDropdownOpen = false;
  document.getElementById('sticky-dropdown').classList.remove('open');
  document.getElementById('sticky-chevron').style.transform = '';
  updateStickyUI();
  renderStickyDropdown();
}

/* Scroll listener for sticky footer (throttled) */
var _stickyTicking = false;
function handleStickyScroll() {
  if (_stickyTicking) return;
  _stickyTicking = true;
  requestAnimationFrame(function() {
    var footer = document.querySelector('footer');
    var footerTop = footer ? footer.getBoundingClientRect().top : Infinity;
    var vis = window.scrollY > 500 && footerTop >= window.innerHeight;
    document.getElementById('sticky-footer').classList.toggle('visible', vis);
    _stickyTicking = false;
  });
}

/* Sparkle generation */
function generateSparkles() {
  var container = document.getElementById('sparkle-container');
  if (!container) return;
  for (var i = 0; i < 14; i++) {
    var angle = (i / 14) * Math.PI * 2;
    var rx = 45 + (i % 2) * 10;
    var ry = 42 + (i % 2) * 8;
    var left = 50 + Math.cos(angle) * rx;
    var top = 50 + Math.sin(angle) * ry;
    var size = Math.random() * 6 + 4;
    var delay = Math.random() * 4;
    var dur = Math.random() * 2 + 2;
    var dot = document.createElement('div');
    dot.className = 'sparkle-dot';
    dot.style.cssText = 'left:'+left+'%;top:'+top+'%;width:'+size+'px;height:'+size+'px;--dur:'+dur+'s;--delay:'+delay+'s;background:radial-gradient(circle,rgba(252,198,3,0.95) 0%,rgba(252,198,3,0.4) 50%,transparent 100%);box-shadow:0 0 '+size+'px rgba(252,198,3,0.5),0 0 '+(size*2)+'px rgba(252,198,3,0.15)';
    container.appendChild(dot);
  }
}

/* Responsive layout adjustments */
function handleResize() {
  var w = window.innerWidth;
  var md = w >= 768;
  var lg = w >= 1024;
  // Hero grid
  document.getElementById('hero-grid').style.gridTemplateColumns = lg ? '1fr 1fr' : '1fr';
  if (lg) {
    document.getElementById('hero-content').style.maxWidth = 'none';
    document.getElementById('hero-content').style.textAlign = 'left';
    document.getElementById('hero-content').style.margin = '0';
  } else {
    document.getElementById('hero-content').style.maxWidth = '350px';
    document.getElementById('hero-content').style.textAlign = 'center';
    document.getElementById('hero-content').style.margin = '0 auto';
  }
  // Why grid
  document.getElementById('why-grid').style.gridTemplateColumns = lg ? '1fr 1fr' : '1fr';
  document.getElementById('why-cards-desktop').style.display = md ? 'block' : 'none';
  document.getElementById('why-accordion').style.display = md ? 'none' : 'block';
  // Why image responsive
  var whyImg = document.getElementById('why-image');
  if (whyImg) {
    var img = whyImg.querySelector('img');
    if (img) img.style.maxHeight = lg ? '850px' : md ? '750px' : '600px';
  }
  // Benefits
  document.getElementById('benefits-mobile').style.display = md ? 'none' : 'block';
  document.getElementById('benefits-desktop').style.display = md ? 'grid' : 'none';
  if (md) document.getElementById('benefits-desktop').style.gridTemplateColumns = lg ? 'repeat(3,1fr)' : 'repeat(2,1fr)';
  // WhoIsItFor grid
  document.getElementById('whoisitfor-grid').style.gridTemplateColumns = lg ? '1fr 1fr' : '1fr';
  if (lg) document.getElementById('whoisitfor-header').style.textAlign = 'left';
  else document.getElementById('whoisitfor-header').style.textAlign = 'center';
  // Ingredients
  document.getElementById('ingredients-mobile').style.display = md ? 'none' : 'block';
  document.getElementById('ingredients-desktop').style.display = md ? 'grid' : 'none';
  if (md) document.getElementById('ingredients-desktop').style.gridTemplateColumns = 'repeat(3,1fr)';
  // Timeline
  document.getElementById('timeline-mobile').style.display = md ? 'none' : 'block';
  document.getElementById('timeline-desktop').style.display = md ? 'grid' : 'none';
  if (md) document.getElementById('timeline-desktop').style.gridTemplateColumns = lg ? 'repeat(3,1fr)' : 'repeat(3,1fr)';
  // Pricing grid
  document.getElementById('pricing-grid').style.gridTemplateColumns = md ? 'repeat(3,1fr)' : '1fr';
  // HowTo grid
  document.getElementById('howto-grid').style.gridTemplateColumns = md ? '1fr 1fr' : '1fr';
  // Footer
  document.getElementById('footer-mobile').style.display = md ? 'none' : 'block';
  document.getElementById('footer-desktop').style.display = md ? 'block' : 'none';
  // Hero section padding
  var heroContainer = document.querySelector('#inicio .container');
  if (md) {
    heroContainer.style.paddingTop = '7rem';
    heroContainer.style.paddingBottom = '10rem';
  } else {
    heroContainer.style.paddingTop = '100px';
    heroContainer.style.paddingBottom = '80px';
  }
  // Product image size
  var prodImg = document.querySelector('#hero-image-wrap img.animate-float');
  if (prodImg) {
    if (lg) prodImg.style.width = '30rem';
    else if (md) prodImg.style.width = '26.25rem';
    else prodImg.style.width = '20rem';
  }
  // Sticky buy label
  updateStickyUI();
}

/* Copyright */
function setCopyright() {
  var year = new Date().getFullYear();
  var m = document.getElementById('copyright-mobile');
  var d = document.getElementById('copyright-desktop');
  if (m) m.textContent = '© ' + year + ' Denavita. Todos os direitos reservados.';
  if (d) d.textContent = '© ' + year + ' Denavita. Todos os direitos reservados. • *Os resultados podem variar de pessoa para pessoa.';
}

/* ═══ MÓDULO: ValidationSystem ═══
   ID: M20
   ORIGEM: Axioma OP₇
   DEPENDE DE: todos os módulos
   RECEBE: nenhum
   EXPÕE: __VALIDATE_INTEGRITY__
   ESTADO: nenhum
═══ */
function __VALIDATE_INTEGRITY__() {
  var results = [];
  function assert(module, test, description) {
    try {
      var pass = test();
      results.push({ module: module, description: description, status: pass ? '✅' : '❌' });
    } catch(e) {
      results.push({ module: module, description: description, status: '💥 ERRO: ' + e.message });
    }
  }
  assert('M01', function(){ return document.querySelector('.animate-scroll-subhero') !== null; }, 'SubHero marquee exists');
  assert('M02', function(){ return document.getElementById('inicio') !== null && document.querySelector('.animate-float') !== null; }, 'Hero section with product image');
  assert('M02', function(){ return document.querySelectorAll('.sparkle-dot').length >= 10; }, 'Sparkle dots generated');
  assert('M03', function(){ return document.getElementById('why-cards-desktop') !== null; }, 'WhyItWorks cards exist');
  assert('M04', function(){ return document.getElementById('benefits-desktop').children.length === 6; }, 'All 6 benefits rendered desktop');
  assert('M05', function(){ return document.getElementById('targets-list').children.length === 6; }, 'All 6 target items rendered');
  assert('M06', function(){ return document.getElementById('ingredients-mobile').children.length === 3; }, 'All 3 ingredients rendered');
  assert('M07', function(){ return document.getElementById('timeline-scroll').children.length === 3; }, 'Timeline steps rendered');
  assert('M08', function(){ return document.getElementById('video-carousel').children.length >= 4; }, 'Video carousel populated');
  assert('M08', function(){ return document.getElementById('written-carousel').children.length >= 6; }, 'Written testimonials populated');
  assert('M09', function(){ return document.getElementById('pricing-grid').children.length === 3; }, '3 pricing kits rendered');
  assert('M10', function(){ return document.getElementById('howto-steps').children.length === 3; }, 'How-to steps exist');
  assert('M11', function(){ return document.getElementById('faq-list').children.length === 8; }, '8 FAQ items rendered');
  assert('M12', function(){ return document.querySelector('footer') !== null; }, 'Footer exists');
  assert('M13', function(){ return document.getElementById('sticky-footer') !== null; }, 'Sticky footer exists');
  assert('M13', function(){ return typeof selectStickyVariant === 'function'; }, 'Variant selector functional');
  assert('M14', function(){ return document.getElementById('whatsapp-btn') !== null; }, 'WhatsApp button exists');
  assert('M15', function(){ return typeof trackEvent === 'function' && typeof trackPurchaseClick === 'function'; }, 'GA4 tracking functions exist');
  assert('M17', function(){ return document.querySelectorAll('.anim-target').length > 0; }, 'Animation targets present');
  assert('M18', function(){ return getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() !== ''; }, 'CSS custom properties set');
  console.table(results);
  var failures = results.filter(function(r) { return r.status !== '✅'; });
  if (failures.length === 0) {
    console.log('%c✅ TODOS OS INVARIANTES PASSARAM', 'color:green;font-size:16px');
  } else {
    console.log('%c❌ ' + failures.length + ' FALHA(S) DETECTADA(S)', 'color:red;font-size:16px');
  }
  return results;
}
/* ═══ CHECKPOINT [M20] Validation System ✓ — __VALIDATE_INTEGRITY__() ═══ */

/* ═══ INIT ═══ */
document.addEventListener('DOMContentLoaded', function() {
  generateSparkles();
  renderBenefitsMobile();
  renderBenefitsDesktop();
  renderTargets();
  renderIngredients();
  renderTimeline();
  renderVideoCarousel();
  renderWrittenCarousel();
  renderPricing();
  renderFAQ();
  renderStickyDropdown();
  updateStickyUI();
  setCopyright();
  initAnimations();
  handleResize();
  var _resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(_resizeTimer);
    _resizeTimer = setTimeout(handleResize, 100);
  });
  window.addEventListener('scroll', handleStickyScroll, { passive: true });
  // Close dropdown on outside click
  document.addEventListener('click', function(e) {
    if (stickyDropdownOpen && !e.target.closest('#sticky-dropdown') && !e.target.closest('#sticky-variant-btn')) {
      stickyDropdownOpen = false;
      document.getElementById('sticky-dropdown').classList.remove('open');
      document.getElementById('sticky-chevron').style.transform = '';
    }
  });
});
