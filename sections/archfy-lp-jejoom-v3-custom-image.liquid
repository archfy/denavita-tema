.accordion-trigger svg.chevron{transition:transform 0.2s;}
.accordion-trigger.open svg.chevron{transform:rotate(180deg);}
/* Modal */
.modal-overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.3s;}
.modal-overlay.active{opacity:1;pointer-events:auto;}
.modal-content{position:relative;max-width:48rem;width:95%;background:#000;border-radius:var(--radius);overflow:hidden;}
