.backdrop-blur-sm{backdrop-filter:blur(4px);}.backdrop-blur-md{backdrop-filter:blur(12px);}.backdrop-blur{backdrop-filter:blur(8px);}
.transition-all{transition:all .3s;}.transition-transform{transition:transform .3s;}.transition-colors{transition:color .2s,background .2s;}
.object-cover{object-fit:cover;}.object-contain{object-fit:contain;}
.snap-x{scroll-snap-type:x mandatory;}.snap-center{scroll-snap-align:center;}
