:root {
  --primary: 82,99%,35%;
  --primary-dark: 82,99%,28%;
  --primary-light: 82,60%,90%;
  --primary-foreground: 0,0%,100%;
  --secondary: 0,85%,52%;
  --secondary-foreground: 0,0%,100%;
  --secondary-light: 0,90%,95%;
  --foreground: 220,20%,15%;
  --background: 0,0%,100%;
  --muted: 220,15%,96%;
  --muted-foreground: 220,10%,45%;
  --accent: 0,85%,52%;
  --accent-light: 0,90%,95%;
  --border: 220,15%,90%;
  --destructive-foreground: 0,0%,100%;
  --footer-bg: 100,98%,13%;
  --radius: 0.75rem;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{overflow-x:hidden;max-width:100vw;}
body{font-family:'Inter',sans-serif;color:hsl(var(--foreground));background:hsl(var(--background));-webkit-font-smoothing:antialiased;line-height:1.5;}
h1,h2,h3,h4,h5,h6{font-family:'Poppins',sans-serif;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;height:auto;display:block;}
button{cursor:pointer;border:none;background:none;font-family:inherit;}
.container{width:100%;max-width:1400px;margin:0 auto;padding:0 1rem;}
/* Colors */
.text-white{color:#fff;}.text-foreground{color:hsl(var(--foreground));}
.text-muted-fg{color:hsl(var(--muted-foreground));}
.text-primary{color:hsl(var(--primary));}
.text-secondary{color:hsl(var(--secondary));}
.bg-white{background:#fff;}.bg-primary{background:hsl(var(--primary));}
.bg-secondary{background:hsl(var(--secondary));}
.bg-muted{background:hsl(var(--muted));}
/* Gradients */
.bg-gradient-hero{background:linear-gradient(135deg,hsl(140,65%,33%) 0%,hsl(140,65%,22%) 100%);}
.bg-gradient-red{background:linear-gradient(135deg,hsl(0,85%,52%) 0%,hsl(350,80%,45%) 100%);}
.bg-gradient-subtle{background:linear-gradient(180deg,#fff 0%,hsl(var(--muted)) 100%);}
.bg-gradient-green-light{background:linear-gradient(180deg,hsl(82,40%,95%) 0%,hsl(82,40%,90%) 100%);}
.bg-footer{background:#1a3e01;}
.bg-red-50{background:hsl(var(--secondary-light));}
.bg-secondary-light{background:hsl(var(--secondary-light));}
.bg-primary-light{background:hsl(var(--primary-light));}
.bg-accent-light{background:hsl(var(--accent-light));}
/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:9999px;font-weight:700;transition:all .2s;position:relative;overflow:hidden;}
.btn-primary{background:hsl(var(--primary));color:#fff;padding:0.75rem 2rem;font-size:1.125rem;}
.btn-primary:hover{background:hsl(var(--primary-dark));}
.btn-outline{background:rgba(255,255,255,0.8);color:hsl(var(--foreground));border:1px solid hsl(var(--border));padding:0.5rem 1.5rem;font-size:0.875rem;}
.btn-outline:hover{background:#fff;}
.btn-icon{width:2.5rem;height:2.5rem;border-radius:9999px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;border:1px solid hsl(var(--border));}
.btn-shine::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.4),transparent);animation:shine 2.5s infinite;}
.btn-pulse{animation:pulse-glow 2s ease-in-out infinite;}
@keyframes shine{0%{left:-100%}50%,100%{left:100%}}
@keyframes pulse-glow{0%,100%{box-shadow:0 0 0 0 hsla(82,99%,35%,0.4)}50%{box-shadow:0 0 0 15px hsla(82,99%,35%,0)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.animate-float{animation:float 3s ease-in-out infinite;will-change:transform;}
/* Scroll animations */
@keyframes scroll-subhero{0%{transform:translateX(0)}100%{transform:translateX(-25%)}}
@keyframes scroll-horizontal{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.animate-scroll-subhero{animation:scroll-subhero 15s linear infinite;width:max-content;will-change:transform;}
.animate-scroll-videos{animation:scroll-horizontal 60s linear infinite;width:max-content;will-change:transform;}
.animate-scroll-videos:hover{animation-play-state:paused;}
.animate-scroll-left{animation:scroll-horizontal 60s linear infinite;width:max-content;will-change:transform;}
.animate-scroll-left:hover{animation-play-state:paused;}
/* Content-visibility for below-fold sections */
[data-anim-section]{content-visibility:auto;contain-intrinsic-size:auto 600px;}
/* Entrance animations */
.anim-target{opacity:0;transform:translateY(30px);transition:opacity 0.6s ease-out,transform 0.6s ease-out;}
.anim-target.anim-left{transform:translateX(-30px);}
.anim-target.anim-right{transform:translateX(30px);}
.anim-target.anim-scale{transform:scale(0.8);}
.anim-target.visible{opacity:1;transform:translateY(0) translateX(0) scale(1);}
/* Sparkle */
@keyframes sparkle{0%,100%{opacity:0;transform:scale(0.4)}25%{opacity:0.8;transform:scale(1)}50%{opacity:0.3;transform:scale(0.7)}75%{opacity:0.9;transform:scale(1.1)}}
.sparkle-dot{position:absolute;border-radius:50%;pointer-events:none;animation:sparkle var(--dur) ease-in-out infinite;animation-delay:var(--delay);}
/* Orange float */
@keyframes orange-float-1{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-8px) rotate(3deg)}}
@keyframes orange-float-2{0%,100%{transform:translateY(0) rotate(5deg)}50%{transform:translateY(6px) rotate(-5deg)}}
@keyframes orange-float-3{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(10px) rotate(-8deg)}}
@keyframes orange-float-4{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-6px) rotate(10deg)}}
.orange-float-1{animation:orange-float-1 4s ease-in-out infinite;}
.orange-float-2{animation:orange-float-2 3.8s ease-in-out infinite 0.5s;}
.orange-float-3{animation:orange-float-3 5s ease-in-out infinite 0.3s;}
.orange-float-4{animation:orange-float-4 4.5s ease-in-out infinite 0.8s;}
.orange-float-5{animation:orange-float-1 5.5s ease-in-out infinite 0.2s;}
.orange-float-bg-1{animation:orange-float-3 6s ease-in-out infinite 0.4s;}
.orange-float-bg-2{animation:orange-float-4 5s ease-in-out infinite 1s;}
