function updateStickyUI() {
  var kit = kits[selectedVariantIdx];
  var disc = Math.round((1 - kit.price / kit.originalPrice) * 100);
  document.getElementById('sticky-variant-name').textContent = kit.name;
  document.getElementById('sticky-original-price').textContent = fmt(kit.originalPrice);
  document.getElementById('sticky-discount').textContent = '-' + disc + '%';
  document.getElementById('sticky-price').textContent = fmt(kit.price);
  document.getElementById('sticky-buy-btn').href = kit.checkoutUrl;
  document.getElementById('sticky-buy-btn').onclick = function() { trackPurchaseClick(kit.name, kit.price, kit.checkoutUrl); };
  var ship = document.getElementById('sticky-shipping');
  ship.style.display = kit.freeShipping ? 'flex' : 'none';
  // Mobile: show price in button
  var label = document.getElementById('sticky-buy-label');
  if (window.innerWidth < 640) {
    label.textContent = fmt(kit.price);
  } else {
    label.textContent = 'Comprar';
  }
}

