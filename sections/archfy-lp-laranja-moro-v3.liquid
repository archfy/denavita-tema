  .why-card h3{font-size:1.25rem}
  .why-celebrity{max-height:750px}
  .benefits-grid{display:none}
  .benefits-expand{display:none}
  .benefits-desktop{display:grid!important;grid-template-columns:repeat(2,1fr);gap:1.5rem}
  .benefit-card-desktop{background:rgba(255,255,255,.5);backdrop-filter:blur(12px);border-radius:1rem;padding:1.5rem;border:1px solid rgba(255,255,255,.5);transition:all .3s}
  .benefit-card-desktop:hover{background:rgba(255,255,255,.6);transform:translateY(-.5rem)}
  .benefit-icon-desktop{width:4rem;height:4rem;background:hsl(var(--secondary));border-radius:1rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;color:#fff}
  .benefit-card-desktop h3{font-size:1.25rem;font-weight:700;color:hsl(var(--foreground));margin-bottom:.5rem}
  .benefit-card-desktop p{color:hsl(var(--muted-fg))}
  .whoisit-grid{grid-template-columns:1fr 1fr}
  .whoisit-wave{height:136px}
  .science-section{padding:4rem 0 8rem}
  .science-mobile-list{display:none}
  .science-desktop-grid{display:grid!important;grid-template-columns:repeat(3,1fr);gap:1.5rem;max-width:56rem;margin:0 auto 4rem}
  .science-ingredient-desktop{background:rgba(255,255,255,.1);backdrop-filter:blur(12px);border-radius:1rem;padding:1.5rem;border:1px solid rgba(255,255,255,.2);text-align:center;transition:all .3s}
  .science-ingredient-desktop:hover{background:rgba(255,255,255,.2)}
  .science-ingredient-desktop .icon-wrap{width:5rem;height:5rem;background:#fff;border-radius:1rem;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;color:hsl(var(--secondary));transition:transform .3s}
  .science-ingredient-desktop:hover .icon-wrap{transform:scale(1.1)}
  .science-ingredient-desktop h3{font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:.5rem}
  .science-ingredient-desktop p{color:rgba(255,255,255,.7);font-size:.875rem}
  .science-study{padding:2.5rem;border-radius:1.5rem}
  .science-study h3{font-size:1.875rem}
  .science-stat .val{font-size:1.875rem}
  .science-stat .lbl{font-size:.75rem}
  .science-wave{height:136px}
  .timeline-mobile{display:none}
  .timeline-desktop{display:block!important}
  .video-item{width:14rem}
  .video-item video{height:24rem}
  .ba-mobile{display:none}
  .ba-desktop{display:block!important}
  .insta-mobile{display:none!important}
  .insta-desktop{display:block!important}
  .written-card{width:20rem}
  .pricing-grid{grid-template-columns:repeat(3,1fr)}
  .pricing-card.best-value{transform:scale(1.05);margin:-.5rem 0}
  .howtouse-grid{grid-template-columns:1fr 1fr}
  .howtouse-video{width:20rem;height:20rem}
  .footer-mobile{display:none!important}
  .footer-desktop{display:block!important}
  .footer-inner{padding:6rem 0 2rem}
  .sticky-product{display:block;flex-shrink:0}
  .sticky-selector{flex:none;width:180px}
  .sticky-price .main{font-size:1.125rem}
}
@media(min-width:1024px){
  .hero h1{font-size:3.75rem}
  .hero-product{width:480px}
  .section-title{font-size:3rem}
  .benefits-desktop{grid-template-columns:repeat(3,1fr)!important}
  .whoisit-section .container{padding-bottom:3rem}
}
</style>
