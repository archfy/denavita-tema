/* ═══ MÓDULO: InteractionHandlers ═══
   ID: M_INTERACT
   ORIGEM: React state + event handlers de todos os componentes
   DEPENDE DE: M_DATA, M_RENDER
   RECEBE: User events (click, scroll)
   EXPÕE: toggleWhyAccordion, toggleBenefits, toggleFaq, openVideoModal, closeVideoModal, toggleStickyDropdown, scrollCarousel, timelineScroll, showAllInstagram, trackPurchase
   ESTADO: benefitsExpanded, stickyDropdownOpen, selectedVariant
═══ */
var benefitsExpanded=false;
var stickyDropdownOpen=false;

function toggleWhyAccordion(btn){
  var content=btn.nextElementSibling;
  var chevron=btn.querySelector('.chevron');
  var isOpen=content.classList.contains('open');
  // Close all
  document.querySelectorAll('.why-accordion-content').forEach(function(c){c.classList.remove('open');});
  document.querySelectorAll('.why-accordion-header .chevron').forEach(function(c){c.style.transform='';});
  if(!isOpen){content.classList.add('open');chevron.style.transform='rotate(180deg)';}
}

function toggleBenefits(btn){
  benefitsExpanded=!benefitsExpanded;
  var hidden=document.querySelectorAll('.benefits-mobile-hidden');
  hidden.forEach(function(el){el.style.display=benefitsExpanded?'block':'none';});
  btn.innerHTML=benefitsExpanded?'Ver menos '+svgIcon('<polyline points="18 15 12 9 6 15"/>',16):'Ver mais benefícios '+svgIcon('<polyline points="6 9 12 15 18 9"/>',16);
}

function toggleFaq(btn){
  var answer=btn.nextElementSibling;
  var isOpen=answer.classList.contains('open');
  document.querySelectorAll('.faq-answer').forEach(function(a){a.classList.remove('open');});
  document.querySelectorAll('.faq-question').forEach(function(q){q.classList.remove('open');});
  if(!isOpen){answer.classList.add('open');btn.classList.add('open');}
}

function openVideoModal(url){
  var modal=document.getElementById('video-modal');
  var video=document.getElementById('modal-video');
  video.src=url;
  modal.classList.add('active');
  video.play();
}
function closeVideoModal(e){
  if(e&&e.target!==document.getElementById('video-modal')&&!e.target.closest('.video-modal-close'))return;
  var modal=document.getElementById('video-modal');
  var video=document.getElementById('modal-video');
  if(video){video.pause();video.removeAttribute('src');video.load();}
  modal.classList.remove('active');
}

function toggleStickyDropdown(){
  stickyDropdownOpen=!stickyDropdownOpen;
  document.getElementById('sticky-dropdown').classList.toggle('open',stickyDropdownOpen);
  document.getElementById('sticky-chevron').classList.toggle('open',stickyDropdownOpen);
}
function selectStickyVariant(id){
  selectedVariant=stickyVariants.find(function(v){return v.id===id;});
  stickyDropdownOpen=false;
  document.getElementById('sticky-dropdown').classList.remove('open');
  document.getElementById('sticky-chevron').classList.remove('open');
  updateStickyFooter();
}
function renderStickyDropdown(){
  var dd='';
  stickyVariants.forEach(function(v){
    var sel=selectedVariant.id===v.id;
    dd+='<button class="sticky-dropdown-item'+(sel?' selected':'')+'" onclick="selectStickyVariant('+v.id+')"><div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px"><div style="display:flex;align-items:center;gap:6px"><span class="name'+(sel?' selected-text':'')+'">'+v.name+'</span>'+(v.badge?'<span class="badge">'+v.badge+'</span>':'')+'</div><div style="display:flex;align-items:center;gap:6px"><span class="sub">'+v.sub+'</span>'+(v.ship?'<span style="font-size:9px;color:hsl(var(--secondary));font-weight:500">• Frete Grátis</span>':'')+'</div></div><div style="text-align:right"><p class="price'+(sel?' selected-text':'')+'">R$ '+fmt(v.price)+'</p><p class="orig">R$ '+fmt(v.orig)+'</p></div></button>';
  });
  document.getElementById('sticky-dropdown').innerHTML=dd;
}
function updateStickyFooter(){
  document.getElementById('sticky-selected-name').textContent=selectedVariant.name;
  var disc=Math.round((1-selectedVariant.price/selectedVariant.orig)*100);
  document.getElementById('sticky-orig').textContent='R$ '+fmt(selectedVariant.orig);
  document.getElementById('sticky-disc').textContent='-'+disc+'%';
  document.getElementById('sticky-main-price').textContent='R$ '+fmt(selectedVariant.price);
  document.getElementById('sticky-mobile-price').textContent='R$ '+fmt(selectedVariant.price);
  document.getElementById('sticky-buy-btn').href=selectedVariant.url;
  var shipEl=document.getElementById('sticky-shipping');
  if(shipEl)shipEl.style.display=selectedVariant.ship?'inline-flex':'none';
  document.getElementById('sticky-buy-btn').onclick=function(){trackPurchase(selectedVariant.id,selectedVariant.name,selectedVariant.price);};
  renderStickyDropdown();
}

function scrollCarousel(id,amount){
  var el=document.getElementById(id);
  if(el){
    el.style.animation='none';
    el.style.overflowX='auto';
    el.scrollBy({left:amount,behavior:'smooth'});
  }
}
function timelineScroll(amount){
  var el=document.getElementById('timeline-scroll');
  if(el){
    var sl=el.scrollLeft;var sw=el.scrollWidth;var cw=el.clientWidth;
    if(amount<0&&sl<=10){el.scrollTo({left:sw-cw,behavior:'smooth'});}
    else if(amount>0&&sl+cw>=sw-10){el.scrollTo({left:0,behavior:'smooth'});}
    else{el.scrollBy({left:amount,behavior:'smooth'});}
  }
}
function showAllInstagram(){
  var container=document.getElementById('insta-mobile');
  var html='';
  instagramTestimonials.forEach(function(t){
    html+='<div style="width:100%"><img src="'+t.image+'" alt="Depoimento do Instagram" style="border-radius:.5rem;width:100%;height:auto" loading="lazy"/></div>';
  });
  container.innerHTML=html;
}

/* ═══ MÓDULO: AnalyticsTracking ═══
   ID: M15
   ORIGEM: GA4 purchase events em PricingSection + StickyFooter
   DEPENDE DE: (nenhum — usa window.gtag global)
   RECEBE: kit id, name, price
   EXPÕE: trackPurchase()
   ESTADO: (nenhum)
═══ */
function trackPurchase(kitId,kitName,price){
  if(typeof gtag==='function'){
    gtag('event','purchase',{
      currency:'BRL',value:price,page_title:'LM - LP LOVABLE',
      items:[{item_id:'kit-'+kitId,item_name:kitName,price:price,quantity:1}]
    });
  }
}

/* ═══ MÓDULO: ScrollObserver ═══
   ID: M_SCROLL
   ORIGEM: framer-motion useInView + StickyFooter scroll listener
   DEPENDE DE: M_RENDER (DOM must exist)
   RECEBE: (nenhum)
   EXPÕE: initObservers()
   ESTADO: isVisible (sticky footer)
═══ */
function initObservers(){
  // IntersectionObserver for reveal animations
  var observer=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);}
    });
  },{rootMargin:'-100px'});
  document.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach(function(el){observer.observe(el);});

  // Lazy video loading - só carrega vídeo quando próximo do viewport
  var videoObserver=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        var v=entry.target;
        if(v.dataset.src&&!v.src){
          v.src=v.dataset.src;
          if(v.closest('.howtouse-video')){v.play().catch(function(){});}
        }
        videoObserver.unobserve(v);
      }
    });
  },{rootMargin:'200px'});
  document.querySelectorAll('.lazy-video').forEach(function(v){videoObserver.observe(v);});

  // Sticky footer scroll — throttled via rAF
  var stickyEl=document.getElementById('sticky-footer');
  var ticking=false;
  window.addEventListener('scroll',function(){
    if(!ticking){
      ticking=true;
      requestAnimationFrame(function(){
        var footer=document.querySelector('footer');
        var footerTop=footer?footer.getBoundingClientRect().top:Infinity;
        var isFooterVis=footerTop<window.innerHeight;
        var show=window.scrollY>500&&!isFooterVis;
        stickyEl.classList.toggle('visible',show);
        ticking=false;
      });
    }
  },{passive:true});

  // Desktop capsules visibility
  if(window.innerWidth>=768){
    document.querySelectorAll('.hero-capsule.desktop-only').forEach(function(el){el.style.display='block';});
    document.querySelectorAll('.hero-capsule.mobile-only').forEach(function(el){el.style.display='none';});
    document.querySelectorAll('.science-capsule:not(.mobile-only)').forEach(function(el){el.style.display='block';});
  }
  // Hero text alignment on desktop
  if(window.innerWidth>=1024){
    var heroText=document.getElementById('hero-text');
    if(heroText){heroText.style.textAlign='left';heroText.style.maxWidth='none';heroText.style.margin='0';}
  }
}

/* ═══ MÓDULO: Validation ═══
   ID: M_VALID (OP₇)
   ORIGEM: Axioma OP₇
   DEPENDE DE: Todos os módulos
   RECEBE: (nenhum)
   EXPÕE: __VALIDATE_INTEGRITY__()
   ESTADO: (nenhum)
═══ */
function __VALIDATE_INTEGRITY__(){
  var results=[];
  function assert(mod,test,desc){
    try{var pass=test();results.push({module:mod,description:desc,status:pass?'✅':'❌'});}
    catch(e){results.push({module:mod,description:desc,status:'💥 ERRO: '+e.message});}
  }
  assert('M01',function(){return document.querySelector('.subhero-track').children.length>0;},'SubHero track renderizado');
  assert('M02',function(){return document.querySelector('.hero-product')!==null;},'Hero product image existe');
  assert('M03',function(){return document.querySelectorAll('.why-card').length>=3;},'WhyItWorks 3 cards existem');
  assert('M04',function(){return document.querySelectorAll('.benefit-card').length>=3;},'Benefits mobile renderizado');
  assert('M05',function(){return document.querySelectorAll('.whoisit-item').length===6;},'WhoIsItFor 6 targets');
  assert('M06',function(){return document.querySelectorAll('.science-ingredient').length===3;},'Science 3 ingredientes mobile');
  assert('M07',function(){return document.querySelectorAll('.timeline-card').length===3;},'Timeline 3 steps mobile');
  assert('M08',function(){return document.querySelectorAll('.video-item').length>0;},'Video testimonials renderizados');
  assert('M08',function(){return document.querySelectorAll('.ba-card').length>0;},'Before/After renderizado');
  assert('M08',function(){return document.querySelectorAll('.written-card').length>0;},'Written testimonials renderizados');
  assert('M09',function(){return document.querySelectorAll('.pricing-card').length===3;},'3 pricing cards');
  assert('M10',function(){return document.querySelector('.howtouse-video video')!==null;},'HowToUse video existe');
  assert('M11',function(){return document.querySelectorAll('.faq-item').length===8;},'8 FAQ items');
  assert('M12',function(){return document.querySelector('.footer')!==null;},'Footer existe');
  assert('M13',function(){return document.getElementById('sticky-footer')!==null;},'StickyFooter existe');
  assert('M13',function(){return typeof selectStickyVariant==='function';},'selectStickyVariant é função');
  assert('M14',function(){return document.querySelector('.whatsapp-btn')!==null;},'WhatsApp button existe');
  assert('M15',function(){return typeof trackPurchase==='function';},'trackPurchase é função');
  assert('M16',function(){return getComputedStyle(document.documentElement).getPropertyValue('--primary').trim().length>0;},'CSS custom properties definidas');
  console.table(results);
  var failures=results.filter(function(r){return r.status!=='✅';});
  if(failures.length>0){console.warn('⚠️ '+failures.length+' módulo(s) com falha:');console.table(failures);}
  else{console.log('✅ Todos os módulos OK');}
  return {total:results.length,passed:results.length-failures.length,failed:failures.length};
}

/* ═══ MÓDULO: Bootstrap ═══ */
document.addEventListener('DOMContentLoaded',function(){
  renderAll();
  initObservers();
});
</script>
