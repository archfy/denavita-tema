document.getElementById("floatingCta").classList.toggle("visible", window.scrollY > 500);
});

// Responsive desktop carousel visibility
function updateResponsive() {
const isDesktop = window.innerWidth >= 1024;
document.querySelector(".desktop-carousel").style.display = isDesktop ? "block" : "none";
document.querySelector(".mobile-carousel").style.display = isDesktop ? "none" : "block";
}
updateResponsive();
window.addEventListener("resize", updateResponsive);

// Parallax for science banner
const scienceBanner = document.querySelector(".science-banner");
const scienceBg = document.getElementById("scienceBg");
if (scienceBanner && scienceBg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
window.addEventListener("scroll", () => {
const rect = scienceBanner.getBoundingClientRect();
const vh = window.innerHeight;
if (rect.bottom > 0 && rect.top < vh) {
const elementTop = scienceBanner.offsetTop;
const elementHeight = scienceBanner.offsetHeight;
const maxShift = elementHeight * 0.18;
const distance = window.scrollY - elementTop;
const translate = Math.max(-maxShift, Math.min(maxShift, distance * 0.22));
scienceBg.style.transform = "translate3d(0," + translate + "px,0)";
}
}, {passive: true});
}

// Auto-play how-to video
const howtoVideo = document.getElementById("howtoVideo");
if (howtoVideo) {
const observer = new IntersectionObserver((entries) => {
entries.forEach(entry => {
if (entry.isIntersecting) {
howtoVideo.play().catch(() => {});
}
});
}, {threshold: 0.3});
observer.observe(howtoVideo);
howtoVideo.play().catch(() => {});
}

updatePriceDisplay();
}

document.addEventListener("DOMContentLoaded", init);
