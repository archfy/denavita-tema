// State
let selectedTreatment = "3units";
let mobileCarouselIndex = 0;
let desktopCarouselIndex = 0;
let problemsIndex = 0;
let testimonialIndex = 0;
let modalSelectedVariant = "3units";

// Helper functions
function formatPrice(value) {
return "R$ " + value.toFixed(2).replace(".", ",");
}

function formatDeliveryDate(date) {
const months = ['jan.','fev.','mar.','abr.','mai.','jun.','jul.','ago.','set.','out.','nov.','dez.'];
return date.getDate() + " de " + months[date.getMonth()];
}

function getTreatment(id) {
return treatments.find(t => t.id === id) || treatments[1];
}

function getDiscount(t) {
return Math.round(((t.originalPrice - t.price) / t.originalPrice) * 100);
}

// Update price display
function updatePriceDisplay() {
const t = getTreatment(selectedTreatment);
const discount = getDiscount(t);
document.getElementById("priceOriginal").textContent = formatPrice(t.originalPrice);
document.getElementById("priceDiscount").textContent = "-" + discount + "%";
document.getElementById("priceCurrent").textContent = formatPrice(t.price);
document.getElementById("priceInstallments").textContent = "ou " + t.installments + " sem juros";
document.getElementById("cashbackValue").textContent = "Receba " + formatPrice(t.price * 0.15) + " em Cashback";

// Update treatment cards selection
document.querySelectorAll(".treatment-card").forEach(card => {
card.classList.toggle("selected", card.dataset.id === selectedTreatment);
});

// Update floating CTA
document.getElementById("floatingLabel").textContent = t.label;
document.getElementById("floatingPrice").textContent = formatPrice(t.price);
}

// Scroll to section
function scrollToSection() {
document.getElementById("comprar").scrollIntoView({behavior:"smooth"});
}

// Carousel functions
function updateCarousel(type) {
const index = type === "mobile" ? mobileCarouselIndex : desktopCarouselIndex;
const track = document.getElementById(type + "CarouselTrack");
const dots = document.getElementById(type + "Dots");
track.style.transform = "translateX(-" + (index * 100) + "%)";
dots.querySelectorAll(".carousel-dot").forEach((dot, i) => {
dot.classList.toggle("active", i === index);
});
}

function carouselPrev(type) {
if (type === "mobile") {
mobileCarouselIndex = (mobileCarouselIndex - 1 + 4) % 4;
} else {
desktopCarouselIndex = (desktopCarouselIndex - 1 + 4) % 4;
}
updateCarousel(type);
}

function carouselNext(type) {
if (type === "mobile") {
mobileCarouselIndex = (mobileCarouselIndex + 1) % 4;
} else {
desktopCarouselIndex = (desktopCarouselIndex + 1) % 4;
}
updateCarousel(type);
}

// Problems carousel
function problemsScroll(dir) {
problemsIndex = (problemsIndex + dir + 5) % 5;
const track = document.getElementById("problemsTrack");
track.scrollTo({left: problemsIndex * 152, behavior: "smooth"});
updateProblemsDots();
}

function updateProblemsDots() {
document.getElementById("problemsDots").querySelectorAll(".problems-dot").forEach((dot, i) => {
dot.classList.toggle("active", i === problemsIndex);
});
}

// Testimonials carousel
function updateTestimonialsCarousel() {
const inner = document.querySelector(".testimonials-carousel-inner");
if (inner) {
inner.style.transform = "translateX(-" + (testimonialIndex * 100) + "%)";
}
document.querySelectorAll(".testimonials-carousel-dot").forEach((dot, i) => {
dot.classList.toggle("active", i === testimonialIndex);
});
}

// Floating CTA
function toggleFloatingDropdown() {
const dropdown = document.getElementById("floatingDropdown");
const trigger = document.getElementById("floatingTrigger");
dropdown.classList.toggle("open");
trigger.classList.toggle("open");
}

// Video Modal
function openVideoModal(videoUrl) {
const modal = document.getElementById("videoModal");
const video = document.getElementById("modalVideo");
video.src = videoUrl;
video.play();
modal.classList.add("open");
document.getElementById("modalCtaArea").style.display = "flex";
document.getElementById("modalVariantsArea").style.display = "none";
}

function closeVideoModal() {
const modal = document.getElementById("videoModal");
const video = document.getElementById("modalVideo");
video.pause();
video.src = "";
modal.classList.remove("open");
}

function showModalVariants() {
document.getElementById("modalCtaArea").style.display = "none";
document.getElementById("modalVariantsArea").style.display = "block";
updateModalVariants();
}

function updateModalVariants() {
const t = getTreatment(modalSelectedVariant);
const discount = getDiscount(t);
document.getElementById("modalSummaryLabel").textContent = t.label;
document.getElementById("modalSummaryPrice").textContent = formatPrice(t.price);
document.getElementById("modalSummaryDiscount").textContent = "-" + discount + "%";
document.querySelectorAll(".modal-variant").forEach(card => {
card.classList.toggle("selected", card.dataset.id === modalSelectedVariant);
});
}

function confirmModalPurchase() {
const t = getTreatment(modalSelectedVariant);
window.open(t.checkoutUrl, "_blank");
}

// FAQ toggle
function toggleFaq(index) {
const items = document.querySelectorAll(".faq-item");
items.forEach((item, i) => {
if (i === index) {
item.classList.toggle("open");
} else {
item.classList.remove("open");
}
});
}

// Initialize
function init() {
// Delivery dates
const today = new Date();
const minDate = new Date(today);
minDate.setDate(today.getDate() + 3);
const maxDate = new Date(today);
maxDate.setDate(today.getDate() + 6);
document.getElementById("deliveryMin").textContent = formatDeliveryDate(minDate);
document.getElementById("deliveryMax").textContent = formatDeliveryDate(maxDate);

// Treatment cards
const treatmentsMobile = document.getElementById("treatmentsMobile");
const treatmentsDesktop = document.getElementById("treatmentsDesktop");
treatments.forEach(t => {
const html = `<button class="treatment-card${t.id === selectedTreatment ? ' selected' : ''}" data-id="${t.id}" onclick="selectedTreatment='${t.id}';updatePriceDisplay()">
${t.bestSeller ? '<span class="treatment-badge">MAIS VENDIDO</span>' : ''}
<div class="treatment-image"><img src="${t.image}" alt="${t.label}"></div>
<div class="treatment-label">${t.label}</div>
<div class="treatment-capsules">${t.capsules}</div>
<div class="treatment-duration">${t.duration}</div>
<div class="treatment-price">${formatPrice(t.price)}</div>
<div class="treatment-perpot">${formatPrice(t.price / t.bottles)}/pote</div>
</button>`;
treatmentsMobile.innerHTML += html;
treatmentsDesktop.innerHTML += html;
});

// Carousel dots
["mobile", "desktop"].forEach(type => {
const dots = document.getElementById(type + "Dots");
for (let i = 0; i < 4; i++) {
const dot = document.createElement("button");
dot.className = "carousel-dot" + (i === 0 ? " active" : "");
dot.onclick = () => {
if (type === "mobile") mobileCarouselIndex = i;
else desktopCarouselIndex = i;
updateCarousel(type);
};
dots.appendChild(dot);
}
});

// Auto-advance carousels
setInterval(() => {
mobileCarouselIndex = (mobileCarouselIndex + 1) % 4;
updateCarousel("mobile");
}, 4000);
setInterval(() => {
desktopCarouselIndex = (desktopCarouselIndex + 1) % 4;
updateCarousel("desktop");
}, 4000);

// Problems dots
const problemsDots = document.getElementById("problemsDots");
for (let i = 0; i < 5; i++) {
const dot = document.createElement("button");
dot.className = "problems-dot" + (i === 0 ? " active" : "");
dot.onclick = () => { problemsIndex = i; problemsScroll(0); };
problemsDots.appendChild(dot);
}
setInterval(() => { problemsScroll(1); }, 3000);

// Video thumbnails
const thumbsTrack = document.getElementById("videoThumbsTrack");
const allVideos = [...videoTestimonials, ...videoTestimonials, ...videoTestimonials];
allVideos.forEach((v, i) => {
const thumb = document.createElement("div");
thumb.className = "video-thumb";
thumb.innerHTML = `<div class="video-thumb-ring"><div class="video-thumb-inner"><video src="${v.videoUrl}" muted playsinline preload="metadata"></video></div></div><div class="video-thumb-play"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="6 3 20 12 6 21 6 3"/></svg></div>`;
thumb.onclick = () => openVideoModal(v.videoUrl);
thumbsTrack.appendChild(thumb);
});

// Benefits
const benefitsGrid = document.getElementById("benefitsGrid");
benefits.forEach((b, i) => {
