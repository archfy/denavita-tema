.hero .sparkle { position: absolute; z-index: 3; pointer-events: none; border-radius: 50%; }
.hero .orange-float { position: absolute; pointer-events: none; }
.hero .caneta-float { position: absolute; right: -30px; top: 5%; width: 160px; z-index: 8; pointer-events: none; filter: blur(3px); transform: rotate(-15deg); animation: bob5 5s ease-in-out infinite; }
