/* ═══ MÓDULO: DesignSystem ═══
   ID: M17
   ORIGEM: index.css + tailwind.config.ts
   DEPENDE DE: —
   RECEBE: —
   EXPÕE: CSS custom properties, utility classes
   ESTADO: —
═══ */
:root {
  --background: 0 0% 100%;
  --foreground: 220 20% 15%;
  --primary: 82 99% 35%;
  --primary-foreground: 0 0% 100%;
  --primary-dark: 82 99% 28%;
  --primary-light: 82 60% 90%;
  --secondary: 0 85% 52%;
  --secondary-foreground: 0 0% 100%;
  --secondary-light: 0 90% 95%;
  --accent: 0 85% 52%;
  --accent-light: 0 90% 95%;
  --muted: 220 15% 96%;
  --muted-foreground: 220 10% 45%;
  --destructive-foreground: 0 0% 100%;
  --border: 220 15% 90%;
  --radius: 0.75rem;
  --footer-bg: 100 98% 13%;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { overflow-x: hidden; max-width: 100vw; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  -webkit-font-smoothing: antialiased;
  line-height: 1.6;
}
h1,h2,h3,h4,h5,h6 { font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.2; }
a { text-decoration: none; color: inherit; }
ul, ol { padding: 0; margin: 0; list-style: none; }
img { max-width: 100%; height: auto; display: block; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
main { overflow: hidden; }

.container { width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 1.25rem; }
@media(min-width:768px) { .container { padding: 0 2rem; } }

/* Gradients */
.bg-gradient-hero { background: linear-gradient(135deg, hsl(140 65% 33%) 0%, hsl(140 65% 22%) 100%); }
.bg-gradient-red { background: linear-gradient(135deg, hsl(0 85% 52%) 0%, hsl(350 80% 45%) 100%); }
.bg-gradient-subtle { background: linear-gradient(180deg, #fff 0%, hsl(var(--muted)) 100%); }
.bg-gradient-green-light { background: linear-gradient(180deg, hsl(82 40% 95%) 0%, hsl(82 40% 90%) 100%); }

/* Button styles */
.btn-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  background: hsl(var(--primary)); color: #fff; font-weight: 700;
  border-radius: 9999px; transition: all 0.3s; position: relative; overflow: hidden;
}
.btn-primary:hover { background: hsl(var(--primary-dark)); }
.btn-primary.btn-lg { padding: 0.75rem 2rem; font-size: 1.125rem; }

.btn-shine::before {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shine 2.5s infinite;
}
@keyframes shine { 0%{left:-100%} 50%,100%{left:100%} }

.btn-pulse { animation: pulse-glow 2s ease-in-out infinite; }
@keyframes pulse-glow {
  0%,100%{box-shadow:0 0 0 0 hsl(82 99% 35%/0.4)}
  50%{box-shadow:0 0 0 15px hsl(82 99% 35%/0)}
}

/* Animations */
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
.animate-float { animation: float 3s ease-in-out infinite; will-change: transform; }

@keyframes scroll-subhero { 0%{transform:translateX(0)} 100%{transform:translateX(-25%)} }
.animate-scroll-subhero { animation: scroll-subhero 15s linear infinite; width: max-content; will-change: transform; contain: layout style; }

@keyframes scroll-left { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
.animate-scroll-left { animation: scroll-left 60s linear infinite; width: max-content; will-change: transform; contain: layout style; }
.animate-scroll-left:hover { animation-play-state: paused; }

@keyframes scroll-videos { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
.animate-scroll-videos { animation: scroll-videos 60s linear infinite; width: max-content; will-change: transform; contain: layout style; }
.animate-scroll-videos:hover { animation-play-state: paused; }

@keyframes sparkle-pulse {
  0%,100%{opacity:0;transform:scale(0.4)} 25%{opacity:0.8;transform:scale(1)} 50%{opacity:0.3;transform:scale(0.7)} 75%{opacity:0.9;transform:scale(1.1)}
}
@keyframes bob1 { 0%,100%{transform:translateY(0) rotate(-5deg)} 50%{transform:translateY(-8px) rotate(3deg)} }
@keyframes bob2 { 0%,100%{transform:translateY(0) rotate(5deg)} 50%{transform:translateY(6px) rotate(-5deg)} }
@keyframes bob3 { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-6px) rotate(10deg)} }
@keyframes bob4 { 0%,100%{transform:translateY(0) rotate(10deg)} 50%{transform:translateY(-5px) rotate(18deg)} }
@keyframes bob5 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }

/* InView animation */
.inview-hidden { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; will-change: opacity, transform; }
.inview-hidden.from-left { transform: translateX(-30px); }
.inview-hidden.from-right { transform: translateX(30px); }
.inview-visible { opacity: 1; transform: translateY(0) translateX(0); }

/* Scrollbar hide */
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
.scrollbar-hide::-webkit-scrollbar { display: none; }

/* ═══ CHECKPOINT [M17] DesignSystem ✓ — CSS tokens, gradients, animations, utilities ═══ */

/* ═══ MÓDULO: Responsive ═══
   ID: M18
   ORIGEM: tailwind.config.ts breakpoints
   DEPENDE DE: M17
   RECEBE: —
   EXPÕE: responsive utility classes via media queries
