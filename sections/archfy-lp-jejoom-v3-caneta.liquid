/* ═══ MÓDULO: StickyFooterLogic ═══
   ID: M13
   ORIGEM: StickyFooter.tsx
   DEPENDE DE: M15, M17
   RECEBE: scroll events
   EXPÕE: toggleVariantDropdown
   ESTADO: isVisible, isDropdownOpen, selectedVariant
═══ */
(function() {
  var variants = [
    { id:1, name:'1 Unidade', subtitle:'180g · 30 doses', price:127.90, originalPrice:139.90, badge:null, freeShipping:false, checkoutUrl:'https://seguro.denavita.com.br/r/NM00BESKUH' },
    { id:2, name:'2 Unidades', subtitle:'360g · 60 doses', price:239.80, originalPrice:279.80, badge:'Mais Vendido', freeShipping:true, checkoutUrl:'https://seguro.denavita.com.br/r/4IPLFGJWFT' },
    { id:3, name:'3 Unidades', subtitle:'540g · 90 doses', price:329.90, originalPrice:419.70, badge:'Maior Economia', freeShipping:true, checkoutUrl:'https://seguro.denavita.com.br/r/OYU0IRXXWM' }
  ];
  var selected = variants[1];
  var fmt = function(n) { return n.toFixed(2).replace('.', ','); };

  // Render dropdown options
  var ddHtml = '';
  variants.forEach(function(v) {
    var cls = v.id === selected.id ? 'variant-option active' : 'variant-option';
    var badge = v.badge ? '<span class="opt-badge">' + v.badge + '</span>' : '';
    var free = v.freeShipping ? '<span class="opt-free">• Frete Grátis</span>' : '';
    ddHtml += '<button class="' + cls + '" data-variant-id="' + v.id + '"><div class="opt-left"><div style="display:flex;align-items:center;gap:0.375rem"><span class="opt-name">' + v.name + '</span>' + badge + '</div><div style="display:flex;align-items:center;gap:0.375rem"><span class="opt-sub">' + v.subtitle + '</span>' + free + '</div></div><div class="opt-right"><p class="opt-price">R$ ' + fmt(v.price) + '</p><p class="opt-old">R$ ' + fmt(v.originalPrice) + '</p></div></button>';
  });
  document.getElementById('variantDropdown').innerHTML = ddHtml;

  // Click handlers for options
  document.getElementById('variantDropdown').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-variant-id]');
    if (!btn) return;
    var vid = parseInt(btn.getAttribute('data-variant-id'));
    selected = variants.find(function(v) { return v.id === vid; });
    updateStickyUI();
    document.getElementById('variantDropdown').classList.remove('open');
    document.getElementById('variantBtn').setAttribute('aria-expanded', 'false');
  });

  function updateStickyUI() {
    var discount = Math.round((1 - selected.price / selected.originalPrice) * 100);
    document.getElementById('variantBtnText').textContent = selected.name;
    document.getElementById('sticky-old-price').textContent = 'R$ ' + fmt(selected.originalPrice);
    document.getElementById('sticky-discount').textContent = '-' + discount + '%';
    document.getElementById('sticky-current-price').textContent = 'R$ ' + fmt(selected.price);
    document.getElementById('sticky-mobile-price').textContent = 'R$ ' + fmt(selected.price);
    document.getElementById('sticky-buy-link').href = selected.checkoutUrl;
    document.getElementById('sticky-buy-link').onclick = function() { trackPurchaseClick(selected.name, selected.price, 'sticky_footer'); };
    document.getElementById('sticky-shipping').style.display = selected.freeShipping ? 'inline' : 'none';
    // Update active state in dropdown
    document.querySelectorAll('#variantDropdown .variant-option').forEach(function(opt) {
      var vid = parseInt(opt.getAttribute('data-variant-id'));
      opt.classList.toggle('active', vid === selected.id);
      opt.querySelector('.opt-name').style.color = vid === selected.id ? 'hsl(82,99%,35%)' : '';
      opt.querySelector('.opt-price').style.color = vid === selected.id ? 'hsl(82,99%,35%)' : '';
    });
  }

  // Scroll visibility - throttled with rAF for performance
  var sticky = document.getElementById('stickyFooter');
  var scrollTicking = false;
  window.addEventListener('scroll', function() {
    if (!scrollTicking) {
      scrollTicking = true;
      requestAnimationFrame(function() {
        var footer = document.querySelector('footer');
        var footerTop = footer ? footer.getBoundingClientRect().top : Infinity;
        var isFooterVisible = footerTop < window.innerHeight;
        if (window.scrollY > 500 && !isFooterVisible) {
          sticky.classList.add('visible');
        } else {
          sticky.classList.remove('visible');
        }
        scrollTicking = false;
      });
    }
  }, { passive: true });
})();

function toggleVariantDropdown() {
  var dd = document.getElementById('variantDropdown');
  var btn = document.getElementById('variantBtn');
  var isOpen = dd.classList.contains('open');
  dd.classList.toggle('open');
  btn.setAttribute('aria-expanded', !isOpen);
}
// Close dropdown on outside click
document.addEventListener('click', function(e) {
  if (!e.target.closest('.variant-select')) {
    document.getElementById('variantDropdown').classList.remove('open');
    document.getElementById('variantBtn').setAttribute('aria-expanded', 'false');
  }
});

