/* ═══ MÓDULO: InViewAnimations ═══
   ID: M19
   ORIGEM: framer-motion useInView
   DEPENDE DE: M17
   RECEBE: DOM elements with data-inview
   EXPÕE: IntersectionObserver setup
   ESTADO: visibility state per element
═══ */
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('inview-visible');
        observer.unobserve(entry.target);
        // Remove will-change after transition to free GPU memory
        setTimeout(function() { entry.target.style.willChange = 'auto'; }, 700);
      }
    });
  }, { rootMargin: '-100px' });
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-inview]').forEach(function(el) {
      observer.observe(el);
    });
  });
})();
/* ═══ CHECKPOINT [M19] InViewAnimations ✓ — IntersectionObserver fade-in ═══ */

