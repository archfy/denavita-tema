  assert('M19', function(){ return document.querySelectorAll('[data-inview]').length > 0; }, 'InView elements exist');
  assert('M20', function(){ return typeof __VALIDATE_INTEGRITY__ === 'function'; }, '__VALIDATE_INTEGRITY__ exists');

  console.table(results);
