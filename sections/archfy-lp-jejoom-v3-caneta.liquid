/* Mobile accordion for why cards */
.accordion-trigger { width: 100%; display: flex; align-items: center; gap: 1rem; padding: 1rem; text-align: left; background: hsl(var(--secondary-light)); border-left: 4px solid hsl(var(--secondary)); border-radius: 0 0.75rem 0.75rem 0; margin-bottom: 0.5rem; }
