/* ═══ WhyItWorks M03 ═══ */
.why-section { padding: 5rem 0 0; background: #fff; position: relative; overflow: hidden; margin-top: -1px; }
.why-section .section-header { text-align: center; margin-bottom: 4rem; }
.section-badge { display: inline-block; font-weight: 600; font-size: 0.875rem; padding: 0.5rem 1rem; border-radius: 9999px; margin-bottom: 1rem; }
