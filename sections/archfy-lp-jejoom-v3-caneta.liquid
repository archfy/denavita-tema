  .hero .product-img { width: 420px; }
  .hero .float-badge { left: -2rem; bottom: 8rem; }
  .hero .caneta-float { right: -50px; width: 208px; }
}
@media(min-width:1024px) {
  .hero .grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  .hero .text-col { text-align: left; max-width: none; margin: 0; }
  .hero .subtitle { margin-left: 0; margin-right: 0; }
