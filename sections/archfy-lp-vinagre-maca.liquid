    <div class="dn-container" style="position:relative;z-index:10;padding-bottom:3rem;">
      <div class="dn-whoisitfor-grid">
        <div style="display:flex;flex-direction:column;align-items:center;">
          {% if s.whoisitfor_image != blank %}
            <img src="{{ s.whoisitfor_image | image_url: width: 1400 }}" alt="{{ s.whoisitfor_heading }}" style="width:100%;max-width:700px;height:auto;object-fit:contain;" loading="lazy" decoding="async">
          {% endif %}
        </div>
        <div>
          <div class="dn-text-center" style="margin-bottom:2rem;">
            <span class="dn-section-tag" style="background:{{ s.whoisitfor_tag_bg_color }};color:{{ s.whoisitfor_tag_text_color }};">{{ s.whoisitfor_tag }}</span>
            <h2 class="dn-section-heading" style="color:{{ s.whoisitfor_heading_color }};">{{ s.whoisitfor_heading }}</h2>
          </div>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            {% for block in target_items %}
              <div class="dn-target-item" {{ block.shopify_attributes }}>
                <div class="dn-target-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
                </div>
                <div class="dn-target-check">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                </div>
                <p>{{ block.settings.text }}</p>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="dn-whoisitfor-cta">
        <p>{{ s.whoisitfor_motivational }}</p>
        <a href="{{ s.whoisitfor_cta_url }}" class="dn-btn-primary" style="animation:dn-pulse-glow-{{ sid }} 2s ease-in-out infinite;">
          {{ s.whoisitfor_cta_text }}
          <svg class="dn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
    <svg class="dn-whoisitfor-wave" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none">
      <path d="M0 70C300 120 450 0 800 70C1150 140 1300 40 1440 70V120H0Z" fill="{{ s.whoisitfor_wave_color }}"/>
    </svg>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M06] ScienceHeroSection ✓ — Ingredients, study, badges ═══ -->
  {% if s.show_science %}
  <div class="dn-science" data-animate style="background:{{ s.science_bg_color }};">
    <div class="dn-geo-circle" style="width:24rem;height:24rem;background:rgba(255,255,255,0.05);top:-12rem;left:-12rem;"></div>
    <svg class="dn-science-wave" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none">
      <path d="M0 70C300 120 450 0 800 70C1150 140 1300 40 1440 70V120H0Z" fill="white"/>
    </svg>

    <div class="dn-container" style="position:relative;z-index:10;padding:1rem 1rem 2rem;">
      <div class="dn-text-center" style="margin-bottom:2.5rem;">
        <div class="dn-hero-badge-pill" style="margin-bottom:1rem;background:{{ s.science_tag_bg_color }};">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{{ s.science_tag_text_color }}" stroke-width="2"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/></svg>
          <span style="font-weight:600;color:{{ s.science_tag_text_color }};">{{ s.science_tag }}</span>
        </div>
        <h2 class="dn-section-heading" style="color:{{ s.science_heading_color }};">{{ s.science_heading }}</h2>
        <p class="dn-section-sub" style="color:rgba(255,255,255,0.8);">{{ s.science_subheading }}</p>
      </div>

      <!-- Mobile Ingredients -->
      <div class="dn-mobile-only" style="margin-bottom:2.5rem;">
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {% for block in ingredients %}
            <div class="dn-ingredient-card" {{ block.shopify_attributes }}>
              <div class="dn-ingredient-icon">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 56 }}" alt="{{ block.settings.name }}" style="width:28px;height:28px;object-fit:contain;">
                {% else %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="{{ s.color_secondary }}" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                {% endif %}
              </div>
              <div>
                <h3>{{ block.settings.name }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Desktop Ingredients -->
      <div class="dn-desktop-only dn-ingredients-desktop" style="display:none;">
        {% for block in ingredients %}
          <div class="dn-ingredient-card" style="flex-direction:column;text-align:center;" {{ block.shopify_attributes }}>
            <div class="dn-ingredient-icon" style="width:5rem;height:5rem;border-radius:1rem;margin:0 auto 1rem;">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 80 }}" alt="{{ block.settings.name }}" style="width:40px;height:40px;object-fit:contain;">
              {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="{{ s.color_secondary }}" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
              {% endif %}
