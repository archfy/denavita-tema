      <div class="dn-pricing-grid">
        {% for block in pricing_kits %}
          {% assign card_class = 'dn-pricing-card' %}
          {% if block.settings.badge_type == 'popular' %}{% assign card_class = card_class | append: ' dn-pricing-card-popular' %}{% endif %}
          {% if block.settings.badge_type == 'best_value' %}{% assign card_class = card_class | append: ' dn-pricing-card-best' %}{% endif %}

          <div class="{{ card_class }}" {{ block.shopify_attributes }}>
            {% if block.settings.badge_type == 'popular' %}
              <div class="dn-pricing-badge dn-pricing-badge-popular">
                <svg width="14" height="14" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                MAIS VENDIDO
              </div>
            {% endif %}
            {% if block.settings.badge_type == 'best_value' %}
              <div class="dn-pricing-badge dn-pricing-badge-best">
                <svg width="14" height="14" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                MAIOR ECONOMIA
              </div>
            {% endif %}

            <div class="dn-pricing-img">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name }}" loading="lazy" decoding="async">
              {% endif %}
