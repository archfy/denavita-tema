          {% if s.footer_phone != blank %}
            <a href="{{ s.footer_phone_url }}" target="_blank" rel="noopener noreferrer" style="color:rgba(255,255,255,0.7);display:flex;align-items:center;gap:0.25rem;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="{{ s.color_secondary }}" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
