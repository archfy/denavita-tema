  <!-- ═══ CHECKPOINT [M13] StickyFooter ✓ — Fixed bottom bar with variant selector ═══ -->
  {% if s.sticky_show and pricing_kits.size > 0 %}
  <div class="dn-sticky-footer" id="dn-sticky-{{ sid }}">
    <div class="dn-sticky-inner">
      <div class="dn-sticky-product-name">
        <p>Vinagre de Maçã</p>
        <span>Gomas Denavita</span>
      </div>
      <div class="dn-sticky-selector">
        <button class="dn-sticky-select-btn" id="dn-sticky-select-btn-{{ sid }}" onclick="dnToggleStickyDropdown_{{ sid | replace: '-', '_' }}()">
          <span id="dn-sticky-selected-name-{{ sid }}">{{ pricing_kits[1].settings.name | default: pricing_kits.first.settings.name }}</span>
          <svg class="dn-sticky-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="dn-sticky-dropdown" id="dn-sticky-dropdown-{{ sid }}">
          {% for block in pricing_kits %}
            <button class="dn-sticky-dropdown-item {% if forloop.index == 2 %}dn-selected{% endif %}"
              data-name="{{ block.settings.name }}"
              data-price="{{ block.settings.price }}"
              data-original="{{ block.settings.original_price }}"
              data-discount="{{ block.settings.discount }}"
              data-url="{{ block.settings.checkout_url }}"
              data-capsules="{{ block.settings.capsules }}"
              data-free="{{ block.settings.free_shipping }}"
              {% if block.settings.badge_type == 'popular' %}data-badge="Mais Vendido"{% endif %}
              {% if block.settings.badge_type == 'best_value' %}data-badge="Maior Economia"{% endif %}
              onclick="dnSelectStickyVariant_{{ sid | replace: '-', '_' }}(this)">
              <div>
                <div style="display:flex;align-items:center;gap:0.375rem;">
                  <span class="dn-sdi-name">{{ block.settings.name }}</span>
                  {% if block.settings.badge_type != 'none' %}
                    <span class="dn-sdi-badge">{% if block.settings.badge_type == 'popular' %}Mais Vendido{% else %}Maior Economia{% endif %}</span>
                  {% endif %}
                </div>
                <div style="display:flex;align-items:center;gap:0.375rem;">
                  <span class="dn-sdi-sub">{{ block.settings.capsules }}</span>
                  {% if block.settings.free_shipping %}<span class="dn-sdi-sub" style="color:var(--s-secondary);font-weight:500;">• Frete Grátis</span>{% endif %}
                </div>
              </div>
              <div style="text-align:right;">
                <span class="dn-sdi-price">R$ {{ block.settings.price }}</span><br>
                <span class="dn-sdi-orig">R$ {{ block.settings.original_price }}</span>
              </div>
            </button>
          {% endfor %}
        </div>
      </div>
      <div class="dn-sticky-price-desktop">
        <div style="display:flex;align-items:center;gap:0.375rem;justify-content:flex-end;">
          <span class="dn-sticky-price-orig" id="dn-sticky-orig-{{ sid }}">R$ {{ pricing_kits[1].settings.original_price | default: pricing_kits.first.settings.original_price }}</span>
          <span class="dn-sticky-price-discount" id="dn-sticky-disc-{{ sid }}">-{{ pricing_kits[1].settings.discount | default: pricing_kits.first.settings.discount }}%</span>
        </div>
        <span class="dn-sticky-price-val" id="dn-sticky-price-{{ sid }}">R$ {{ pricing_kits[1].settings.price | default: pricing_kits.first.settings.price }}</span>
      </div>
      <a href="{{ pricing_kits[1].settings.checkout_url | default: pricing_kits.first.settings.checkout_url }}" target="_blank" rel="noopener noreferrer" class="dn-btn-sticky-buy" id="dn-sticky-buy-{{ sid }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        <span class="dn-desktop-only" style="display:none;">Comprar</span>
        <span class="dn-mobile-only" id="dn-sticky-mobile-price-{{ sid }}">R$ {{ pricing_kits[1].settings.price | default: pricing_kits.first.settings.price }}</span>
      </a>
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M14] WhatsAppButton ✓ — Floating fixed button ═══ -->
  {% if s.whatsapp_show and s.whatsapp_button_url != blank %}
  <a href="{{ s.whatsapp_button_url }}" target="_blank" rel="noopener noreferrer" class="dn-whatsapp-btn" aria-label="Fale conosco pelo WhatsApp">
    <svg viewBox="0 0 32 32" fill="currentColor" width="28" height="28"><path d="M16.004 0h-.008C7.174 0 0 7.176 0 16c0 3.5 1.128 6.744 3.046 9.378L1.054 31.29l6.122-1.958C9.722 30.89 12.76 32 16.004 32 24.826 32 32 24.822 32 16S24.826 0 16.004 0zm9.528 22.614c-.396 1.116-1.954 2.042-3.21 2.312-.86.182-1.982.328-5.762-1.238-4.836-2.004-7.95-6.912-8.19-7.23-.232-.318-1.942-2.586-1.942-4.932 0-2.346 1.23-3.498 1.666-3.976.396-.434 1.04-.624 1.66-.624.2 0 .38.01.542.018.478.02.716.05 1.032.798.394.934 1.356 3.28 1.474 3.52.12.24.24.554.074.872-.158.318-.278.516-.556.796-.278.28-.586.626-.834.838-.278.24-.566.5-.244.98.322.478 1.432 2.362 3.074 3.828 2.114 1.886 3.894 2.47 4.446 2.744.396.198.868.158 1.204-.198.424-.452.948-1.2 1.48-1.938.38-.524.858-.59 1.294-.432.44.15 2.784 1.312 3.262 1.55.478.24.796.358.914.554.116.198.116 1.134-.28 2.252z"/></svg>
  </a>
  {% endif %}

</div>

<script>
/* ═══ MÓDULO: Core ═══
   ID: M00
   ORIGEM: Configuração global, scoping, utilitários
   DEPENDE DE: —
   RECEBE: section.id
   EXPÕE: CONFIG, utility functions
   ESTADO: —
   SCHEMA BINDINGS: Todos os settings consumidos via Liquid no HTML/CSS
═══ */
(function() {
  var SID = '{{ sid }}';
  var SID_SAFE = SID.replace(/-/g, '_');
  var ROOT = document.getElementById('dn-landing-' + SID);
  if (!ROOT) return;

  /* ═══ MÓDULO: BenefitsToggle ═══
     ID: M04-JS
     ORIGEM: BenefitsGridSection useState showAll
     DEPENDE DE: M00
     RECEBE: click event
     EXPÕE: dnToggleBenefits_{sid}
     ESTADO: benefitsExpanded (boolean)
     SCHEMA BINDINGS: benefits_initial_mobile
  ═══ */
  var benefitsExpanded = false;
  window['dnToggleBenefits_' + SID_SAFE] = function() {
    benefitsExpanded = !benefitsExpanded;
    var container = document.getElementById('dn-benefits-mobile-' + SID);
    var btn = document.getElementById('dn-benefits-toggle-' + SID);
    if (!container || !btn) return;
    var hidden = container.querySelectorAll('.dn-benefit-hidden');
    hidden.forEach(function(el) {
      el.style.display = benefitsExpanded ? '' : 'none';
    });
    btn.innerHTML = benefitsExpanded
      ? 'Ver menos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6"/></svg>'
      : 'Ver mais benefícios <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>';
  };
  // Init hidden benefits
  var benefitContainer = document.getElementById('dn-benefits-mobile-' + SID);
  if (benefitContainer) {
    benefitContainer.querySelectorAll('.dn-benefit-hidden').forEach(function(el) { el.style.display = 'none'; });
  }

  /* ═══ MÓDULO: WrittenTestimonialsToggle ═══
     ID: M08-JS-Written
     ORIGEM: TestimonialsSection useState showAllComments
     DEPENDE DE: M00
     RECEBE: click event
     EXPÕE: dnToggleWritten_{sid}
     ESTADO: writtenExpanded (boolean)
     SCHEMA BINDINGS: —
  ═══ */
  var writtenExpanded = false;
  window['dnToggleWritten_' + SID_SAFE] = function() {
    writtenExpanded = !writtenExpanded;
    var container = document.getElementById('dn-written-mobile-' + SID);
    var btn = document.getElementById('dn-written-toggle-' + SID);
    if (!container || !btn) return;
    container.querySelectorAll('.dn-written-hidden').forEach(function(el) {
      el.style.display = writtenExpanded ? '' : 'none';
    });
    btn.textContent = writtenExpanded ? 'Ver menos' : 'Ver mais comentários';
  };
  var writtenContainer = document.getElementById('dn-written-mobile-' + SID);
  if (writtenContainer) {
    writtenContainer.querySelectorAll('.dn-written-hidden').forEach(function(el) { el.style.display = 'none'; });
  }

  /* ═══ MÓDULO: CarouselScroll ═══
     ID: M07-JS, M08-JS-Desktop
     ORIGEM: TimelineSection scrollLeft/scrollRight, TestimonialsSection scrollCommentsLeft/Right
     DEPENDE DE: M00
     RECEBE: trackId, scrollAmount
     EXPÕE: dnCarouselScroll_{sid}
     ESTADO: —
     SCHEMA BINDINGS: —
  ═══ */
  window['dnCarouselScroll_' + SID_SAFE] = function(trackId, amount) {
    var track = document.getElementById('dn-' + trackId + '-track-' + SID) ||
                document.getElementById('dn-' + trackId + '-desktop-' + SID);
    if (!track) return;
    track.scrollBy({ left: amount, behavior: 'smooth' });
  };

  /* ═══ MÓDULO: VideoModal ═══
     ID: M08-JS-Modal
     ORIGEM: TestimonialsSection selectedVideo state, Dialog
     DEPENDE DE: M00
     RECEBE: videoUrl
     EXPÕE: dnOpenVideoModal_{sid}, dnCloseVideoModal_{sid}
     ESTADO: modal open/closed
     SCHEMA BINDINGS: —
  ═══ */
  window['dnOpenVideoModal_' + SID_SAFE] = function(url) {
    var modal = document.getElementById('dn-video-modal-' + SID);
    var video = document.getElementById('dn-modal-video-' + SID);
    if (!modal || !video) return;
    video.src = url;
    modal.classList.add('dn-modal-open');
    video.play();
  };
  window['dnCloseVideoModal_' + SID_SAFE] = function() {
    var modal = document.getElementById('dn-video-modal-' + SID);
    var video = document.getElementById('dn-modal-video-' + SID);
    if (!modal || !video) return;
    modal.classList.remove('dn-modal-open');
    video.pause();
    video.src = '';
  };
  // Close modal on backdrop click
  var modal = document.getElementById('dn-video-modal-' + SID);
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        window['dnCloseVideoModal_' + SID_SAFE]();
      }
    });
  }

  /* ═══ MÓDULO: StickyFooter ═══
     ID: M13-JS
     ORIGEM: StickyFooter component - scroll visibility, variant selection, dropdown
     DEPENDE DE: M00
     RECEBE: scroll events, click events
     EXPÕE: dnToggleStickyDropdown_{sid}, dnSelectStickyVariant_{sid}
     ESTADO: isVisible, isDropdownOpen, selectedVariant
     SCHEMA BINDINGS: sticky_show, pricing_kit blocks
  ═══ */
  var stickyEl = document.getElementById('dn-sticky-' + SID);
  if (stickyEl) {
    window.addEventListener('scroll', function() {
      var footer = ROOT.querySelector('.dn-footer');
      var footerTop = footer ? footer.getBoundingClientRect().top : Infinity;
      var isFooterVisible = footerTop < window.innerHeight;
      var show = window.scrollY > 500 && !isFooterVisible;
      stickyEl.classList.toggle('dn-visible', show);
    });
  }

  window['dnToggleStickyDropdown_' + SID_SAFE] = function() {
    var dropdown = document.getElementById('dn-sticky-dropdown-' + SID);
    var btn = document.getElementById('dn-sticky-select-btn-' + SID);
    if (!dropdown || !btn) return;
    var isOpen = dropdown.classList.toggle('dn-open');
    btn.classList.toggle('dn-open', isOpen);
  };

  window['dnSelectStickyVariant_' + SID_SAFE] = function(el) {
    var name = el.getAttribute('data-name');
    var price = el.getAttribute('data-price');
    var original = el.getAttribute('data-original');
    var discount = el.getAttribute('data-discount');
    var url = el.getAttribute('data-url');

    // Update selected name
    var nameEl = document.getElementById('dn-sticky-selected-name-' + SID);
    if (nameEl) nameEl.textContent = name;

    // Update prices
    var origEl = document.getElementById('dn-sticky-orig-' + SID);
    if (origEl) origEl.textContent = 'R$ ' + original;
    var discEl = document.getElementById('dn-sticky-disc-' + SID);
    if (discEl) discEl.textContent = '-' + discount + '%';
    var priceEl = document.getElementById('dn-sticky-price-' + SID);
    if (priceEl) priceEl.textContent = 'R$ ' + price;
    var mobilePriceEl = document.getElementById('dn-sticky-mobile-price-' + SID);
    if (mobilePriceEl) mobilePriceEl.textContent = 'R$ ' + price;

    // Update buy URL
    var buyEl = document.getElementById('dn-sticky-buy-' + SID);
    if (buyEl) buyEl.href = url;

    // Update selected state
    var dropdown = document.getElementById('dn-sticky-dropdown-' + SID);
    if (dropdown) {
      dropdown.querySelectorAll('.dn-sticky-dropdown-item').forEach(function(item) {
        item.classList.remove('dn-selected');
      });
      el.classList.add('dn-selected');
    }

    // Close dropdown
    window['dnToggleStickyDropdown_' + SID_SAFE]();
  };

  /* ═══ MÓDULO: Validation ═══
     ID: M00-VALIDATE
     ORIGEM: OP₇ Invariantes Executáveis
     DEPENDE DE: Todos
     RECEBE: —
     EXPÕE: __VALIDATE_INTEGRITY__
     ESTADO: —
     SCHEMA BINDINGS: —
  ═══ */
  window.__VALIDATE_INTEGRITY__ = function() {
    var results = [];
    function assert(mod, test, desc) {
      try {
        var pass = test();
        results.push({ module: mod, description: desc, status: pass ? '✅' : '❌' });
      } catch(e) {
        results.push({ module: mod, description: desc, status: '💥 ERRO: ' + e.message });
      }
    }

    assert('M01', function() { return !!ROOT.querySelector('.dn-subhero') || true; }, 'SubHero section present or toggled off');
    assert('M02', function() { return !!ROOT.querySelector('.dn-hero') || true; }, 'Hero section present or toggled off');
    assert('M03', function() { return !!ROOT.querySelector('.dn-why') || true; }, 'WhyItWorks section present or toggled off');
    assert('M04', function() { return !!ROOT.querySelector('.dn-benefits') || true; }, 'Benefits section present or toggled off');
    assert('M05', function() { return !!ROOT.querySelector('.dn-whoisitfor') || true; }, 'WhoIsItFor section present or toggled off');
    assert('M06', function() { return !!ROOT.querySelector('.dn-science') || true; }, 'Science section present or toggled off');
    assert('M07', function() { return !!ROOT.querySelector('.dn-timeline') || true; }, 'Timeline section present or toggled off');
    assert('M08', function() { return !!ROOT.querySelector('.dn-testimonials') || true; }, 'Testimonials section present or toggled off');
    assert('M09', function() { return !!ROOT.querySelector('.dn-pricing') || true; }, 'Pricing section present or toggled off');
    assert('M10', function() { return !!ROOT.querySelector('.dn-howto') || true; }, 'HowToUse section present or toggled off');
    assert('M11', function() { return !!ROOT.querySelector('.dn-faq') || true; }, 'FAQ section present or toggled off');
    assert('M12', function() { return !!ROOT.querySelector('.dn-footer') || true; }, 'Footer present or toggled off');
    assert('M13', function() { return !!document.getElementById('dn-sticky-' + SID) || true; }, 'StickyFooter present or toggled off');
    assert('M14', function() { return !!ROOT.querySelector('.dn-whatsapp-btn') || true; }, 'WhatsApp button present or toggled off');
    assert('CSS', function() {
      var el = document.getElementById('shopify-section-' + SID);
      if (!el) return true;
      var style = getComputedStyle(el);
      return style.getPropertyValue('--s-primary') !== '';
    }, 'CSS custom properties injected from schema');
    assert('FAQ-JS', function() {
      var faqQ = ROOT.querySelector('.dn-faq-question');
      if (!faqQ) return true;
      faqQ.click();
      var isOpen = faqQ.classList.contains('dn-open');
      faqQ.click();
      return isOpen;
    }, 'FAQ accordion toggle works');
