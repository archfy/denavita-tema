        {% for block in science_badges %}
          <div class="dn-science-badge" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 32 }}" alt="{{ block.settings.text }}" style="width:16px;height:16px;object-fit:contain;">
            {% else %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
            {% endif %}
            <span>{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M07] TimelineSection ✓ — 3 steps with mobile carousel ═══ -->
  {% if s.show_timeline %}
  <div class="dn-timeline" id="transformacao" data-animate style="background:{{ s.timeline_bg_color }};">
    <div class="dn-timeline-dot-bg"></div>
    <div class="dn-container" style="position:relative;z-index:10;">
