  <!-- ═══ CHECKPOINT [M09] PricingSection ✓ — 3 pricing cards ═══ -->
  {% if s.show_pricing %}
  <div class="dn-pricing" id="ofertas" data-animate style="background:{{ s.pricing_bg_color }};">
    <div class="dn-container" style="position:relative;z-index:10;">
      <div class="dn-text-center" style="margin-bottom:4rem;">
        <span class="dn-section-tag" style="background:{{ s.pricing_tag_bg_color }};color:{{ s.pricing_tag_text_color }};">{{ s.pricing_tag }}</span>
        <h2 class="dn-section-heading" style="color:{{ s.pricing_heading_color }};">{{ s.pricing_heading }}</h2>
        <p class="dn-section-sub">{{ s.pricing_subheading }}</p>
