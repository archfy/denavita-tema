          <span style="display:flex;align-items:center;gap:0.25rem;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="{{ s.color_secondary }}" stroke-width="2"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
