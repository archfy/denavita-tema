                <p class="dn-testimonial-text">{{ block.settings.text }}</p>
                <div class="dn-testimonial-footer">
                  {% if block.settings.avatar != blank %}
                    <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name }}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;">
                  {% endif %}
                  <div>
