            <span>{{ block.settings.text }}</span>
            <span class="dn-dot">•</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M02] HeroSection ✓ — Hero with product, glow, gummies, badges, CTA ═══ -->
