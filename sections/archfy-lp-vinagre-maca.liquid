    <div class="dn-geo-circle dn-gc1"></div>
    <div class="dn-geo-circle dn-gc2"></div>
    <div class="dn-geo-circle dn-gc3"></div>
    <div class="dn-geo-circle dn-gc4"></div>

    <svg class="dn-hero-wave" viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none">
      <path d="M0 70C300 120 450 0 800 70C1150 140 1300 40 1440 70V120H0Z" fill="{{ s.hero_wave_color }}"/>
    </svg>

    <div class="dn-container dn-hero-content">
      <div class="dn-hero-grid">
        <div class="dn-hero-text">
          <div class="dn-hero-badge-pill">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <span>{{ s.hero_badge_text }}</span>
          </div>

          <h1>{{ s.hero_heading | replace: s.hero_heading_highlight, '<em>' | append: '</em>' | replace: '<em>', '<em>' }}</h1>

          <p class="dn-hero-desc">{{ s.hero_subheading }}</p>

          <a href="{{ s.hero_cta_url }}" class="dn-btn-primary">
            {{ s.hero_cta_text }}
            <svg class="dn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="dn-hero-product-wrap">
          <div class="dn-hero-product-inner">
            <div class="dn-glow-outer"></div>
            <div class="dn-glow-mid"></div>
            <div class="dn-glow-inner"></div>
            <div class="dn-glow-top"></div>

            {% if s.hero_product_image != blank %}
              <img src="{{ s.hero_product_image | image_url: width: 760 }}" alt="{{ s.hero_heading | strip_html }}" class="dn-hero-product-img" loading="eager" decoding="async">

              <img src="{{ s.hero_product_image | image_url: width: 560 }}" alt="" class="dn-hero-bg-bottle dn-desktop-only">
            {% endif %}

            {% if s.hero_show_gummies %}
              {% assign gummy_images = s.hero_product_image %}
              <!-- Desktop Gummies (placeholder positions - use actual gummy images via blocks or metafields) -->
              {% if s.hero_gummy_image != blank %}
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d1"><img src="{{ s.hero_gummy_image | image_url: width: 80 }}" alt="" style="width:4rem;height:4rem;object-fit:contain;animation:dn-gummy-bob1-{{ sid }} 3.5s ease-in-out infinite 0.2s;"></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d2"><img src="{{ s.hero_gummy_image | image_url: width: 70 }}" alt="" style="width:3.5rem;height:3.5rem;object-fit:contain;animation:dn-gummy-bob2-{{ sid }} 4s ease-in-out infinite 0.7s;"></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d3"><img src="{{ s.hero_gummy_image | image_url: width: 70 }}" alt="" style="width:3.5rem;height:3.5rem;object-fit:contain;animation:dn-gummy-bob3-{{ sid }} 3.8s ease-in-out infinite 1.1s;"></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d4"><img src="{{ s.hero_gummy_image | image_url: width: 60 }}" alt="" style="width:3rem;height:3rem;object-fit:contain;animation:dn-gummy-bob4-{{ sid }} 4.2s ease-in-out infinite 0.5s;"></div>
                <div class="dn-gummy dn-gummy-mobile dn-gummy-m1"><img src="{{ s.hero_gummy_image | image_url: width: 50 }}" alt="" style="width:2.5rem;height:2.5rem;object-fit:contain;animation:dn-gummy-bob1-{{ sid }} 3s ease-in-out infinite 0.2s;"></div>
                <div class="dn-gummy dn-gummy-mobile dn-gummy-m2"><img src="{{ s.hero_gummy_image | image_url: width: 45 }}" alt="" style="width:2.25rem;height:2.25rem;object-fit:contain;animation:dn-gummy-bob4-{{ sid }} 3.4s ease-in-out infinite 0.6s;"></div>
              {% else %}
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d1"><div style="width:4rem;height:4rem;background:rgba(255,100,50,0.6);border-radius:50%;animation:dn-gummy-bob1-{{ sid }} 3.5s ease-in-out infinite 0.2s;"></div></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d2"><div style="width:3.5rem;height:3.5rem;background:rgba(255,120,60,0.6);border-radius:50%;animation:dn-gummy-bob2-{{ sid }} 4s ease-in-out infinite 0.7s;"></div></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d3"><div style="width:3.5rem;height:3.5rem;background:rgba(255,80,40,0.5);border-radius:50%;animation:dn-gummy-bob3-{{ sid }} 3.8s ease-in-out infinite 1.1s;"></div></div>
                <div class="dn-gummy dn-gummy-desktop dn-gummy-d4"><div style="width:3rem;height:3rem;background:rgba(255,100,50,0.5);border-radius:50%;animation:dn-gummy-bob4-{{ sid }} 4.2s ease-in-out infinite 0.5s;"></div></div>
                <div class="dn-gummy dn-gummy-mobile dn-gummy-m1"><div style="width:2.5rem;height:2.5rem;background:rgba(255,100,50,0.6);border-radius:50%;animation:dn-gummy-bob1-{{ sid }} 3s ease-in-out infinite 0.2s;"></div></div>
                <div class="dn-gummy dn-gummy-mobile dn-gummy-m2"><div style="width:2.25rem;height:2.25rem;background:rgba(255,120,60,0.5);border-radius:50%;animation:dn-gummy-bob4-{{ sid }} 3.4s ease-in-out infinite 0.6s;"></div></div>
              {% endif %}
            {% endif %}

            <div class="dn-hero-float-badge dn-badge-right">
              <span class="dn-badge-val">{{ s.hero_badge_left_value }}</span>
              <span class="dn-badge-label">{{ s.hero_badge_left_label }}</span>
            </div>
            <div class="dn-hero-float-badge dn-badge-left">
              <span class="dn-badge-val">{{ s.hero_badge_right_value }}</span>
              <span class="dn-badge-label">{{ s.hero_badge_right_label }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M03] WhyItWorksSection ✓ — Cards with accordion mobile ═══ -->
  {% if s.show_why %}
  <div class="dn-why" data-animate style="background:{{ s.why_bg_color }};">
    <div class="dn-container">
      <div class="dn-text-center" style="margin-bottom:4rem;">
        <span class="dn-section-tag" style="background:{{ s.why_tag_bg_color }};color:{{ s.why_tag_text_color }};">{{ s.why_section_tag }}</span>
        <h2 class="dn-section-heading" style="color:{{ s.why_heading_color }};">{{ s.why_heading }}</h2>
        <p class="dn-section-sub">{{ s.why_subheading }}</p>
      </div>

      <div class="dn-why-grid">
        <div>
          <!-- Mobile: Accordion -->
          <div class="dn-mobile-only">
            {% for block in why_cards %}
              <div class="dn-why-card" style="margin-bottom:1rem;" {{ block.shopify_attributes }}>
                <button class="dn-why-accordion-trigger" data-accordion-trigger="{{ sid }}" onclick="this.classList.toggle('dn-open');this.nextElementSibling.classList.toggle('dn-open')">
                  <div class="dn-why-icon">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 40 }}" alt="{{ block.settings.title }}" style="width:20px;height:20px;object-fit:contain;">
                    {% else %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    {% endif %}
                  </div>
                  <h3 style="flex:1;">{{ block.settings.title }}</h3>
                  <svg class="dn-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="dn-why-accordion-content">
                  <p style="padding:0 1rem 1rem 3.5rem;">{{ block.settings.description }}</p>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Desktop: Cards -->
          <div class="dn-desktop-only" style="display:none;">
            {% for block in why_cards %}
              <div class="dn-why-card" style="margin-bottom:1.5rem;" {{ block.shopify_attributes }}>
                <div class="dn-why-card-inner">
                  <div class="dn-why-icon">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 48 }}" alt="{{ block.settings.title }}" style="width:24px;height:24px;object-fit:contain;">
                    {% else %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    {% endif %}
                  </div>
                  <div>
                    <h3>{{ block.settings.title }}</h3>
                    <p>{{ block.settings.description }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div style="display:flex;flex-direction:column;align-items:center;">
          {% if s.why_celebrity_image != blank %}
            <img src="{{ s.why_celebrity_image | image_url: width: 800 }}" alt="{{ s.why_heading | strip_html }}" class="dn-why-celeb-img" loading="lazy" decoding="async">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M04] BenefitsGridSection ✓ — Benefits with expand mobile ═══ -->
  {% if s.show_benefits %}
  <div class="dn-benefits" data-animate style="background:{{ s.benefits_bg_color }};">
    <div class="dn-container" style="position:relative;z-index:10;">
      <div class="dn-text-center" style="margin-bottom:4rem;">
        <span class="dn-section-tag" style="background:{{ s.benefits_tag_bg_color }};color:{{ s.benefits_tag_text_color }};">{{ s.benefits_tag }}</span>
        <h2 class="dn-section-heading" style="color:{{ s.benefits_heading_color }};">{{ s.benefits_heading }}</h2>
        <p class="dn-section-sub">{{ s.benefits_subheading }}</p>
      </div>

      <!-- Mobile -->
      <div class="dn-mobile-only">
        <div class="dn-benefits-grid-mobile" id="dn-benefits-mobile-{{ sid }}">
          {% for block in benefit_cards %}
            <div class="dn-benefit-card {% if forloop.index > s.benefits_initial_mobile %}dn-benefit-hidden{% endif %}" {{ block.shopify_attributes }}>
              <div class="dn-benefit-card-inner">
                <div class="dn-benefit-icon">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 48 }}" alt="{{ block.settings.title }}" style="width:24px;height:24px;object-fit:contain;">
                  {% else %}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
                  {% endif %}
                </div>
                <div>
                  <h3>{{ block.settings.title }}</h3>
                  <p>{{ block.settings.description }}</p>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        {% if benefit_cards.size > s.benefits_initial_mobile %}
          <div class="dn-text-center" style="margin-top:1.5rem;">
            <button class="dn-btn-outline" id="dn-benefits-toggle-{{ sid }}" onclick="dnToggleBenefits_{{ sid | replace: '-', '_' }}()">
              Ver mais benefícios
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
        {% endif %}
      </div>

      <!-- Desktop -->
      <div class="dn-desktop-only dn-benefits-grid-desktop" style="display:none;">
        {% for block in benefit_cards %}
          <div class="dn-benefit-card" {{ block.shopify_attributes }}>
            <div style="width:4rem;height:4rem;background:var(--s-secondary);border-radius:1rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 64 }}" alt="{{ block.settings.title }}" style="width:32px;height:32px;object-fit:contain;">
              {% else %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
              {% endif %}
            </div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ═══ CHECKPOINT [M05] WhoIsItForSection ✓ — Checklist with image ═══ -->
  {% if s.show_whoisitfor %}
