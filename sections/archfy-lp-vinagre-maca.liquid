            <div class="dn-pricing-name">{{ block.settings.name }}</div>
            <div class="dn-pricing-capsules">{{ block.settings.capsules }} • {{ block.settings.duration }}</div>

            <div class="dn-pricing-prices">
              <div class="dn-pricing-original">
                <span class="dn-pricing-strikethrough">R$ {{ block.settings.original_price }}</span>
                <span class="dn-pricing-discount">-{{ block.settings.discount }}%</span>
              </div>
              <div class="dn-pricing-value">R$ {{ block.settings.price }}</div>
              <div class="dn-pricing-installment">ou 3x de R$ {{ block.settings.installment }} sem juros</div>
            </div>

            <div class="dn-pricing-perpot">
              <span class="dn-pricing-perpot-label">Preço por pote:</span>
              <span class="dn-pricing-perpot-val">R$ {{ block.settings.per_pot }}</span>
            </div>

            <div class="dn-pricing-benefits">
              {% if block.settings.free_shipping %}
                <div class="dn-pricing-benefit">
                  <svg class="dn-pricing-benefit-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>Frete Grátis</span>
                </div>
              {% endif %}
              <div class="dn-pricing-benefit">
                <svg class="dn-pricing-benefit-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                <span>100% Natural</span>
              </div>
              <div class="dn-pricing-benefit">
                <svg class="dn-pricing-benefit-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Satisfação Garantida</span>
              </div>
              <div class="dn-pricing-benefit">
                <svg class="dn-pricing-benefit-gift" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
                <span class="dn-pricing-benefit-gift">Cashback de R$ {{ block.settings.cashback }}</span>
              </div>
            </div>

            <a href="{{ block.settings.checkout_url }}" target="_blank" rel="noopener noreferrer" class="dn-btn-buy">Comprar Agora</a>

            <div class="dn-pricing-delivery">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
              <span>Entrega em 3-7 dias úteis</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
