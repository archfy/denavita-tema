        <svg class="icon-sm" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        Comprar
      </button>
    </div>
  </div>

  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1120227461949168&ev=PageView&noscript=1"/></noscript>

  <script>
    // Carousel functionality
    let currentSlide = 0;
    let mobileCurrentSlide = 0;
    const totalSlides = 3;

    function updateCarousel() {
      const slides = document.getElementById('carouselSlides');
      if (slides) {
        slides.style.transform = `translateX(-${currentSlide * 100}%)`;
      }
      updateDots();
    }

    function updateMobileCarousel() {
      const slides = document.getElementById('mobileCarouselSlides');
      if (slides) {
        slides.style.transform = `translateX(-${mobileCurrentSlide * 100}%)`;
      }
      updateMobileDots();
    }

    function updateDots() {
      const dotsContainer = document.getElementById('carouselDots');
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.className = 'carousel-dot' + (i === currentSlide ? ' active' : '');
        dot.onclick = () => { currentSlide = i; updateCarousel(); };
        dotsContainer.appendChild(dot);
      }
    }

    function updateMobileDots() {
      const dotsContainer = document.getElementById('mobileCarouselDots');
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.className = 'carousel-dot' + (i === mobileCurrentSlide ? ' active' : '');
        dot.onclick = () => { mobileCurrentSlide = i; updateMobileCarousel(); };
        dotsContainer.appendChild(dot);
      }
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }

    function prevMobileSlide() {
      mobileCurrentSlide = (mobileCurrentSlide - 1 + totalSlides) % totalSlides;
      updateMobileCarousel();
    }

    function nextMobileSlide() {
      mobileCurrentSlide = (mobileCurrentSlide + 1) % totalSlides;
      updateMobileCarousel();
    }

    // Auto-slide
    setInterval(() => {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }, 4000);

    setInterval(() => {
      mobileCurrentSlide = (mobileCurrentSlide + 1) % totalSlides;
      updateMobileCarousel();
    }, 4000);

    // Initialize
    updateCarousel();
    updateMobileCarousel();

    // Delivery dates
    function formatDeliveryDate(daysFromNow) {
      const date = new Date();
      date.setDate(date.getDate() + daysFromNow);
      const months = ['jan.', 'fev.', 'mar.', 'abr.', 'mai.', 'jun.', 'jul.', 'ago.', 'set.', 'out.', 'nov.', 'dez.'];
      return date.getDate() + ' de ' + months[date.getMonth()];
    }

    document.getElementById('deliveryStart').textContent = formatDeliveryDate(3);
    document.getElementById('deliveryEnd').textContent = formatDeliveryDate(8);

    // FAQ toggle
    function toggleFaq(button) {
      const item = button.parentElement;
      item.classList.toggle('open');
    }

    // Floating CTA
    let selectedUrl = 'https://seguro.denavita.com.br/r/QVDGZ03LJK';

    function toggleFloatingDropdown() {
      const dropdown = document.getElementById('floatingDropdown');
      const chevron = document.getElementById('floatingChevron');
      dropdown.classList.toggle('open');
      chevron.style.transform = dropdown.classList.contains('open') ? 'rotate(180deg)' : '';
    }

    function selectVariant(id, label, price, url) {
      document.getElementById('floatingLabel').textContent = label;
      document.getElementById('floatingPrice').textContent = price;
      selectedUrl = url;
      
      // Update selected state
      document.querySelectorAll('.floating-option').forEach(opt => opt.classList.remove('selected'));
      event.target.closest('.floating-option').classList.add('selected');
      
      toggleFloatingDropdown();
    }

    function buyNow() {
      window.open(selectedUrl, '_blank');
    }

    // Show floating CTA on scroll
    window.addEventListener('scroll', function() {
      const floatingCta = document.getElementById('floatingCta');
      if (window.scrollY > 500 && window.innerWidth < 768) {
        floatingCta.classList.add('visible');
      } else {
        floatingCta.classList.remove('visible');
      }
    });
  </script>
</body>
</html>
