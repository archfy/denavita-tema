<style>
  .price__discount-badge {
    background-color: #ff0000;
    color: #FFFFFF;
    padding: 5px 10px;
    border-radius: 13px;
    font-size: 1rem;
    font-weight: bold;
    line-height: 1;
    position: relative;
    margin-left: 5px;
    bottom: 5px;
  }
</style>

{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
  endif
  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
  assign discount_percentage = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round

  # Parcelamento (10x com juros)
  assign installments = 10
  assign interest_multiplier = 1.1718
  # Fórmula: X * 1.1718 / 10  (X em centavos)
  assign installment_price = price | times: interest_multiplier | divided_by: installments | round: 0

  assign money_installment = installment_price | money
  if settings.currency_code_enabled
    assign money_installment = installment_price | money_with_currency
  endif

  -%}

<div
  class="
    bls__price
    {%- if available == false %} price--sold-out {% endif -%}
    {%- if compare_at_price > price %} price--on-sale {% endif -%}
    {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
  "
  data-price-wrapper
>
  <div class="bls__product-price flex flex-wrap align-items-center mt-3">
    <div class="price__regular">
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="price{%- if compare_at_price > price %} special-price {% endif -%}" data-product-price>
      {{ money_price }}
      </span>
      
    </div>
    
    {%- if compare_at_price > price %}
      {%- unless product.price_varies == false and product.compare_at_price_varies %}
        <div class="price__sale grey-color" data-sale-price-wrapper>
            <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
            <span>
              <s class="price-item compare-price" data-compare-price>
                {% if settings.currency_code_enabled %}
                  {{ compare_at_price | money_with_currency }}
                {% else %}
                  {{ compare_at_price | money }}
                {% endif %}
              </s>
            </span>
            <span class="price__discount-badge" data-discount-badge>
              {{ discount_percentage }}% OFF
            </span>
        </div>
      {%- endunless -%}
    {%- endif -%}

   
        
    {% if product.selected_or_first_available_variant.unit_price_measurement != null %}
      <small class="unit-price caption">
        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
        <span class="price-item price-item--last">
          <span class="number">{{- product.selected_or_first_available_variant.unit_price | money -}}</span>
          <span aria-hidden="true">/</span>
          <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
          <span class="unit">
            {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
              {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
          </span>
        </span>
      </small>
    {% endif %}
  </div>
  {% if product.variants.size == 1 %}
  <div style="margin-top:5px;" class="price__installments" data-installments-wrapper="">
    <span class="text-gray-600 text-[12px] text-juros-pdp">
      <span class="desk-none">{{ installments }}x de</span><span class="mobile-none">ou {{ installments }}x de</span>
      <span class="value-parcela-pdp" style="display:inline-block">{{ money_installment }}</span>
      <span class="text-s-juros-pdp desk-none"></span>
    </span>
  </div>
{% endif %}
</div>

<script>
(function() {
  console.log('🔥 DISCOUNT BADGE SCRIPT CARREGADO (SEM MutationObserver)!');
  
  // Armazena dados do produto
  const productData = {{ product.variants | json }};
  
  // Função para formatar preço
  function formatMoney(cents) {
    const price = (cents / 100).toFixed(2);
    return 'R$ ' + price.replace('.', ',');
  }
  
  // Função principal de atualização
  function updateDiscountBadge(variantId) {
    console.log('🎯 Atualizando badge e preços para variant:', variantId);
    
    const discountBadge = document.querySelector('[data-discount-badge]');
    const saleWrapper = document.querySelector('[data-sale-price-wrapper]');
    const productPriceElement = document.querySelector('[data-product-price]');
    const comparePriceElement = document.querySelector('[data-compare-price]');
    
    if (!discountBadge) {
      console.warn('⚠️ Badge não encontrado!');
      return;
    }
    
    // Encontra a variante
    const variant = productData.find(v => v.id === parseInt(variantId));
    
    if (!variant) {
      console.warn('⚠️ Variante não encontrada:', variantId);
      return;
    }
    
    console.log('📊 Variante encontrada:', variant);
    console.log('💰 Preço:', variant.price, 'Compare:', variant.compare_at_price);
    
    const price = variant.price;
    const compareAtPrice = variant.compare_at_price;
    
    // Atualiza preço principal
    if (productPriceElement) {
      productPriceElement.textContent = formatMoney(price);
      console.log('✅ Preço atualizado:', formatMoney(price));
    }
    
    // Atualiza preço riscado
    if (comparePriceElement && compareAtPrice) {
      comparePriceElement.textContent = formatMoney(compareAtPrice);
      console.log('✅ Preço riscado atualizado:', formatMoney(compareAtPrice));
    }
    
    // Se não tem desconto, esconde
    if (!compareAtPrice || compareAtPrice <= price) {
      console.log('❌ Sem desconto - escondendo badge');
      if (saleWrapper) saleWrapper.style.display = 'none';
      return;
    }
    
    // Calcula desconto
    const discount = Math.round(((compareAtPrice - price) / compareAtPrice) * 100);
    console.log('✅ Desconto calculado:', discount + '%');
    
    // Atualiza badge
    discountBadge.textContent = discount + '% OFF';
    
    // Mostra wrapper
    if (saleWrapper) saleWrapper.style.display = '';
    
    console.log('✨ Badge e preços atualizados com sucesso!');
  }
  
  // ❌ REMOVIDO: MutationObserver (causava loop infinito)
  
  // Evento customizado do Shopify (PRINCIPAL)
  document.addEventListener('variant:change', function(e) {
    console.log('🔄 Evento variant:change disparado!');
    if (e.detail && e.detail.variant) {
      updateDiscountBadge(e.detail.variant.id);
    }
  });
  
  console.log('✅ Listener variant:change instalado!');
  console.log('📦 Variantes disponíveis:', productData.length);
  
})();
</script>
